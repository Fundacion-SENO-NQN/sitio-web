{
  "name": "fundacion-seno-frontend",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --config astro.config.mjs",
    "build": "astro build --config astro.config.mjs",
    "start": "node server.mjs",
    "preview": "astro preview --config astro.config.mjs",
    "astro": "astro",
    "generate-types": "wrangler types",
    "test": "vitest run",
    "dev:testing": "astro dev --config astro.testing.config.mjs",
    "build:testing": "astro build --config astro.testing.config.mjs",
    "preview:testing": "astro preview --config astro.testing.config.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.3.2",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "7.3.3",
    "dotenv": "^18.0.8",
    "sortablejs": "^1.15.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "jsdom": "^29.1.1",
    "vitest": "^5.0.4",
    "wrangler": "^4.151.3"
  }
}
