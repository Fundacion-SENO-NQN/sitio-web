{
  "name": "fundacion-seno-frontend",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --config astro.config.mjs",
    "dev:testing": "astro dev --config astro.testing.config.mjs",
    "build": "astro build --config astro.config.mjs",
    "build:testing": "astro build --config astro.testing.config.mjs",
    "start": "node server.mjs",
    "preview": "astro preview --config astro.config.mjs",
    "preview:testing": "astro preview --config astro.testing.config.mjs",
    "preview:worker": "wrangler dev --config wrangler.jsonc",
    "preview:worker:testing": "wrangler dev --config wrangler.testing.jsonc",
    "deploy:dry-run": "wrangler deploy --config wrangler.jsonc --dry-run",
    "deploy:testing:dry-run": "wrangler deploy --config wrangler.testing.jsonc --dry-run",
    "astro": "astro",
    "generate-types": "npm run types",
    "types": "wrangler types --config wrangler.jsonc worker/worker-configuration.d.ts",
    "types:testing": "wrangler types --config wrangler.testing.jsonc worker/worker-configuration.d.ts",
    "check:astro": "astro check",
    "check:worker": "npm run types && tsc --project worker/tsconfig.json",
    "check:worker:testing": "npm run types:testing && tsc --project worker/tsconfig.json",
    "check": "npm run check:astro && npm run check:worker",
    "test": "vitest run"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.4.13",
    "dotenv": "^18.0.5",
    "sortablejs": "^1.15.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@testing-library/jest-dom": "^7.0.1",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4",
    "wrangler": "^4.151.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
