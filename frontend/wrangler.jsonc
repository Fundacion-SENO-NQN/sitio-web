{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "name": "sitio-web",
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/*",
      "!/*.js",
      "!/*.mjs",
      "!/*.css",
      "!/*.map",
      "!/*.svg",
      "!/*.png",
      "!/*.jpg",
      "!/*.jpeg",
      "!/*.webp",
      "!/*.avif",
      "!/*.gif",
      "!/*.ico",
      "!/*.woff",
      "!/*.woff2",
      "!/*.ttf",
      "!/*.otf",
      "!/*.eot",
      "!/*.sfd",
      "!/*.pdf",
      "!/*.xml",
      "!/*.txt",
      "!/*.json",
      "!/*.webmanifest"
    ]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "8c4828c00cfa407f925ecb86402c58fc"
    }
  ]
}
