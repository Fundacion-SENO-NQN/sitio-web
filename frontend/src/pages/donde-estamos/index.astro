---
import Layout from '../../layouts/Layout.astro'

import TituloPag from '../../components/Common/TituloPag.astro'
import Ubicacion from '../../components/Common/Ubicacion.astro'

import SvgMensajeVacio from '../../assets/icon-common/icon-mensaje-vacio.svg'
import SvgReloj from '../../assets/icon-common/icon-reloj.svg'
import SvgUbicacion from '../../assets/icon-common/icon-ubicacion.svg'
import SvgFlecha from '../../../assets/icon-common/icon-flecha.svg'
---

<Layout pag="¿Dónde estamos?">
  <TituloPag titulo="¿Dónde estamos?" />

  <main class="ubicacion-pagina">
    <section class="ubicacion">
      <div class="ubicacion__informacion">
        <span class="ubicacion__etiqueta">Fundación SENO</span>

        <h1>Visítanos en Neuquén Capital</h1>

        <p class="ubicacion__introduccion">
          Podés encontrarnos en nuestra sede para realizar consultas, acercar
          donaciones o coordinar una visita.
        </p>

        <address class="datos">
          <div class="dato">
            <span class="dato__icono" aria-hidden="true">
              <SvgUbicacion />
            </span>

            <div>
              <span class="dato__titulo">Dirección</span>

              <p>
                San Carlos 1330<br />
                Neuquén Capital, Neuquén
              </p>
            </div>
          </div>

          <div class="dato">
            <span class="dato__icono" aria-hidden="true">
              <SvgReloj />
            </span>

            <div>
              <span class="dato__titulo">Horario de atención</span>
              <p>De 10:00 a 14:00 h</p>
            </div>
          </div>
        </address>

        <a
          class="ubicacion__enlace"
          href="https://www.google.com/maps/search/?api=1&query=Fundacion+SENO+Neuquen"
          target="_blank"
          rel="noopener noreferrer"
        >
          Abrir en Google Maps

          <SvgFlecha />
        </a>
      </div>

      <div class="ubicacion__mapa">
        <Ubicacion />
      </div>
    </section>

    <aside class="aviso">
      <span class="aviso__icono" aria-hidden="true">
        <SvgMensajeVacio />
      </span>

      <p>
        Para coordinar una visita o confirmar la atención, te recomendamos
        comunicarte previamente con la Fundación.
      </p>
    </aside>
  </main>
</Layout>

<style>
  .ubicacion-pagina {
    width: min(1180px, calc(100% - 2rem));
    margin: 2rem auto 5rem;
    font-family: var(--text-font-primary);
  }

  .ubicacion {
    display: grid;
    grid-template-columns: minmax(17rem, 0.75fr) minmax(0, 1.25fr);
    align-items: stretch;
    gap: clamp(1.5rem, 5vw, 4rem);
  }

  .ubicacion__informacion {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
    padding: clamp(1.5rem, 4vw, 3rem);
    border: 1px solid rgb(0 0 0 / 10%);
    border-radius: 1.5rem;
    background:
      radial-gradient(circle at 100% 0, rgb(65 120 170 / 14%), transparent 35%),
      var(--color-background);
    box-shadow: 0 1rem 2.5rem rgb(0 0 0 / 7%);
  }

  .ubicacion__etiqueta {
    display: block;
    margin-bottom: 0.7rem;
    color: var(--color-primary);
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .ubicacion h1 {
    margin: 0;
    color: var(--color-primary-hover);
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    line-height: 1.15;
    text-wrap: balance;
  }

  .ubicacion__introduccion {
    margin: 1rem 0 0;
    color: var(--color-text, #5f6c75);
    font-size: 1rem;
    line-height: 1.7;
  }

  .datos {
    display: grid;
    gap: 1rem;
    margin-top: 2rem;
    font-style: normal;
  }

  .dato {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 1rem;
    min-width: 0;
    padding: 1rem;
    border: 1px solid rgb(65 120 170 / 17%);
    border-radius: 1rem;
    background: rgb(65 120 170 / 6%);
  }

  .dato__icono {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 0.8rem;
    background: var(--color-primary-hover);
    color: var(--color-background);
  }

  .dato__icono svg {
    width: 1.6rem;
  }

  .dato__titulo {
    display: block;
    margin-bottom: 0.2rem;
    color: var(--color-primary-hover);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .dato p {
    margin: 0;
    color: var(--color-text, #3f4a53);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.55;
  }

  .ubicacion__enlace {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    width: fit-content;
    min-height: 3rem;
    margin-top: 1.5rem;
    padding: 0.75rem 1.15rem;
    border: 2px solid var(--color-primary-hover);
    border-radius: 999px;
    background: var(--color-primary-hover);
    color: var(--color-background);
    font-weight: 800;
    text-align: center;
    text-decoration: none;
    transition:
      background-color 180ms ease,
      color 180ms ease,
      transform 180ms ease;
  }

  .ubicacion__enlace svg {
    width: 1.2rem;
    transform: rotate(45deg);
  }

  .ubicacion__mapa {
    display: flex;
    align-items: stretch;
    min-width: 0;
  }

  /*
   * Permite que el componente Ubicacion ocupe
   * todo el espacio disponible.
   */
  .ubicacion__mapa :global(.mapa) {
    width: 100%;
    max-width: none;
    height: 100%;
    margin: 0;
  }

  .ubicacion__mapa :global(iframe) {
    min-height: 31rem;
    height: 100%;
  }

  .aviso {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 1.5rem;
    padding: 1rem 1.25rem;
    border-left: 4px solid var(--color-primary);
    border-radius: 0.25rem 1rem 1rem 0.25rem;
    background: rgb(65 120 170 / 8%);
  }

  .aviso__icono {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 2.7rem;
    height: 2.7rem;
    border-radius: 50%;
    background: var(--color-background);
    color: var(--color-primary);
  }

  .aviso__icono svg {
    width: 1.4rem;
    transform: scaleX(-1);
  }

  .aviso p {
    margin: 0;
    color: var(--color-primary-hover);
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.6;
  }

  @media (hover: hover) {
    .ubicacion__enlace:hover {
      background: transparent;
      color: var(--color-primary-hover);
      transform: translateY(-2px);
    }
  }

  @media (max-width: 850px) {
    .ubicacion {
      grid-template-columns: 1fr;
    }

    .ubicacion__informacion {
      text-align: center;
    }

    .dato {
      text-align: left;
    }

    .ubicacion__enlace {
      width: 100%;
    }

    .ubicacion__mapa :global(iframe) {
      min-height: 25rem;
    }
  }

  @media (max-width: 500px) {
    .ubicacion-pagina {
      width: min(100% - 1rem, 1180px);
      margin-top: 1rem;
    }

    .ubicacion__informacion {
      padding: 1.4rem;
      border-radius: 1.2rem;
    }

    .ubicacion h1 {
      font-size: clamp(1.7rem, 9vw, 2.3rem);
    }

    .dato {
      align-items: start;
      padding: 0.9rem;
    }

    .dato__icono {
      width: 2.7rem;
      height: 2.7rem;
    }

    .ubicacion__mapa :global(iframe) {
      min-height: 22rem;
    }

    .aviso {
      align-items: flex-start;
      padding: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ubicacion__enlace {
      transition: none;
    }
  }
</style>
