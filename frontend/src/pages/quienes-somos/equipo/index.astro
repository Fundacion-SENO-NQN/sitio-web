---
import Layout from '../../../layouts/Layout.astro'

import NavegacionQuienesSomos from '../../../components/QuienesSomos/NavegacionQuienesSomos.astro'
import EquipoItem from '../../../components/QuienesSomos/Equipo/ItemEquipo.astro'
import TituloPag from '../../../components/Common/TituloPag.astro'

import { getEquipo } from '../../../api/equipo'

const equipo = await getEquipo()
---

<Layout pag="Equipo">
  <NavegacionQuienesSomos pag="2" />

  <TituloPag titulo="Equipo" />

  <main class="main-equipo">
    <ul class="lista-equipo">
      {
        equipo.map((item, index) => (
          <EquipoItem
            integrante={item}
            priority={index === 0}
          />
        ))
      }
    </ul>
  </main>
</Layout>

<style>
  .main-equipo {
    box-sizing: border-box;

    width: min(calc(100% - 2rem), 1100px);
    margin-inline: auto;
    padding-bottom: clamp(3rem, 7vw, 6rem);
  }

  .lista-equipo {
    width: 100%;
    margin: 0;
    padding: 0;

    display: flex;
    flex-direction: column;
    gap: 1.5rem;

    list-style: none;
  }

  @media (max-width: 500px) {
    .main-equipo {
      width: calc(100% - 1.25rem);
      padding-bottom: 3rem;
    }

    .lista-equipo {
      gap: 1.25rem;
    }
  }
</style>