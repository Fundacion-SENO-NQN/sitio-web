---
import Layout from '../../layouts/Layout.astro'

import NavegacionQuienesSomos from '../../components/QuienesSomos/NavegacionQuienesSomos.astro'
import Descripcion from '../../components/QuienesSomos/Descripcion.astro'
import ListaDescripcion from '../../components/QuienesSomos/ListaDescripcion.astro'
import TituloPag from '../../components/Common/TituloPag.astro'
---

<Layout pag="¿Quiénes somos?">
  <NavegacionQuienesSomos pag="0" />

  <TituloPag titulo="¿Quiénes somos?" />

  <main class="main-quienes-somos">
    <section class="introduccion" aria-label="Presentación de Fundación SENO">
      <Descripcion />
    </section>

    <ListaDescripcion />
  </main>
</Layout>

<style>
  .main-quienes-somos {
    box-sizing: border-box;

    width: min(calc(100% - 2rem), 1200px);
    margin-inline: auto;
    padding-bottom: clamp(3rem, 7vw, 6rem);
  }

  .introduccion {
    width: 100%;
  }

  @media (max-width: 500px) {
    .main-quienes-somos {
      width: calc(100% - 1.25rem);
      padding-bottom: 3rem;
    }
  }
</style>
