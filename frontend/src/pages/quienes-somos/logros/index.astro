---
import Layout from '../../../layouts/Layout.astro'

import TituloPag from '../../../components/Common/TituloPag.astro'
import ItemLogro from '../../../components/QuienesSomos/Logros/ItemLogro.astro'
import NavegacionQuienesSomos from '../../../components/QuienesSomos/NavegacionQuienesSomos.astro'

import type Logro from '../../../data/interfaces/Logro'

import { getLogros } from '../../../api/logros'
import Breadcrumbs from '../../../components/Common/Breadcrumbs.astro'

let logros: Logro[] = []
let loadingError = false

try {
  const response = await getLogros()

  if (!Array.isArray(response)) {
    throw new TypeError('La respuesta de logros no es un arreglo')
  }

  logros = response
} catch (error) {
  loadingError = true
  Astro.response.status = 503
  Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow, noarchive')
  Astro.response.headers.set('Cache-Control', 'no-store')

  console.error('No se pudieron cargar los logros:', error)
}
---

<Layout
  pag="Logros"
  seoTitle="Logros de Fundación SENO Neuquén"
  description="Conocé los logros alcanzados por Fundación SENO gracias al trabajo de sus integrantes, voluntarios y toda la comunidad."
  noindex={loadingError}
>
  <Breadcrumbs
    items={[
      {
        name: 'Inicio',
        href: '/'
      },
      {
        name: 'Quienes somos',
        href: '/quienes-somos'
      },
      {
        name: 'Logros'
      }
    ]}
  />
  <NavegacionQuienesSomos pag="3" />

  <TituloPag titulo="Logros" />

  <main class="achievements-page">
    <header class="achievements-page__introduction">
      <h2>Un camino construido entre todos</h2>

      <p>
        Cada logro representa el esfuerzo de quienes colaboran, acompañan y
        confían en el trabajo de Fundación SENO.
      </p>
    </header>

    {
      loadingError ? (
        <section
          class="achievements-page__status achievements-page__status--error"
          role="alert"
        >
          <h2>No pudimos cargar los logros</h2>

          <p>
            La información no está disponible en este momento. Intentá
            nuevamente más tarde.
          </p>
        </section>
      ) : logros.length > 0 ? (
        <ul
          class="achievements-page__list"
          aria-label="Logros de Fundación SENO"
        >
          {logros.map((logro: Logro) => (
            <li>
              <ItemLogro logro={logro} />
            </li>
          ))}
        </ul>
      ) : (
        <section class="achievements-page__status" role="status">
          <h2>Todavía no hay logros publicados</h2>

          <p>
            Los nuevos logros de Fundación SENO aparecerán próximamente en esta
            página.
          </p>
        </section>
      )
    }
  </main>
</Layout>

<style>
  .achievements-page {
    width: min(calc(100% - 2rem), 62.5rem);
    margin-inline: auto;
    padding-bottom: clamp(3rem, 7vw, 6rem);
  }

  .achievements-page__introduction {
    width: min(100%, 45rem);
    margin: 0 auto clamp(2rem, 5vw, 3rem);
    text-align: center;
  }

  .achievements-page__introduction h2 {
    color: var(--color-primary-hover);
    font-size: clamp(1.5rem, 4vw, 2rem);
    line-height: 1.25;
    text-wrap: balance;
  }

  .achievements-page__introduction p {
    margin-top: 0.75rem;

    color: var(--color-text);

    font-size: clamp(0.98rem, 2vw, 1.08rem);
    line-height: 1.7;
    text-wrap: pretty;
  }

  .achievements-page__list {
    width: 100%;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(1rem, 3vw, 1.5rem);
  }

  .achievements-page__list > li {
    min-width: 0;
  }

  .achievements-page__status {
    width: min(100%, 45rem);
    margin: 2rem auto 0;
    padding: clamp(1.75rem, 5vw, 3rem);

    color: var(--color-text);
    background-color: rgba(192, 226, 156, 0.3);

    border: 1px dashed var(--color-primary-light);
    border-radius: var(--radius);

    text-align: center;
  }

  .achievements-page__status--error {
    background-color: rgba(211, 47, 47, 0.06);
    border-color: rgba(211, 47, 47, 0.4);
  }

  .achievements-page__status h2 {
    color: var(--color-primary-hover);
    font-size: clamp(1.25rem, 4vw, 1.7rem);
    line-height: 1.3;
    text-wrap: balance;
  }

  .achievements-page__status--error h2 {
    color: var(--color-red, #b42318);
  }

  .achievements-page__status p {
    margin-top: 0.75rem;
    color: var(--color-grey);
    line-height: 1.6;
    text-wrap: pretty;
  }

  @media (max-width: 500px) {
    .achievements-page {
      width: calc(100% - 1.25rem);
      padding-bottom: 3rem;
    }

    .achievements-page__introduction {
      margin-bottom: 2rem;
    }

    .achievements-page__list {
      gap: 1rem;
    }
  }
</style>
