---
import Layout from '../../layouts/Layout.astro'

import TituloPag from '../../components/Common/TituloPag.astro'
import ItemNoticia from '../../components/Noticias/ItemNoticia.astro'

import type Noticia from '../../data/interfaces/Noticia'

import { getNoticias } from '../../api/noticias'

const noticias: Noticia[] = await getNoticias()
---

<Layout pag="Noticias">
  <TituloPag titulo="Noticias" />

  <main class="main-noticias">
    {
      noticias.length > 0 ? (
        <section class="lista-noticias" aria-label="Noticias de Fundación SENO">
          {noticias.map((item: Noticia, index: number) => (
            <ItemNoticia noticia={item} priority={index === 0} />
          ))}
        </section>
      ) : (
        <p class="sin-noticias">Todavía no hay noticias publicadas.</p>
      )
    }
  </main>
</Layout>

<style>
  .main-noticias {
    box-sizing: border-box;

    width: min(calc(100% - 2rem), 1200px);
    margin-inline: auto;
    padding-bottom: clamp(3rem, 7vw, 6rem);
  }

  .lista-noticias {
    width: 100%;

    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    align-items: stretch;
    justify-items: center;
    gap: clamp(1.25rem, 3vw, 2rem);
  }

  .sin-noticias {
    width: min(100%, 40rem);
    margin: 2rem auto 0;
    padding: clamp(1rem, 3vw, 1.5rem);

    border: 1px solid var(--color-primary-light);
    border-radius: 1rem;
    background-color: color-mix(
      in srgb,
      var(--color-primary-light) 30%,
      transparent
    );

    color: var(--color-text);

    font-family: var(--text-font-primary);
    line-height: 1.6;
    text-align: center;
  }

  @media (max-width: 700px) {
    .lista-noticias {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.5rem;
    }
  }

  @media (max-width: 500px) {
    .main-noticias {
      width: calc(100% - 1.25rem);
      padding-bottom: 3rem;
    }
  }
</style>
