---
import Layout from '../../layouts/Layout.astro'

import TituloPag from '../../components/Common/TituloPag.astro'
import ItemNoticia from '../../components/Noticias/ItemNoticia.astro'

import type Noticia from '../../data/interfaces/Noticia'

import { getNoticias } from '../../api/noticias'

let noticias: Noticia[] = []
let loadingError = false

try {
  const response = await getNoticias()

  if (!Array.isArray(response)) {
    throw new TypeError('La respuesta de noticias no es un arreglo')
  }

  noticias = response
} catch (error) {
  loadingError = true
  Astro.response.status = 503
  Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow, noarchive')
  Astro.response.headers.set('Cache-Control', 'no-store')

  console.error('No se pudieron cargar las noticias:', error)
}
---

<Layout
  pag="Noticias"
  seoTitle="Noticias de Fundación SENO Neuquén"
  description="Conocé las novedades, actividades y acciones realizadas por Fundación SENO."
  noindex={loadingError}
>
  <TituloPag titulo="Noticias" />

  <main class="news-page">
    {
      loadingError ? (
        <section
          class="
            news-page__status
            news-page__status--error
          "
          role="alert"
        >
          <h2>No pudimos cargar las noticias</h2>

          <p>Intentá ingresar nuevamente más tarde.</p>
        </section>
      ) : noticias.length > 0 ? (
        <section
          class="news-page__results"
          aria-label="Noticias de Fundación SENO"
        >
          <ul class="news-page__list">
            {noticias.map((noticia: Noticia, index: number) => (
              <li>
                <ItemNoticia noticia={noticia} priority={index === 0} />
              </li>
            ))}
          </ul>
        </section>
      ) : (
        <section class="news-page__status" role="status">
          <h2>Todavía no hay noticias publicadas</h2>

          <p>
            Cuando haya una nueva novedad, la vas a encontrar en esta página.
          </p>
        </section>
      )
    }
  </main>
</Layout>

<style>
  .news-page {
    width: min(calc(100% - 2rem), 75rem);

    margin-inline: auto;

    padding-bottom: clamp(3rem, 7vw, 6rem);
  }

  .news-page__results {
    width: 100%;
    min-width: 0;
  }

  .news-page__list {
    width: 100%;
    min-width: 0;

    display: grid;

    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));

    align-items: stretch;

    gap: clamp(1.25rem, 3vw, 2rem);
  }

  .news-page__list > li {
    min-width: 0;

    display: flex;
  }

  .news-page__status {
    width: min(100%, 40rem);

    margin: 2rem auto 0;

    padding: clamp(1.75rem, 5vw, 3rem);

    color: var(--color-text);

    background-color: rgba(192, 226, 156, 0.3);

    border: 1px dashed var(--color-primary-light);

    border-radius: var(--radius);

    text-align: center;
  }

  .news-page__status--error {
    background-color: rgba(211, 47, 47, 0.06);

    border-color: rgba(211, 47, 47, 0.4);
  }

  .news-page__status h2 {
    color: var(--color-primary-hover);

    font-size: clamp(1.25rem, 4vw, 1.7rem);

    line-height: 1.3;
    text-wrap: balance;
  }

  .news-page__status--error h2 {
    color: var(--color-red, #b42318);
  }

  .news-page__status p {
    margin-top: 0.75rem;

    color: var(--color-grey);

    line-height: 1.6;
    text-wrap: pretty;
  }

  @media (max-width: 700px) {
    .news-page__list {
      grid-template-columns: minmax(0, 1fr);

      gap: 1.5rem;
    }
  }

  @media (max-width: 500px) {
    .news-page {
      width: calc(100% - 1.25rem);

      padding-bottom: 3rem;
    }
  }
</style>
