---
import { Image } from 'astro:assets'

import Layout from '../../layouts/Layout.astro'

import TituloPag from '../../components/Common/TituloPag.astro'
import NavegacionPelucas from '../../components/Pelucas/NavegacionPelucas.astro'

import ImgTaller from '../../assets/img_taller/confeccion_pelucas.avif'
import SvgEstrella from '../../assets/icon-common/icon-estrella.svg'
import SvgFlecha from '../../assets/icon-common/icon-flecha.svg'
---

<Layout
  pag="Pelucas"
  seoTitle="Pelucas oncológicas artesanales | Fundación SENO"
  description="Conocé el taller artesanal de pelucas de Fundación SENO, el primero de la Patagonia destinado a pacientes oncológicos."
>
  <NavegacionPelucas pag="0" />

  <TituloPag titulo="Pelucas" />

  <main class="wigs-page">
    <section class="wigs-hero" aria-labelledby="wigs-hero-title">
      <div class="wigs-hero__image-container">
        <Image
          class="wigs-hero__image"
          src={ImgTaller}
          alt="Voluntarias de Fundación SENO confeccionando una peluca"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>

      <div class="wigs-hero__content">
        <p class="wigs-hero__label">Taller de pelucas</p>

        <h2 id="wigs-hero-title">Mucho más que una peluca</h2>

        <p class="wigs-hero__description">
          Sabemos que la pérdida del cabello suele ser uno de los momentos más
          difíciles del tratamiento oncológico. Por eso confeccionamos pelucas
          de manera totalmente artesanal, buscando que cada persona vuelva a
          sentirse cómoda, segura y acompañada.
        </p>

        <aside class="wigs-hero__highlight" aria-label="Dato destacado">
          <SvgEstrella class="wigs-hero__highlight-icon" aria-hidden="true" />

          <p>
            <strong>
              Fuimos el primer taller de pelucas para pacientes oncológicos de
              toda la Patagonia.
            </strong>

            El proyecto continúa creciendo gracias al compromiso de nuestras
            voluntarias y de cada persona que decide donar cabello.
          </p>
        </aside>
      </div>
    </section>

    <section class="wigs-benefits" aria-labelledby="wigs-benefits-title">
      <h2 id="wigs-benefits-title" class="visually-hidden">
        La importancia de nuestro taller de pelucas
      </h2>

      <ul class="wigs-benefits__list">
        <li>
          <article class="wigs-benefit-card">
            <span class="wigs-benefit-card__icon" aria-hidden="true"> ❤️ </span>

            <h3>Recuperar confianza</h3>

            <p>
              Una peluca no cambia un diagnóstico, pero puede ayudar a que una
              persona vuelva a mirarse al espejo con tranquilidad y seguridad.
            </p>
          </article>
        </li>

        <li>
          <article class="wigs-benefit-card">
            <span class="wigs-benefit-card__icon" aria-hidden="true"> ✂️ </span>

            <h3>Hechas a mano</h3>

            <p>
              Cada peluca es confeccionada artesanalmente por voluntarias que
              dedican su tiempo y experiencia para acompañar a quienes más lo
              necesitan.
            </p>
          </article>
        </li>

        <li>
          <article class="wigs-benefit-card">
            <span class="wigs-benefit-card__icon" aria-hidden="true"> 🤝 </span>

            <h3>Todo comienza con una donación</h3>

            <p>
              Detrás de cada donación de cabello hay una historia, una promesa o
              simplemente el deseo de ayudar. Ese gesto es el primer paso para
              transformar una vida.
            </p>
          </article>
        </li>
      </ul>
    </section>

    <blockquote class="wigs-quote">
      <p>
        Cada peluca comienza con un cabello donado y termina devolviendo una
        sonrisa.
      </p>
    </blockquote>
    <div class="wigs-cta-container">
      <a
        class="wigs-button-destacado"
        href="https://forms.gle/fP7pBoqrkT5f7Rb27"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span>Solicitar una peluca</span>
        <SvgFlecha />
      </a>
    </div>
  </main>
</Layout>

<style>
  .wigs-page {
    width: min(calc(100% - 2rem), 75rem);

    margin-inline: auto;

    padding: clamp(2rem, 6vw, 6rem) 0 clamp(4rem, 10vw, 7rem);
  }

  .visually-hidden {
    width: 1px;
    height: 1px;

    position: absolute;

    overflow: hidden;

    clip-path: inset(50%);

    white-space: nowrap;
  }

  /* ========================================================
     HERO
  ======================================================== */

  .wigs-hero {
    display: grid;

    grid-template-columns:
      minmax(0, 1fr)
      minmax(0, 1fr);

    align-items: center;

    gap: clamp(2rem, 6vw, 4rem);
  }

  .wigs-hero__image-container {
    min-height: 28rem;

    overflow: hidden;

    background-color: var(--color-primary-light);

    border-radius: clamp(1rem, 3vw, 1.5rem);

    box-shadow: var(--shadow);
  }

  .wigs-hero__image {
    width: 100%;
    height: 100%;
    min-height: 28rem;

    object-fit: cover;
    object-position: center;
  }

  .wigs-hero__content {
    min-width: 0;
  }

  .wigs-hero__label {
    width: fit-content;

    margin-bottom: 1rem;

    padding: 0.4rem 1rem;

    color: var(--color-primary-hover);

    background-color: var(--color-primary-light);

    border-radius: 999px;

    font-size: 0.8rem;
    font-weight: 750;
    line-height: 1.3;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .wigs-hero__content h2 {
    margin-bottom: 1.5rem;

    color: var(--color-text);

    font-size: clamp(2.3rem, 5vw, 3.7rem);

    line-height: 1.08;
    text-wrap: balance;
  }

  .wigs-hero__description {
    margin-bottom: 2rem;

    color: var(--color-grey);

    font-size: 1.05rem;
    line-height: 1.9;
    text-wrap: pretty;
  }

  .wigs-hero__highlight {
    padding: 1.5rem;

    display: flex;
    align-items: flex-start;
    gap: 1rem;

    color: var(--color-text);
    background-color: rgba(192, 226, 156, 0.2);

    border-left: 5px solid var(--color-primary);

    border-radius: 0 var(--radius) var(--radius) 0;
  }

  .wigs-hero__highlight-icon {
    width: 1.75rem;
    height: 1.75rem;

    flex: 0 0 auto;

    color: #d59d00;
  }

  .wigs-hero__highlight p {
    line-height: 1.75;
    text-wrap: pretty;
  }

  .wigs-hero__highlight strong {
    color: var(--color-primary-hover);
  }

  /* ========================================================
     BENEFITS
  ======================================================== */

  .wigs-benefits {
    margin-top: clamp(4rem, 10vw, 6rem);
  }

  .wigs-benefits__list {
    display: grid;

    grid-template-columns: repeat(3, minmax(0, 1fr));

    align-items: stretch;

    gap: clamp(1.25rem, 4vw, 2rem);
  }

  .wigs-benefits__list > li {
    min-width: 0;

    display: flex;
  }

  .wigs-benefit-card {
    width: 100%;
    height: 100%;

    padding: clamp(1.5rem, 4vw, 2rem);

    color: var(--color-text);
    background-color: #ffffff;

    border: 1px solid var(--color-light-grey);

    border-radius: 1.25rem;

    box-shadow: 0 0.65rem 2.2rem rgba(0, 0, 0, 0.08);

    transition:
      border-color var(--transition),
      box-shadow var(--transition),
      transform var(--transition);
  }

  .wigs-benefit-card__icon {
    margin-bottom: 1rem;

    display: block;

    font-size: 2.4rem;
    line-height: 1;
  }

  .wigs-benefit-card h3 {
    margin-bottom: 1rem;

    color: var(--color-primary-hover);

    font-size: 1.25rem;
    line-height: 1.3;
    text-wrap: balance;
  }

  .wigs-benefit-card p {
    color: var(--color-grey);

    line-height: 1.8;
    text-wrap: pretty;
  }

  /* ========================================================
     QUOTE
  ======================================================== */

  .wigs-quote {
    width: min(100%, 53rem);

    margin: clamp(4rem, 10vw, 5rem) auto 0;

    padding: clamp(2rem, 6vw, 3rem);

    position: relative;

    overflow: hidden;

    color: var(--color-background);

    background: linear-gradient(
      135deg,
      var(--color-primary),
      var(--color-primary-hover)
    );

    border-radius: 1.5rem;

    text-align: center;

    box-shadow: 0 1rem 2.5rem rgba(73, 107, 36, 0.2);
  }

  .wigs-quote::before {
    content: '“';

    position: absolute;
    top: -3rem;
    left: 1rem;

    color: rgba(255, 255, 255, 0.12);

    font-size: 12rem;
    font-family: Georgia, serif;
    line-height: 1;
  }

  .wigs-quote p {
    position: relative;

    color: inherit;

    font-size: clamp(1.25rem, 3vw, 1.6rem);

    font-style: italic;
    font-weight: 700;
    line-height: 1.7;
    text-wrap: balance;
  }

  /* ========================================================
     CALL TO ACTION
  ======================================================== */

  .wigs-cta-container {
    margin: clamp(4rem, 10vw, 7rem) auto;
    display: flex;
    justify-content: center;
    width: 100%;
  }

  .wigs-cta-container svg {
    height: 24px;
    width: 24px;
    transform: rotate(90deg);
  }

  .wigs-cta-container a.wigs-button-destacado {
    display: inline-flex !important;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;

    padding: 1.25rem 3rem;

    color: var(--color-background, #ffffff) !important;
    background-color: var(--color-primary, #6b9e35) !important;

    border-radius: 999px;
    border: none;

    /* Tipografía más fuerte e imperativa */
    font-size: clamp(1.1rem, 3vw, 1.25rem);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-decoration: none !important;
    text-align: center;

    box-shadow: 0 1rem 2.5rem rgba(0, 0, 0, 0.15);

    animation: latido-suave 2.5s infinite;

    transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
  }
  @keyframes latido-suave {
    0% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.04);
    }
    100% {
      transform: scale(1);
    }
  }

  @media (hover: hover) {
    .wigs-cta-container a.wigs-button-destacado:hover {
      background-color: var(--color-primary-hover, #496b24) !important;
      box-shadow: 0 1.2rem 3rem rgba(0, 0, 0, 0.25);
      transform: translateY(-5px) scale(1.04);
      animation: none;
    }
  }

  @media (max-width: 600px) {
    .wigs-cta-container a.wigs-button-destacado {
      width: 100%;
      padding: 1.25rem 1rem;  
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wigs-cta-container a.wigs-button-destacado {
      animation: none;
      transition: none;
    }
  }
</style>
