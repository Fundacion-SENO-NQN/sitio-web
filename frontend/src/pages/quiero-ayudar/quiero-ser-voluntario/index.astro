---
import Layout from '../../../layouts/Layout.astro'

import NavegacionQuieroAyudar from '../../../components/QuieroAyudar/NavegacionQuieroAyudar.astro'
import TituloPag from '../../../components/Common/TituloPag.astro'

import SvgCorazon from '../../../assets/icon-common/icon-corazon.svg'
import SvgUsuario from '../../../assets/icon-common/icon-user.svg'
import SvgCheck from '../../../assets/icon-donar-cosas/icon-check.svg'
import SvgMensaje from '../../../assets/icon-common/icon-mensaje.svg'
import SvgContrato from '../../../assets/icon-voluntariado/icon-contrato.svg'
import SvgCasa from '../../../assets/icon-voluntariado/icon-casa.svg'
import SvgContratoCuadrado from '../../../assets/icon-voluntariado/icon-contrato-cuadrado.svg'
import SvgUniversitario from '../../../assets/icon-voluntariado/icon-universitario.svg'
import SvgContratoFundacion from '../../../assets/icon-voluntariado/icon-contrato-fundacion.svg'
import SvgContratoFundacionBaja from '../../../assets/icon-voluntariado/icon-contrato-fundacion-baja.svg'
import SvgMensajeVacio from '../../../assets/icon-common/icon-mensaje-vacio.svg'
import SvgEmail from '../../../assets/icon-contacto/icon-email.svg'
import SvgEnviar from '../../../assets/icon-common/icon-enviar.svg'
import SvgInfo from '../../../assets/icon-common/icon-info.svg'
import SvgFlecha from '../../../assets/icon-common/icon-flecha.svg'
---

<Layout pag="Quiero ser voluntario">
  <NavegacionQuieroAyudar pag="4" />
  <TituloPag titulo="Quiero ser voluntario" />

  <main class="voluntariado">
    <section class="hero">
      <div class="hero__contenido">
        <span class="etiqueta">Súmate a Fundación SENO</span>

        <h1>Tu tiempo y tu buena voluntad pueden ayudar</h1>

        <p class="hero__destacado">
          Para formar parte del voluntariado no necesitas experiencia previa. Lo
          más importante es tener disposición, responsabilidad y ganas de
          colaborar.
        </p>

        <p>
          Antes de comenzar cualquier actividad es necesario comunicarse con la
          Fundación para conversar, conocer las posibilidades de participación y
          coordinar una visita.
        </p>

        <div class="hero__acciones">
          <a class="boton boton--principal" href="#formulario-voluntariado">
            Quiero comunicarme

            <SvgFlecha />
          </a>

          <a class="boton boton--secundario" href="#documentacion">
            Ver documentación
          </a>
        </div>
      </div>

      <div class="hero__visual" aria-hidden="true">
        <div class="ilustracion">
          <span class="ilustracion__corazon">
            <SvgCorazon />
          </span>

          <div class="ilustracion__personas">
            <span>
              <SvgUsuario />
            </span>

            <span class="ilustracion__persona-central">
              <SvgUsuario />
            </span>

            <span>
              <SvgUsuario />
            </span>
          </div>

          <span class="ilustracion__decoracion ilustracion__decoracion--uno">
          </span>

          <span class="ilustracion__decoracion ilustracion__decoracion--dos">
          </span>
        </div>
      </div>
    </section>

    <section class="requisito-principal" aria-labelledby="requisitos">
      <div class="requisito-principal__icono" aria-hidden="true">
        <SvgCheck />
      </div>

      <div>
        <span class="etiqueta">Requisito principal</span>
        <h2 id="requisitos">Disposición, compromiso y buena voluntad</h2>

        <p>
          Buscamos personas dispuestas a colaborar responsablemente, respetar el
          trabajo de la Fundación y acompañar sus actividades con empatía y
          compromiso.
        </p>

        <p>
          La forma de participación y los horarios se conversan previamente con
          la Fundación de acuerdo con las actividades disponibles.
        </p>
      </div>
    </section>

    <section class="informacion" aria-labelledby="titulo-informacion">
      <header class="encabezado-seccion">
        <span class="etiqueta">Antes de comenzar</span>
        <h2 id="titulo-informacion">¿Qué debes tener en cuenta?</h2>

        <p>
          El voluntariado se coordina previamente y requiere completar la
          documentación correspondiente.
        </p>
      </header>

      <div class="informacion__grid">
        <article class="tarjeta-informacion">
          <div class="tarjeta-informacion__icono" aria-hidden="true">
            <SvgMensaje />
          </div>

          <h3>Comunícate primero</h3>

          <p>
            Antes de presentarte en la Fundación, completa el formulario o
            comunícate por alguno de nuestros medios de contacto.
          </p>
        </article>

        <article class="tarjeta-informacion">
          <div class="tarjeta-informacion__icono" aria-hidden="true">
            <SvgContrato />
          </div>

          <h3>Completa el contrato de alta</h3>

          <p>
            Para ingresar al voluntariado deberás imprimir, completar y firmar
            el contrato de alta.
          </p>
        </article>

        <article class="tarjeta-informacion">
          <div class="tarjeta-informacion__icono" aria-hidden="true">
            <SvgCasa />
          </div>

          <h3>Acércalo a la Fundación</h3>

          <p>
            El contrato de alta debe entregarse impreso y firmado cuando se
            coordine la visita a la Fundación.
          </p>
        </article>

        <article class="tarjeta-informacion">
          <div class="tarjeta-informacion__icono" aria-hidden="true">
            <SvgContratoCuadrado />
          </div>

          <h3>Voluntariado universitario</h3>

          <p>
            Cuando la participación forma parte de una materia, práctica o
            proyecto universitario, deberás presentar también la documentación
            solicitada por tu universidad.
          </p>
        </article>
      </div>
    </section>

    <section class="universidad" aria-labelledby="titulo-universidad">
      <div class="universidad__icono" aria-hidden="true">
        <SvgUniversitario />
      </div>

      <div class="universidad__contenido">
        <span class="etiqueta">Estudiantes universitarios</span>
        <h2 id="titulo-universidad">
          ¿El voluntariado forma parte de una materia?
        </h2>

        <p>
          Algunas universidades utilizan contratos, convenios o formularios
          propios para sus prácticas y actividades de extensión. Esa
          documentación puede ser diferente del contrato general de alta de
          voluntariado.
        </p>

        <p>
          Comunícate previamente con Fundación SENO e indícanos el nombre de la
          universidad, la carrera o materia y el tipo de actividad requerida. De
          esta manera podremos revisar la documentación y coordinar los
          detalles.
        </p>
      </div>
    </section>

    <section
      id="documentacion"
      class="documentacion"
      aria-labelledby="titulo-documentacion"
    >
      <header class="encabezado-seccion">
        <span class="etiqueta">Documentación</span>
        <h2 id="titulo-documentacion">Contratos de voluntariado</h2>

        <p>
          Descarga el documento que corresponda. Los contratos deben ser
          impresos, completados y firmados.
        </p>
      </header>

      <div class="documentacion__grid">
        <article class="documento documento--alta">
          <div class="documento__encabezado">
            <span class="documento__icono" aria-hidden="true">
              <SvgContratoFundacion />
            </span>

            <div>
              <span class="documento__tipo">Ingreso</span>
              <h3>Contrato de alta</h3>
            </div>
          </div>

          <p>
            Debe presentarse impreso y firmado para formalizar el ingreso como
            voluntario o voluntaria de la Fundación.
          </p>

          <ul>
            <li>Incluye los derechos y deberes del voluntariado.</li>
            <li>Establece las actividades y el tiempo de dedicación.</li>
            <li>Debe ser firmado por el voluntario y la organización.</li>
          </ul>

          <a
            href="/documentos/alta-voluntariado.pdf"
            target="_blank"
            rel="noopener noreferrer"
          >
            Ver e imprimir contrato

            <SvgFlecha />
          </a>
        </article>

        <article class="documento documento--baja">
          <div class="documento__encabezado">
            <span class="documento__icono" aria-hidden="true">
              <SvgContratoFundacionBaja />
            </span>

            <div>
              <span class="documento__tipo">Desvinculación</span>
              <h3>Contrato de baja</h3>
            </div>
          </div>

          <p>
            Si una persona decide dejar el voluntariado, debe completar y firmar
            el documento de baja correspondiente.
          </p>

          <ul>
            <li>Registra la fecha de finalización.</li>
            <li>Permite informar el motivo de la desvinculación.</li>
            <li>Registra la devolución de la credencial.</li>
          </ul>

          <a
            href="/documentos/baja-voluntariado.pdf"
            target="_blank"
            rel="noopener noreferrer"
          >
            Ver e imprimir contrato

            <SvgFlecha />
          </a>
        </article>
      </div>

      <div class="documentacion__aviso">
        <SvgInfo />

        <p>
          Completar el formulario de esta página no reemplaza la entrega del
          contrato impreso y firmado.
        </p>
      </div>
    </section>

    <section class="proceso" aria-labelledby="titulo-proceso">
      <div class="proceso__introduccion">
        <span class="etiqueta">Cómo participar</span>
        <h2 id="titulo-proceso">El proceso para comenzar</h2>

        <p>
          Primero queremos conocerte y conversar sobre las actividades en las
          que podrías participar.
        </p>
      </div>

      <div class="proceso__pasos">
        <article class="paso">
          <span class="paso__numero">1</span>

          <div>
            <h3>Completa el formulario</h3>

            <p>
              Cuéntanos quién eres, dónde vives y por qué te gustaría colaborar.
            </p>
          </div>
        </article>

        <article class="paso">
          <span class="paso__numero">2</span>

          <div>
            <h3>Nos comunicamos contigo</h3>

            <p>
              La Fundación responderá al correo electrónico que hayas ingresado.
            </p>
          </div>
        </article>

        <article class="paso">
          <span class="paso__numero">3</span>

          <div>
            <h3>Coordinamos una visita</h3>

            <p>
              Acordaremos el día, el horario y las posibilidades de
              participación.
            </p>
          </div>
        </article>

        <article class="paso">
          <span class="paso__numero">4</span>

          <div>
            <h3>Presenta la documentación</h3>

            <p>
              Lleva el contrato correspondiente impreso, completo y firmado.
            </p>
          </div>
        </article>
      </div>
    </section>

    <section
      id="formulario-voluntariado"
      class="solicitud"
      aria-labelledby="titulo-formulario"
    >
      <div class="solicitud__informacion">
        <span class="etiqueta">Primer contacto</span>

        <h2 id="titulo-formulario">Cuéntanos sobre ti</h2>

        <p>
          Completa el formulario para que podamos comunicarnos
          con vos por correo electrónico y coordinar los detalles.
        </p>

        <div class="solicitud__dato">
          <span class="solicitud__dato-icono" aria-hidden="true">
            <SvgMensajeVacio />
          </span>

          <div>
            <strong>No es una inscripción automática</strong>

            <p>
              El formulario inicia el contacto. La participación se confirma
              luego de conversar con la Fundación.
            </p>
          </div>
        </div>

        <div class="solicitud__dato">
          <span class="solicitud__dato-icono" aria-hidden="true">
            <SvgEmail />
          </span>

          <div>
            <strong>Revisa tu correo electrónico</strong>

            <p>
              Allí recibirás la respuesta para continuar coordinando la visita.
            </p>
          </div>
        </div>
      </div>

      <form
        id="form-voluntariado"
        class="formulario"
        autocomplete="on"
        novalidate
      >
        <div class="formulario__fila">
          <div class="campo">
            <label for="nombre">
              Nombre
              <span aria-hidden="true">*</span>
            </label>

            <input
              id="nombre"
              name="nombre"
              type="text"
              autocomplete="given-name"
              maxlength="80"
              required
            />

            <small>Ingresa tu nombre.</small>
          </div>

          <div class="campo">
            <label for="apellido">
              Apellido
              <span aria-hidden="true">*</span>
            </label>

            <input
              id="apellido"
              name="apellido"
              type="text"
              autocomplete="family-name"
              maxlength="80"
              required
            />

            <small>Ingresa tu apellido.</small>
          </div>
        </div>

        <div class="formulario__fila">
          <div class="campo">
            <label for="localidad">
              Localidad
              <span aria-hidden="true">*</span>
            </label>

            <input
              id="localidad"
              name="localidad"
              type="text"
              autocomplete="address-level2"
              maxlength="100"
              placeholder="Por ejemplo: Neuquén Capital"
              required
            />

            <small>Indica la localidad donde vives.</small>
          </div>

          <div class="campo">
            <label for="email">
              Correo electrónico
              <span aria-hidden="true">*</span>
            </label>

            <input
              id="email"
              name="email"
              type="email"
              autocomplete="email"
              inputmode="email"
              maxlength="150"
              placeholder="nombre@correo.com"
              required
            />

            <small>Utilizaremos este correo para responderte.</small>
          </div>
        </div>

        <div class="campo">
          <label for="tipo">
            Tipo de voluntariado
            <span aria-hidden="true">*</span>
          </label>

          <select id="tipo" name="tipo" required>
            <option value="" selected disabled> Selecciona una opción </option>

            <option value="voluntariado-general">
              Quiero colaborar de manera voluntaria
            </option>

            <option value="voluntariado-universitario">
              Es parte de una materia o actividad universitaria
            </option>
          </select>

          <small>
            Esto nos ayuda a identificar qué documentación necesitaremos.
          </small>
        </div>

        <div class="campo">
          <label for="descripcion">
            Cuéntanos sobre ti
            <span aria-hidden="true">*</span>
          </label>

          <textarea
            id="descripcion"
            name="descripcion"
            rows="7"
            minlength="30"
            maxlength="1500"
            placeholder="Puedes contarnos por qué quieres colaborar, qué disponibilidad tienes, si vienes por una universidad o en qué actividades te gustaría participar."
            required></textarea>

          <small>
            No incluyas información médica, contraseñas ni otros datos
            sensibles.
          </small>
        </div>

        <div class="campo-trampa" aria-hidden="true">
          <label for="sitio_web">No completar este campo</label>
          <input
            id="sitio_web"
            name="sitio_web"
            type="text"
            tabindex="-1"
            autocomplete="off"
          />
        </div>

        <label class="consentimiento">
          <input
            id="autorizacion"
            name="acepta_contacto"
            type="checkbox"
            value="true"
            required
          />

          <span>
            Autorizo a Fundación SENO a utilizar los datos ingresados para
            responder esta consulta y comunicarse conmigo por correo
            electrónico.
          </span>
        </label>

        <div
          id="estado-formulario"
          class="estado-formulario"
          role="status"
          aria-live="polite"
        >
        </div>

        <button id="boton-enviar" type="submit" disabled>
          <span>Enviar solicitud</span>

          <SvgEnviar />
        </button>

        <p class="formulario__obligatorios">
          Los campos marcados con <span>*</span> son obligatorios.
        </p>
      </form>
    </section>
  </main>
</Layout>

<script>
  const form = document.getElementById('form-voluntariado') as HTMLFormElement
  const estado = document.getElementById('estado-formulario') as HTMLElement
  const boton = document.getElementById('boton-enviar') as HTMLButtonElement

  const apiUrl = import.meta.env.PUBLIC_API_URL

  const inputNombre = document.getElementById('nombre') as HTMLInputElement
  const inputApellido = document.getElementById('apellido') as HTMLInputElement
  const inputLocalidad = document.getElementById(
    'localidad',
  ) as HTMLInputElement
  const inputEmail = document.getElementById('email') as HTMLInputElement
  const inputDescripcion = document.getElementById(
    'descripcion',
  ) as HTMLInputElement
  const selectTipo = document.getElementById('tipo') as HTMLSelectElement
  const inputAutorizacion = document.getElementById(
    'autorizacion',
  ) as HTMLInputElement

  const arrInputs: HTMLInputElement[] = [
    inputNombre,
    inputApellido,
    inputLocalidad,
    inputEmail,
    inputDescripcion,
  ]

  form?.addEventListener('submit', async (evento): Promise<void> => {
    evento.preventDefault()

    if (!form.reportValidity() || !estado || !boton) return

    const datos: FormData = new FormData(form)
    const campoTrampa: FormDataEntryValue | null = datos.get('sitio_web')

    if (campoTrampa) {
      form.reset()
      estado.className = 'estado-formulario estado-formulario--exito'
      estado.textContent =
        'Tu solicitud fue enviada. Nos comunicaremos contigo por correo electrónico.'
      return
    }

    if (!apiUrl) {
      estado.className = 'estado-formulario estado-formulario--error'
      estado.textContent =
        'El formulario todavía no está conectado con el servidor. Comunícate directamente con la Fundación.'
      return
    }

    const contenidoOriginal: string = boton.innerHTML

    boton.disabled = true
    boton.classList.add('enviando')
    boton.innerHTML = `
      <span>Enviando...</span>
      <span class="cargador" aria-hidden="true"></span>
    `

    estado.className = 'estado-formulario'
    estado.textContent = ''

    try {
      const respuesta: Response = await fetch(
        `${apiUrl.replace(/\/$/, '')}/voluntariado/solicitud`,
        {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            nombre: datos.get('nombre'),
            apellido: datos.get('apellido'),
            localidad: datos.get('localidad'),
            email: datos.get('email'),
            tipo: datos.get('tipo'),
            descripcion: datos.get('descripcion'),
            acepta_contacto: datos.get('acepta_contacto') === 'true',
          }),
        },
      )

      if (!respuesta.ok) {
        throw new Error(
          `El servidor respondió con el estado ${respuesta.status}`,
        )
      }

      form.reset()

      estado.className = 'estado-formulario estado-formulario--exito'
      estado.textContent =
        'Tu solicitud fue enviada correctamente. Fundación SENO se comunicará contigo por correo electrónico.'
    } catch (error) {
      console.error('No se pudo enviar la solicitud de voluntariado:', error)

      estado.className = 'estado-formulario estado-formulario--error'
      estado.textContent =
        'No pudimos enviar la solicitud. Inténtalo nuevamente o comunícate directamente con la Fundación.'
    } finally {
      boton.disabled = false
      boton.classList.remove('enviando')
      boton.innerHTML = contenidoOriginal
    }
  })

  function desbloquearBtn(e: Event): void {
    e.preventDefault()
    boton.disabled = !(
      arrInputs.every((item): boolean => item.value.length > 0) &&
      selectTipo.value !== '' &&
      inputAutorizacion.checked && form.checkValidity()
    )
  }

  arrInputs.forEach((item): void =>
    item.addEventListener('input', desbloquearBtn),
  )
  selectTipo.addEventListener('input', desbloquearBtn)
  inputAutorizacion.addEventListener('change', desbloquearBtn)
</script>

<style>
  .voluntariado {
    --vol-primary: var(--color-primary, #4178aa);
    --vol-primary-dark: var(--color-primary-hover, #25597f);
    --vol-secondary: var(--color-secondary, #d45d8c);
    --vol-text: var(--color-text, #28343e);
    --vol-muted: #65737e;
    --vol-border: #dce6ed;
    --vol-background: #f5f9fb;
    --vol-success: #28795a;
    --vol-success-background: #eff9f4;
    --vol-error: #a94242;
    --vol-error-background: #fff1f1;

    width: min(1180px, calc(100% - 2rem));
    margin: 2rem auto 5rem;
    color: var(--vol-text);
    font-family: var(--text-font-primary, system-ui, sans-serif);
  }

  .etiqueta {
    display: block;
    margin-bottom: 0.65rem;
    color: var(--vol-primary-dark);
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(280px, 0.7fr);
    align-items: center;
    gap: clamp(2rem, 7vw, 6rem);
    min-height: 480px;
    padding: clamp(2rem, 6vw, 5rem);
    overflow: hidden;
    border: 1px solid var(--vol-border);
    border-radius: 2rem;
    background:
      radial-gradient(
        circle at 88% 18%,
        rgb(212 93 140 / 16%),
        transparent 28%
      ),
      radial-gradient(circle at 8% 92%, rgb(65 120 170 / 12%), transparent 25%),
      linear-gradient(135deg, #fbfdfe 0%, #edf5fa 100%);
  }

  .hero::before {
    position: absolute;
    right: -120px;
    bottom: -145px;
    width: 360px;
    aspect-ratio: 1;
    border: 50px solid rgb(65 120 170 / 6%);
    border-radius: 50%;
    content: '';
  }

  .hero__contenido,
  .hero__visual {
    position: relative;
    z-index: 1;
  }

  .hero h1 {
    max-width: 760px;
    margin: 0 0 1.3rem;
    color: var(--vol-primary-dark);
    font-size: clamp(2.2rem, 5.2vw, 4.2rem);
    line-height: 1.04;
    text-wrap: balance;
  }

  .hero p {
    max-width: 720px;
    margin: 0.75rem 0;
    color: var(--vol-muted);
    font-size: 1.03rem;
    line-height: 1.75;
  }

  .hero .hero__destacado {
    color: var(--vol-text);
    font-size: clamp(1.08rem, 2vw, 1.24rem);
    font-weight: 600;
  }

  .hero__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 1.7rem;
  }

  .boton {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    min-height: 49px;
    padding: 0.85rem 1.3rem;
    border: 2px solid transparent;
    border-radius: 999px;
    font-weight: 800;
    text-align: center;
    text-decoration: none;
    transition:
      transform 180ms ease,
      background-color 180ms ease,
      color 180ms ease,
      box-shadow 180ms ease;
  }

  .boton svg {
    width: 20px;
    flex-shrink: 0;
  }

  .boton--principal {
    background: var(--vol-primary-dark);
    color: #fff;
    box-shadow: 0 12px 28px rgb(37 89 127 / 22%);
  }

  .boton--principal svg {
    transform: rotate(90deg);
  }

  .boton--secundario {
    border-color: rgb(37 89 127 / 23%);
