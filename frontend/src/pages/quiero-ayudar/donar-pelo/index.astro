---
import Layout from '../../../layouts/Layout.astro'

import Breadcrumbs from '../../../components/Common/Breadcrumbs.astro'

import TituloPag from '../../../components/Common/TituloPag.astro'
import Ubicacion from '../../../components/Common/Ubicacion.astro'
import NavegacionQuieroAyudar from '../../../components/QuieroAyudar/NavegacionQuieroAyudar.astro'

import SvgFlecha from '../../../assets/icon-common/icon-flecha.svg'
import SvgReloj from '../../../assets/icon-common/icon-reloj.svg'
import SvgUbicacion from '../../../assets/icon-common/icon-ubicacion.svg'
---

<Layout
  pag="Donar pelo"
  seoTitle="Donar pelo en Neuquén | Requisitos y entrega"
  description="Conocé los requisitos para donar cabello a Fundación SENO y colaborar con la confección artesanal de pelucas para pacientes oncológicos."
>
  <Breadcrumbs
    items={[
      {
        name: 'Inicio',
        href: '/'
      },
      {
        name: 'Quiero ayudar',
        href: '/quiero-ayudar'
      },
      {
        name: 'Donar pelo'
      }
    ]}
  />
  <NavegacionQuieroAyudar pag="4" />

  <TituloPag titulo="Donar pelo" />

  <main class="hair-donation-page">
    <section
      class="hair-donation-hero"
      aria-labelledby="hair-donation-hero-title"
    >
      <div class="hair-donation-hero__content">
        <p class="hair-donation-kicker">Donación de cabello</p>

        <h2 id="hair-donation-hero-title">
          Un pequeño gesto puede acompañar a alguien en uno de los momentos más
          difíciles de su vida
        </h2>

        <p>
          Cada donación de cabello nos permite confeccionar pelucas para
          pacientes oncológicos. Detrás de cada mechón hay una historia, un
          gesto solidario y la oportunidad de devolver una sonrisa.
        </p>

        <a
          class="hair-donation-button hair-donation-button--light"
          href="#requisitos"
        >
          <span>Conocer los requisitos</span>

          <SvgFlecha
            class="hair-donation-button__icon hair-donation-button__icon--down"
            aria-hidden="true"
          />
        </a>
      </div>
    </section>

    <section
      class="hair-donation-introduction"
      aria-labelledby="hair-donation-importance-title"
    >
      <p class="hair-donation-kicker">Un gesto con mucho significado</p>

      <h2 id="hair-donation-importance-title">¿Por qué donar cabello?</h2>

      <p>
        Sabemos que donar cabello es mucho más que un cambio de look. Muchas
        personas lo hacen en memoria de un ser querido, para cumplir una promesa
        o simplemente porque desean ayudar.
      </p>

      <p>
        Cada donación tiene un enorme valor para quienes atraviesan un
        tratamiento oncológico y puede convertirse en una peluca confeccionada
        de manera artesanal.
      </p>
    </section>

    <section
      id="requisitos"
      class="hair-donation-section hair-donation-requirements"
      aria-labelledby="hair-donation-requirements-title"
    >
      <header class="hair-donation-section__header">
        <p class="hair-donation-kicker">Antes de realizar el corte</p>

        <h2 id="hair-donation-requirements-title">¿Qué necesito para donar?</h2>

        <p>
          Prepará el cabello siguiendo estas indicaciones para que podamos
          utilizarlo correctamente en la confección de una peluca.
        </p>
      </header>

      <ul class="hair-donation-requirements__list">
        <li>
          <article class="hair-donation-requirement">
            <span class="hair-donation-requirement__icon" aria-hidden="true">
              ✂️
            </span>

            <h3>20 centímetros como mínimo</h3>

            <p>Recibimos cabello de al menos veinte centímetros de largo.</p>
          </article>
        </li>

        <li>
          <article class="hair-donation-requirement">
            <span class="hair-donation-requirement__icon" aria-hidden="true">
              🎀
            </span>

            <h3>Bien atado</h3>

            <p>Debe estar sujetado con una o más colitas antes de cortarlo.</p>
          </article>
        </li>

        <li>
          <article class="hair-donation-requirement">
            <span class="hair-donation-requirement__icon" aria-hidden="true">
              💇
            </span>

            <h3>Traerlo ya cortado</h3>

            <p>No contamos con peluqueras dentro de la institución.</p>
          </article>
        </li>

        <li>
          <article class="hair-donation-requirement">
            <span class="hair-donation-requirement__icon" aria-hidden="true">
              ❤️
            </span>

            <h3>Con ganas de ayudar</h3>

            <p>Cada donación representa una nueva oportunidad para alguien.</p>
          </article>
        </li>
      </ul>
    </section>

    <section
      class="hair-donation-section hair-donation-process"
      aria-labelledby="hair-donation-process-title"
    >
      <header class="hair-donation-section__header">
        <p class="hair-donation-kicker">Preparación y entrega</p>

        <h2 id="hair-donation-process-title">¿Cómo donar?</h2>

        <p>
          El proceso es sencillo. Solo necesitás preparar el cabello
          correctamente y acercarlo a nuestra sede.
        </p>
      </header>

      <ol class="hair-donation-process__steps">
        <li>
          <article class="hair-donation-step">
            <span class="hair-donation-step__number" aria-hidden="true">
              1
            </span>

            <div>
              <h3>Cortá tu cabello</h3>

              <p>
                Atalo antes del corte para mantener juntas todas las fibras.
              </p>
            </div>
          </article>
        </li>

        <li>
          <article class="hair-donation-step">
            <span class="hair-donation-step__number" aria-hidden="true">
              2
            </span>

            <div>
              <h3>Guardalo</h3>

              <p>Colocalo en una bolsa limpia para mantenerlo protegido.</p>
            </div>
          </article>
        </li>

        <li>
          <article class="hair-donation-step">
            <span class="hair-donation-step__number" aria-hidden="true">
              3
            </span>

            <div>
              <h3>Acercate a la Fundación</h3>

              <p>Recibimos donaciones de lunes a viernes, excepto feriados.</p>
            </div>
          </article>
        </li>

        <li>
          <article class="hair-donation-step">
            <span class="hair-donation-step__number" aria-hidden="true">
              4
            </span>

            <div>
              <h3>Nosotros hacemos el resto</h3>

              <p>
                Tu donación podrá convertirse en una peluca para quien la
                necesite.
              </p>
            </div>
          </article>
        </li>
      </ol>
    </section>

    <section
      class="hair-donation-location"
      aria-labelledby="hair-donation-location-title"
    >
      <div class="hair-donation-location__content">
        <p class="hair-donation-kicker">Entrega de donaciones</p>

        <h2 id="hair-donation-location-title">¿Dónde puedo donar?</h2>

        <p>
          Podés acercar el cabello directamente a nuestra sede dentro del
          horario de atención.
        </p>

        <address class="hair-donation-location__details">
          <div class="hair-donation-location__detail">
            <span class="hair-donation-location__icon" aria-hidden="true">
              <SvgUbicacion />
            </span>

            <div>
              <strong>Dirección</strong>
              <p>San Carlos 1330, Neuquén Capital</p>
            </div>
          </div>

          <div class="hair-donation-location__detail">
            <span class="hair-donation-location__icon" aria-hidden="true">
              <SvgReloj />
            </span>

            <div>
              <strong>Horario</strong>
              <p>Lunes a viernes de 10:00 a 14:00 h, excepto feriados.</p>
            </div>
          </div>
        </address>
      </div>

      <div class="hair-donation-location__map">
        <Ubicacion />
      </div>
    </section>

    <aside class="hair-donation-cta" aria-labelledby="hair-donation-cta-title">
      <div>
        <p class="hair-donation-kicker">Gracias por querer ayudar</p>

        <h2 id="hair-donation-cta-title">
          Tu cabello puede transformarse en acompañamiento
        </h2>

        <p>
          La donación puede convertirse en una peluca que acompañe a una persona
          durante su tratamiento.
        </p>
      </div>

      <a
        class="hair-donation-button hair-donation-cta__button"
        href="#contacto"
      >
        <span>Tengo una consulta</span>

        <SvgFlecha
          class="hair-donation-button__icon hair-donation-button__icon--down"
          aria-hidden="true"
        />
      </a>
    </aside>
  </main>
</Layout>

<style>
  .hair-donation-page {
    --hair-muted: #687680;
    --hair-border: #dce6ec;
    --hair-surface: #f5f9fb;

    width: min(calc(100% - 2rem), 75rem);
    margin: 2rem auto clamp(4rem, 10vw, 8rem);
  }

  .hair-donation-kicker {
    margin-bottom: 0.65rem;
    color: var(--color-primary-hover);
    font-size: 0.76rem;
    font-weight: 800;
    line-height: 1.4;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .hair-donation-section {
    padding-top: clamp(4.5rem, 10vw, 7rem);
  }

  .hair-donation-section__header {
    width: min(100%, 46rem);
    margin: 0 auto clamp(2.5rem, 6vw, 4rem);
    text-align: center;
  }

  .hair-donation-section__header h2 {
    color: var(--color-primary-hover);
    font-size: clamp(1.9rem, 4vw, 3rem);
    line-height: 1.15;
    text-wrap: balance;
  }

  .hair-donation-section__header > p:last-child {
    margin-top: 1rem;
    color: var(--hair-muted);
    font-size: 1.04rem;
    line-height: 1.7;
    text-wrap: pretty;
  }

  /* Hero */

  .hair-donation-hero {
    min-height: clamp(32rem, 72vh, 46rem);
    padding: clamp(2rem, 7vw, 5rem);
    position: relative;
    display: flex;
    align-items: center;
    overflow: hidden;
    background-color: var(--color-primary-hover);
    background-image:
      linear-gradient(
        110deg,
        rgba(37, 89, 127, 0.95) 0%,
        rgba(37, 89, 127, 0.83) 55%,
        rgba(37, 89, 127, 0.52) 100%
      ),
      url('/img/pelucas/donacion.avif');
    background-position: center;
    background-size: cover;
    border-radius: 0 0 2rem 2rem;
  }

  .hair-donation-hero__content {
    width: min(100%, 48rem);
    position: relative;
    z-index: 1;
    color: var(--color-background);
  }

  .hair-donation-hero .hair-donation-kicker {
    width: fit-content;
    padding: 0.55rem 1rem;
    color: var(--color-background);
    background-color: rgba(255, 255, 255, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.24);
    border-radius: 999px;
    backdrop-filter: blur(0.6rem);
  }

  .hair-donation-hero h2 {
    margin-top: 1.5rem;
    color: var(--color-background);
    font-size: clamp(2.4rem, 6vw, 4.8rem);
    line-height: 1.06;
    text-wrap: balance;
  }

  .hair-donation-hero__content > p:last-of-type {
    max-width: 44rem;
    margin-top: 1.5rem;
    color: rgba(255, 255, 255, 0.92);
    font-size: clamp(1rem, 2vw, 1.15rem);
    line-height: 1.85;
    text-wrap: pretty;
  }

  /* Buttons */

  .hair-donation-button {
    width: fit-content;
    min-height: 3.1rem;
    padding: 0.85rem 1.35rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    color: var(--color-background);
    background-color: var(--color-primary);
    border: 2px solid var(--color-primary);
    border-radius: 999px;
    font-weight: 700;
    line-height: 1.3;
    text-align: center;
    text-decoration: none;
    transition:
      color var(--transition),
      background-color var(--transition),
      border-color var(--transition),
      box-shadow var(--transition),
      transform var(--transition);
  }

  .hair-donation-button--light {
    margin-top: 1.75rem;
    color: var(--color-primary-hover);
    background-color: var(--color-background);
    border-color: var(--color-background);
  }

  .hair-donation-button__icon {
    width: 1.25rem;
    height: 1.25rem;
    flex: 0 0 auto;
    color: currentColor;
  }

  .hair-donation-button__icon--down {
    transform: rotate(90deg);
  }

  .hair-donation-button:focus-visible {
    outline: none;
    box-shadow: 0 0 0 3px var(--color-primary-light);
  }

  /* Introduction */

  .hair-donation-introduction {
    width: min(100%, 53rem);
    margin: clamp(4.5rem, 10vw, 7rem) auto 0;
    text-align: center;
  }

  .hair-donation-introduction h2 {
    color: var(--color-primary-hover);
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.2;
    text-wrap: balance;
  }

  .hair-donation-introduction h2::after {
    content: '';
    width: 5.5rem;
    height: 0.25rem;
    margin: 1rem auto 0;
    display: block;
    background-color: var(--color-primary);
    border-radius: 999px;
  }

  .hair-donation-introduction > p:not(.hair-donation-kicker) {
    margin-top: 1.25rem;
    color: var(--hair-muted);
    font-size: 1.06rem;
    line-height: 1.85;
    text-wrap: pretty;
  }

  /* Requirements */

  .hair-donation-requirements {
    scroll-margin-top: 2rem;
  }

  .hair-donation-requirements__list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    align-items: stretch;
    gap: 1.25rem;
  }

  .hair-donation-requirements__list > li {
    min-width: 0;
    display: flex;
  }

  .hair-donation-requirement {
    width: 100%;
    height: 100%;
    padding: clamp(1.4rem, 3vw, 2rem);
    background-color: var(--color-background);
    border: 1px solid var(--hair-border);
    border-radius: 1.5rem;
    box-shadow: var(--shadow);
    text-align: center;
    transition:
      border-color var(--transition),
      box-shadow var(--transition),
      transform var(--transition);
  }

  .hair-donation-requirement__icon {
    width: 5rem;
    height: 5rem;
    margin: 0 auto 1.5rem;
    display: grid;
    place-items: center;
    background-color: var(--color-primary-light);
    border-radius: 50%;
    font-size: 2rem;
    line-height: 1;
  }

  .hair-donation-requirement h3 {
    margin-bottom: 0.75rem;
    color: var(--color-primary-hover);
    font-size: 1.25rem;
    line-height: 1.3;
    text-wrap: balance;
  }

  .hair-donation-requirement p {
    color: var(--hair-muted);
    line-height: 1.7;
    text-wrap: pretty;
  }

  /* Process */

  .hair-donation-process__steps {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .hair-donation-process__steps::before {
    content: '';
    height: 0.25rem;
    position: absolute;
    top: 2.55rem;
    right: 10%;
    left: 10%;
    background-color: var(--color-light-grey);
    border-radius: 999px;
  }

  .hair-donation-process__steps > li {
    min-width: 0;
    position: relative;
    z-index: 1;
  }

  .hair-donation-step {
    text-align: center;
  }

  .hair-donation-step__number {
    width: 5.25rem;
    height: 5.25rem;
    margin: 0 auto 1.8rem;
    display: grid;
    place-items: center;
    color: var(--color-background);
    background-color: var(--color-primary);
    border: 0.4rem solid var(--color-background);
    border-radius: 50%;
    box-shadow: 0 0.75rem 2.2rem rgba(73, 107, 36, 0.25);
    font-size: 1.6rem;
    font-weight: 700;
    transition:
      background-color var(--transition),
      transform var(--transition);
  }

  .hair-donation-step h3 {
    margin-bottom: 0.75rem;
    color: var(--color-primary-hover);
    font-size: 1.25rem;
    line-height: 1.3;
  }

  .hair-donation-step p {
    max-width: 15rem;
    margin-inline: auto;
    color: var(--hair-muted);
    line-height: 1.7;
    text-wrap: pretty;
  }

  /* Location */

  .hair-donation-location {
    margin-top: clamp(5rem, 11vw, 8rem);
    padding: clamp(1.5rem, 5vw, 3rem);
    display: grid;
    grid-template-columns: minmax(18rem, 0.8fr) minmax(0, 1.2fr);
    align-items: stretch;
    gap: clamp(1.5rem, 5vw, 3rem);
    background-color: var(--hair-surface);
    border: 1px solid var(--hair-border);
    border-radius: 2rem;
  }

  .hair-donation-location__content {
    min-width: 0;
    align-self: center;
  }

  .hair-donation-location h2 {
    color: var(--color-primary-hover);
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    line-height: 1.2;
    text-wrap: balance;
  }

  .hair-donation-location__content > p:not(.hair-donation-kicker) {
    margin-top: 1rem;
    color: var(--hair-muted);
    line-height: 1.7;
    text-wrap: pretty;
  }

  .hair-donation-location__details {
    margin-top: 1.75rem;
    display: grid;
    gap: 1rem;
    font-style: normal;
  }

  .hair-donation-location__detail {
    padding: 1rem;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 1rem;
    background-color: var(--color-background);
    border: 1px solid var(--color-primary-light);
    border-radius: var(--radius);
  }

  .hair-donation-location__icon {
    width: 3rem;
    height: 3rem;
    display: grid;
    place-items: center;
    color: var(--color-background);
    background-color: var(--color-primary-hover);
    border-radius: var(--radius-small);
  }

  .hair-donation-location__icon :global(svg) {
    width: 1.6rem;
    height: 1.6rem;
  }

  .hair-donation-location__detail strong {
    color: var(--color-primary-hover);
    font-size: 0.82rem;
    line-height: 1.3;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .hair-donation-location__detail p {
    margin-top: 0.2rem;
    color: var(--color-text);
    line-height: 1.55;
  }

  .hair-donation-location__map {
    min-width: 0;
    display: flex;
  }

  .hair-donation-location__map :global(.location-map) {
    width: 100%;
    max-width: none;
    height: 100%;
    margin: 0;
  }

  .hair-donation-location__map :global(.location-map__iframe) {
    min-height: 27rem;
    height: 100%;
    aspect-ratio: auto;
  }

  /* CTA */

  .hair-donation-cta {
    margin-top: clamp(4.5rem, 10vw, 7rem);
    padding: clamp(2rem, 6vw, 4rem);
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    overflow: hidden;
    color: var(--color-background);
    background:
      radial-gradient(
        circle at 95% 0,
        rgba(255, 255, 255, 0.1),
        transparent 30%
      ),
      var(--color-primary-hover);
    border-radius: 2rem;
  }

  .hair-donation-cta > div {
    max-width: 46rem;
    position: relative;
    z-index: 1;
  }

  .hair-donation-cta .hair-donation-kicker {
    color: rgba(255, 255, 255, 0.7);
  }

  .hair-donation-cta h2 {
    color: var(--color-background);
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    line-height: 1.2;
    text-wrap: balance;
  }

  .hair-donation-cta p:last-child {
    margin-top: 0.9rem;
    color: rgba(255, 255, 255, 0.82);
    line-height: 1.75;
    text-wrap: pretty;
  }

  .hair-donation-cta__button {
    flex: 0 0 auto;
    color: var(--color-primary-hover);
    background-color: var(--color-background);
    border-color: var(--color-background);
  }

  @media (hover: hover) {
    .hair-donation-button:hover {
      box-shadow: 0 1rem 2rem rgba(0, 0, 0, 0.17);
      transform: translateY(-3px);
    }

    .hair-donation-button--light:hover,
    .hair-donation-cta__button:hover {
      color: var(--color-background);
      background-color: transparent;
    }

    .hair-donation-requirement:hover {
      border-color: var(--color-primary-light);
      box-shadow: 0 1.3rem 3rem rgba(0, 0, 0, 0.12);
      transform: translateY(-6px);
    }

    .hair-donation-step:hover .hair-donation-step__number {
      background-color: var(--color-primary-hover);
      transform: scale(1.08);
    }
  }

  @media (max-width: 950px) {
    .hair-donation-requirements__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .hair-donation-process__steps {
      grid-template-columns: minmax(0, 1fr);
      gap: 3rem;
    }

    .hair-donation-process__steps::before {
      width: 0.25rem;
      height: auto;
      top: 0;
      right: auto;
      bottom: 0;
      left: 2.45rem;
    }

    .hair-donation-step {
      display: grid;
      grid-template-columns: 5.5rem minmax(0, 1fr);
      align-items: start;
      gap: 0.3rem 1.5rem;
      text-align: left;
    }

    .hair-donation-step__number {
      margin: 0;
      grid-row: 1 / 3;
    }

    .hair-donation-step h3 {
      margin-top: 0.6rem;
      margin-bottom: 0.35rem;
    }

    .hair-donation-step p {
      max-width: none;
      margin: 0;
    }

    .hair-donation-location {
      grid-template-columns: minmax(0, 1fr);
    }

    .hair-donation-cta {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (max-width: 600px) {
    .hair-donation-page {
      width: calc(100% - 1rem);
      margin-top: 1rem;
    }

    .hair-donation-hero {
      min-height: 34rem;
      padding: 2rem 1.25rem;
      border-radius: 0 0 1.5rem 1.5rem;
    }

    .hair-donation-hero h2 {
      font-size: clamp(2.1rem, 11vw, 3rem);
    }

    .hair-donation-requirements__list {
      grid-template-columns: minmax(0, 1fr);
    }

    .hair-donation-requirement {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
