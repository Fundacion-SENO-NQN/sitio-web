---
import Layout from '../../../layouts/Layout.astro'

import TituloPag from '../../../components/Common/TituloPag.astro'
import NavegacionQuieroAyudar from '../../../components/QuieroAyudar/NavegacionQuieroAyudar.astro'

import SvgJuguete from '../../../assets/icon-donar-cosas/icon-juguete.svg'
import SvgRopa from '../../../assets/icon-donar-cosas/icon-ropa.svg'
import SvgComida from '../../../assets/icon-donar-cosas/icon-comida.svg'
import SvgCorazon from '../../../assets/icon-common/icon-corazon.svg'
import SvgCheck from '../../../assets/icon-donar-cosas/icon-check.svg'
import SvgMueble from '../../../assets/icon-donar-cosas/icon-mueble.svg'
import SvgComputadora from '../../../assets/icon-donar-cosas/icon-computadora.svg'
import SvgCaja from '../../../assets/icon-quiero-ayudar/icon-caja.svg'
import SvgCruz from '../../../assets/icon-donar-cosas/icon-cruz.svg'
import SvgCuidado from '../../../assets/icon-donar-cosas/icon-cuidado.svg'
import SvgRecibir from '../../../assets/icon-donar-cosas/icon-recibir.svg'
import SvgOrdenar from '../../../assets/icon-donar-cosas/icon-ordenar.svg'
import SvgPersonas from '../../../assets/icon-donar-cosas/icon-personas.svg'
import SvgUser from '../../../assets/icon-common/icon-user.svg'
---

<Layout pag="Donar cosas">
  <NavegacionQuieroAyudar pag="3" />
  <TituloPag titulo="Donar cosas" />

  <main class="donaciones-materiales">
    <section class="hero">
      <div class="hero__contenido">
        <span class="etiqueta">Donaciones materiales</span>

        <h1>Todo puede tener una segunda oportunidad</h1>

        <p class="hero__introduccion">
          En Fundación SENO recibimos una gran variedad de objetos. Siempre
          intentamos encontrarles una utilidad: entregarlos a una familia,
          utilizarlos en la Fundación, acercarlos a un merendero o destinarlos a
          actividades solidarias.
        </p>

        <p>
          La Fundación se sostiene gracias a la colaboración de la comunidad.
          Muchos de los elementos que utilizamos diariamente, incluyendo
          nuestras computadoras, fueron donados por distintas personas.
        </p>

        <a class="boton-principal" href="#que-puedo-donar">
          Ver qué puedo donar

          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 5v14"></path>
            <path d="m6 13 6 6 6-6"></path>
          </svg>
        </a>
      </div>

      <div class="hero__visual" aria-hidden="true">
        <div class="caja-donacion">
          <div class="caja-donacion__objetos">
            <span class="objeto objeto--ropa">
              <SvgRopa />
            </span>

            <span class="objeto objeto--juguete">
              <SvgJuguete />
            </span>

            <span class="objeto objeto--alimento">
              <SvgComida />
            </span>
          </div>

          <div class="caja-donacion__frente">
            <SvgCorazon />

            <strong>Tu ayuda se transforma</strong>
          </div>
        </div>

        <span class="decoracion decoracion--uno"></span>
        <span class="decoracion decoracion--dos"></span>
        <span class="decoracion decoracion--tres"></span>
      </div>
    </section>

    <section class="condicion-principal" aria-labelledby="antes-de-donar">
      <div class="condicion-principal__icono" aria-hidden="true">
        <SvgCheck />
      </div>

      <div>
        <span class="etiqueta">Antes de acercar tu donación</span>

        <h2 id="antes-de-donar">Los objetos deben estar en un estado digno</h2>

        <p>
          No es necesario que sean nuevos, pero sí deben encontrarse en
          condiciones decentes, limpios y suficientemente conservados como para
          que otra persona pueda utilizarlos.
        </p>

        <p>
          Por ejemplo, la ropa no debe estar agujereada y los objetos no deben
          encontrarse destruidos o representar un riesgo para quien los reciba.
        </p>
      </div>
    </section>

    <section
      id="que-puedo-donar"
      class="categorias"
      aria-labelledby="titulo-categorias"
    >
      <header class="encabezado-seccion">
        <span class="etiqueta">Hay muchas formas de colaborar</span>
        <h2 id="titulo-categorias">¿Qué cosas puedes donar?</h2>

        <p>
          Recibimos distintos tipos de elementos y evaluamos cuál es la mejor
          manera de aprovechar cada donación.
        </p>
      </header>

      <div class="categorias__grid">
        <article class="categoria categoria--juguetes">
          <div class="categoria__icono" aria-hidden="true">
            <SvgJuguete />
          </div>

          <h3>Juguetes</h3>

          <p>
            Juguetes, juegos, muñecos, libros infantiles y otros elementos que
            puedan disfrutar niños y adolescentes.
          </p>

          <span class="categoria__detalle">
            Deben estar completos y ser seguros para su uso.
          </span>
        </article>

        <article class="categoria categoria--ropa">
          <div class="categoria__icono" aria-hidden="true">
            <SvgRopa />
          </div>

          <h3>Ropa y calzado</h3>

          <p>
            Prendas para todas las edades, abrigos, calzado y accesorios que
            puedan ser utilizados nuevamente.
          </p>

          <span class="categoria__detalle">
            La ropa debe estar limpia y sin agujeros.
          </span>
        </article>

        <article class="categoria categoria--hogar">
          <div class="categoria__icono" aria-hidden="true">
            <SvgMueble />
          </div>

          <h3>Muebles y hogar</h3>

          <p>
            Muebles, colchones, sábanas, frazadas, utensilios y otros objetos
            útiles para una vivienda.
          </p>

          <span class="categoria__detalle">
            Deben estar en condiciones de uso y no estar destruidos.
          </span>
        </article>

        <article class="categoria categoria--alimentos">
          <div class="categoria__icono" aria-hidden="true">
            <SvgComida />
          </div>

          <h3>Alimentos</h3>

          <p>
            Alimentos que podamos utilizar en la Fundación o acercar a los
            distintos merenderos con los que colaboramos.
          </p>

          <span class="categoria__detalle">
            Pueden estar próximos a vencer, pero deben ser seguros.
          </span>
        </article>

        <article class="categoria categoria--tecnologia">
          <div class="categoria__icono" aria-hidden="true">
            <SvgComputadora />
          </div>

          <h3>Tecnología</h3>

          <p>
            Computadoras, monitores, periféricos y otros equipos que puedan
            utilizarse para las actividades de la Fundación.
          </p>

          <span class="categoria__detalle">
            Nuestras computadoras actuales también fueron donadas.
          </span>
        </article>

        <article class="categoria categoria--otros">
          <div class="categoria__icono" aria-hidden="true">
            <SvgCaja />
          </div>

          <h3>Otros objetos</h3>

          <p>
            También puedes acercarnos otros elementos que no aparezcan en esta
            lista. Siempre intentamos encontrarles una utilidad.
          </p>

          <span class="categoria__detalle">
            Puedes consultarnos antes de trasladar objetos grandes.
          </span>
        </article>
      </div>
    </section>

    <section class="estado" aria-labelledby="titulo-estado">
      <header class="encabezado-seccion">
        <span class="etiqueta">Una ayuda segura y responsable</span>
        <h2 id="titulo-estado">¿En qué condiciones deben estar?</h2>

        <p>
          Antes de donar, pensá si el objeto podría ser utilizado con dignidad
          y seguridad por otra persona.
        </p>
      </header>

      <div class="estado__columnas">
        <article class="lista-estado lista-estado--aceptado">
          <div class="lista-estado__encabezado">
            <span class="lista-estado__icono" aria-hidden="true">
              <SvgCheck />
            </span>

            <h3>Podemos recibir</h3>
          </div>

          <ul>
            <li>
              Objetos usados que todavía se encuentren en buenas condiciones.
            </li>
            <li>Ropa limpia, sin agujeros y que pueda volver a utilizarse.</li>
            <li>Juguetes completos y sin partes peligrosas.</li>
            <li>Muebles, colchones y elementos del hogar utilizables.</li>
            <li>
              Alimentos próximos a vencer que todavía sean seguros para el
              consumo.
            </li>
          </ul>
        </article>

        <article class="lista-estado lista-estado--rechazado">
          <div class="lista-estado__encabezado">
            <span class="lista-estado__icono" aria-hidden="true">
              <SvgCruz />
            </span>

            <h3>No podemos recibir</h3>
          </div>

          <ul>
            <li>Objetos destruidos o que ya no puedan utilizarse.</li>
            <li>Ropa agujereada, muy deteriorada o en malas condiciones.</li>
            <li>
              Elementos que puedan provocar cortes, golpes u otros riesgos.
            </li>
            <li>
              Alimentos en mal estado, contaminados o que puedan resultar
              tóxicos.
            </li>
            <li>
              Cualquier producto que pueda ocasionar una intoxicación o poner en
              peligro a otra persona.
            </li>
          </ul>
        </article>
      </div>
    </section>

    <section class="alimentos" aria-labelledby="titulo-alimentos">
      <div class="alimentos__icono" aria-hidden="true">
        <SvgComida />
      </div>

      <div class="alimentos__contenido">
        <span class="etiqueta">Donación de alimentos</span>
        <h2 id="titulo-alimentos">También colaboramos con merenderos</h2>

        <p>
          Trabajamos junto a distintos merenderos donde los alimentos donados
          pueden ser de mucha utilidad. Por eso, también podemos recibir
          productos que estén próximos a su fecha de vencimiento, siempre que
          todavía sean aptos y seguros para el consumo.
        </p>

        <div class="alimentos__advertencia">
          <SvgCuidado />

          <p>
            No traigas alimentos en mal estado, contaminados, tóxicos o que
            puedan causar una intoxicación.
          </p>
        </div>
      </div>
    </section>

    <section class="destinos" aria-labelledby="titulo-destinos">
      <header class="encabezado-seccion">
        <span class="etiqueta">Cada donación encuentra un destino</span>
        <h2 id="titulo-destinos">¿Qué hacemos con las cosas donadas?</h2>

        <p>
          Buscamos la manera más útil y responsable de aprovechar cada elemento
          que llega a la Fundación.
        </p>
      </header>

      <div class="destinos__recorrido">
        <article class="destino">
          <span class="destino__numero">1</span>

          <div class="destino__icono" aria-hidden="true">
            <SvgRecibir />
          </div>

          <h3>Recibimos</h3>

          <p>
            Revisamos el tipo de objeto y las condiciones en las que se
            encuentra.
          </p>
        </article>

        <article class="destino">
          <span class="destino__numero">2</span>

          <div class="destino__icono" aria-hidden="true">
            <SvgOrdenar />
          </div>

          <h3>Clasificamos</h3>

          <p>
            Determinamos dónde puede ser más útil según las necesidades del
            momento.
          </p>
        </article>

        <article class="destino">
          <span class="destino__numero">3</span>

          <div class="destino__icono" aria-hidden="true">
            <SvgCorazon />
          </div>

          <h3>Asignamos un destino</h3>

          <p>
            Puede utilizarse en la Fundación, entregarse o destinarse a una
            actividad solidaria.
          </p>
        </article>

        <article class="destino">
          <span class="destino__numero">4</span>

          <div class="destino__icono" aria-hidden="true">
            <SvgPersonas />
          </div>

          <h3>Ayudamos</h3>

          <p>
            La donación se transforma en una ayuda concreta para otras personas.
          </p>
        </article>
      </div>
    </section>

    <section class="usos-especiales">
      <article class="uso uso--ropa">
        <div class="uso__icono" aria-hidden="true">
          <SvgRopa />
        </div>

        <div>
          <span class="etiqueta">Ropa donada</span>
          <h2>Una prenda puede ayudar de distintas maneras</h2>

          <p>
            Algunas prendas se entregan directamente a familias que las
            necesitan. Otras pueden destinarse a ferias solidarias para recaudar
            fondos que permitan sostener las actividades de la Fundación.
          </p>
        </div>
      </article>

      <article class="uso uso--juguetes">
        <div class="uso__icono" aria-hidden="true">
          <SvgJuguete />
        </div>

        <div>
          <span class="etiqueta">Juguetes donados</span>
          <h2>Un juguete también puede crear un momento especial</h2>

          <p>
            Los juguetes pueden entregarse a familias de bajos recursos o
            distribuirse gratuitamente durante eventos y celebraciones, como las
            actividades por el Día del Niño.
          </p>
        </div>
      </article>
    </section>

    <section class="impacto">
      <div class="impacto__contenido">
        <span class="etiqueta">El valor de cada aporte</span>

        <h2>Las donaciones también sostienen a la Fundación</h2>

        <p>
          No todas las cosas donadas se entregan directamente. Algunos elementos
          son necesarios para que la Fundación pueda seguir trabajando y
          acompañando a más familias.
        </p>

        <blockquote>
          “Las computadoras que utilizamos en la Fundación fueron donadas por
          distintas personas.”
        </blockquote>

        <p>
          Cada mueble, equipo, alimento, prenda o juguete puede convertirse en
          una herramienta para ayudar.
        </p>
      </div>

      <div class="impacto__ilustracion" aria-hidden="true">
        <span class="impacto__corazon">
          <SvgCorazon />
        </span>

        <span class="impacto__linea"></span>

        <div class="impacto__personas">
          <span>
            <SvgUser />
          </span>

          <span>
            <SvgUser />
          </span>

          <span>
            <SvgUser />
          </span>
        </div>
      </div>
    </section>

    <aside class="contacto">
      <div class="contacto__contenido">
        <span class="etiqueta">Antes de acercarte</span>
        <h2>¿Querés donar algo y no sabes si podemos recibirlo?</h2>

        <p>
          Hablanos para consultar por el objeto, coordinar la
          entrega o informarnos si se trata de algo grande que requiere
          traslado.
        </p>
      </div>

      <a class="contacto__boton" href="/contacto">
        Consultar

        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M5 12h14"></path>
          <path d="m13 6 6 6-6 6"></path>
        </svg>
      </a>
    </aside>
  </main>
</Layout>

<style>
  .donaciones-materiales {
    --donar-primary: var(--color-primary, #3c74a8);
    --donar-primary-dark: var(--color-primary-hover, #245779);
    --donar-secondary: var(--color-secondary, #d65f8d);
    --donar-text: var(--color-text, #27333d);
    --donar-muted: #687680;
    --donar-border: #dce6ec;
    --donar-background: #f6f9fb;
    --donar-success: #2f8061;
    --donar-success-background: #eff9f4;
    --donar-danger: #ae4747;
    --donar-danger-background: #fff3f2;
    --donar-warning: #9a6826;
    --donar-warning-background: #fff8e8;

    width: min(1180px, calc(100% - 2rem));
    margin: 2rem auto 5rem;
    color: var(--donar-text);
    font-family: var(--text-font-primary, system-ui, sans-serif);
  }

  .etiqueta {
    display: block;
    margin-bottom: 0.65rem;
    color: var(--donar-primary-dark);
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(280px, 0.7fr);
    align-items: center;
    gap: clamp(2rem, 7vw, 6rem);
    min-height: 470px;
    padding: clamp(2rem, 6vw, 5rem);
    overflow: hidden;
    border: 1px solid var(--donar-border);
    border-radius: 2rem;
    background:
      radial-gradient(
        circle at 87% 17%,
        rgb(214 95 141 / 17%),
        transparent 27%
      ),
      radial-gradient(
        circle at 12% 90%,
        rgb(60 116 168 / 11%),
        transparent 27%
      ),
      linear-gradient(135deg, #fbfdfe 0%, #edf5fa 100%);
  }

  .hero::before {
    position: absolute;
    right: -120px;
    bottom: -130px;
    width: 350px;
    aspect-ratio: 1;
    border: 50px solid rgb(60 116 168 / 6%);
    border-radius: 50%;
    content: '';
  }

  .hero__contenido,
  .hero__visual {
    position: relative;
    z-index: 1;
  }

  .hero h1 {
    max-width: 750px;
    margin: 0 0 1.3rem;
    color: var(--donar-primary-dark);
    font-size: clamp(2.2rem, 5.2vw, 4.35rem);
    line-height: 1.03;
    text-wrap: balance;
  }

  .hero p {
    max-width: 720px;
    margin: 0.8rem 0;
    color: var(--donar-muted);
    font-size: 1.02rem;
    line-height: 1.75;
  }

  .hero .hero__introduccion {
    color: var(--donar-text);
    font-size: clamp(1.05rem, 1.8vw, 1.2rem);
  }

  .boton-principal,
  .contacto__boton {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    min-height: 49px;
    padding: 0.85rem 1.25rem;
    border-radius: 999px;
    font-weight: 800;
    text-align: center;
    text-decoration: none;
    transition:
      transform 180ms ease,
      background-color 180ms ease,
      color 180ms ease,
      box-shadow 180ms ease;
  }

  .boton-principal {
    margin-top: 1.4rem;
    background: var(--donar-primary-dark);
    color: #fff;
    box-shadow: 0 12px 28px rgb(36 87 121 / 20%);
  }

  .boton-principal svg,
  .contacto__boton svg {
    width: 20px;
    flex-shrink: 0;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
  }

  .hero__visual {
    display: grid;
    place-items: center;
    min-height: 300px;
  }

  .caja-donacion {
    position: relative;
    width: min(100%, 310px);
    padding-top: 95px;
  }

  .caja-donacion__objetos {
    position: absolute;
    top: 0;
    left: 50%;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 0.7rem;
    width: 90%;
    transform: translateX(-50%);
  }

  .objeto {
    display: grid;
    place-items: center;
    width: 72px;
    aspect-ratio: 1;
    border: 7px solid #fff;
    border-radius: 50%;
    box-shadow: 0 12px 25px rgb(36 87 121 / 14%);
  }

  .objeto svg {
    width: 36px;
  }

  .objeto--ropa {
    background: #fceaf1;
    color: #b64872;
    transform: rotate(-8deg);
  }

  .objeto--juguete {
    width: 82px;
    background: #e9f3fa;
    color: var(--donar-primary);
    transform: translateY(-17px);
  }

  .objeto--alimento {
    background: #fff4d8;
    color: #a16b1e;
    transform: rotate(8deg);
  }

  .caja-donacion__frente {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    min-height: 190px;
    padding: 2rem;
    border-radius: 1.2rem 1.2rem 1.7rem 1.7rem;
    background: var(--donar-primary);
    color: #fff;
    box-shadow: 0 30px 60px rgb(36 87 121 / 24%);
    clip-path: polygon(5% 0, 95% 0, 100% 100%, 0 100%);
  }

  .caja-donacion__frente::before {
    position: absolute;
    top: 0;
    left: 5%;
    width: 90%;
    height: 17px;
    border-radius: 0 0 50% 50%;
    background: rgb(0 0 0 / 10%);
    content: '';
  }

  .caja-donacion__frente svg {
    width: 66px;
  }

  .caja-donacion__frente strong {
    font-size: 1.05rem;
    text-align: center;
  }

  .decoracion {
    position: absolute;
    display: block;
    border-radius: 50%;
  }

  .decoracion--uno {
    top: 5%;
    right: 5%;
    width: 23px;
    aspect-ratio: 1;
    background: rgb(214 95 141 / 38%);
  }

  .decoracion--dos {
    bottom: 12%;
    left: 0;
    width: 15px;
    aspect-ratio: 1;
    background: rgb(60 116 168 / 38%);
  }

  .decoracion--tres {
    top: 35%;
    left: -4%;
    width: 37px;
    aspect-ratio: 1;
    border: 8px solid rgb(60 116 168 / 18%);
  }

  .condicion-principal {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1.5rem;
    margin-top: 2rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border-left: 6px solid var(--donar-success);
    border-radius: 0.35rem 1.5rem 1.5rem 0.35rem;
    background: var(--donar-success-background);
  }

  .condicion-principal__icono {
    display: grid;
    place-items: center;
    width: 58px;
    height: 58px;
    border-radius: 50%;
    background: #fff;
    color: var(--donar-success);
    box-shadow: 0 10px 25px rgb(47 128 97 / 12%);
  }

  .condicion-principal__icono svg {
    width: 29px;
  }

  .condicion-principal h2,
  .alimentos h2,
  .uso h2,
  .impacto h2,
  .contacto h2 {
    margin: 0 0 0.8rem;
    color: var(--donar-primary-dark);
    font-size: clamp(1.4rem, 3vw, 2rem);
    line-height: 1.2;
    text-wrap: balance;
  }

  .condicion-principal p {
    max-width: 920px;
    margin: 0.45rem 0;
    color: #50675e;
    line-height: 1.7;
  }

  .categorias,
  .estado,
  .destinos {
    padding-top: clamp(4.5rem, 10vw, 7.5rem);
    scroll-margin-top: 2rem;
  }

  .encabezado-seccion {
    max-width: 720px;
    margin: 0 auto clamp(2.2rem, 5vw, 3.5rem);
    text-align: center;
  }

  .encabezado-seccion h2 {
    margin: 0;
    color: var(--donar-primary-dark);
    font-size: clamp(1.9rem, 4vw, 2.8rem);
    line-height: 1.15;
