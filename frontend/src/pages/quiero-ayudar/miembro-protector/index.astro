---
import Layout from '../../../layouts/Layout.astro'

import TituloPag from '../../../components/Common/TituloPag.astro'
import NavegacionQuieroAyudar from '../../../components/QuieroAyudar/NavegacionQuieroAyudar.astro'

import SvgMonedas from '../../../assets/icon-miembro-protector/icon-monedas.svg'
import SvgCalendario from '../../../assets/icon-noticias/icon-calendario.svg'
import SvgCasa from '../../../assets/icon-voluntariado/icon-casa.svg'
import SvgFlecha from '../../../assets/icon-common/icon-flecha.svg'
import SvgCorazon from '../../../assets/icon-common/icon-corazon.svg'
import SvgUsuario from '../../../assets/icon-common/icon-user.svg'
import SvgUsuarios from '../../../assets/icon-donar-cosas/icon-personas.svg'
import SvgCheck from '../../../assets/icon-donar-cosas/icon-check.svg'
import SvgMental from '../../../assets/icon-mision/icon-mental.svg'
import SvgDinero from '../../../assets/icon-quiero-ayudar/icon-dinero.svg'
import SvgEstrella from '../../../assets/icon-common/icon-estrella.svg'
---

<Layout pag="Miembro protector">
  <NavegacionQuieroAyudar pag="5" />
  <TituloPag titulo="Miembro protector" />

  <main class="miembro-protector">
    <section class="hero" aria-labelledby="titulo-miembro-protector">
      <div class="hero__contenido">
        <span class="etiqueta">Campaña Miembro Protector</span>

        <h1 id="titulo-miembro-protector">
          Acompañá nuestra misión todos los meses
        </h1>

        <p class="hero__destacado">
          Ser miembro protector es una manera de colaborar de forma continua con
          Fundación SENO y ayudarnos a construir un espacio cada vez más digno
          para las familias.
        </p>

        <p>
          Cada persona puede elegir el valor de su aporte mensual. No importa el
          monto: la continuidad de esa ayuda nos permite seguir avanzando,
          sostener nuestras actividades y acompañar a quienes necesitan de la
          Fundación.
        </p>

        <div class="hero__acciones">
          <a class="boton boton--principal" href="#contacto">
            Quiero conocer más

            <SvgFlecha />
          </a>

          <a class="boton boton--secundario" href="#como-funciona">
            Cómo funciona
          </a>
        </div>
      </div>

      <div class="hero__visual" aria-hidden="true">
        <div class="ilustracion">
          <span class="ilustracion__corazon">
            <SvgCorazon />
          </span>

          <span class="ilustracion__casa">
            <SvgCasa />
          </span>

          <div class="ilustracion__personas">
            <span>
              <SvgUsuario />
            </span>

            <span>
              <SvgUsuario />
            </span>

            <span>
              <SvgUsuario />
            </span>
          </div>

          <span class="decoracion decoracion--uno"></span>
          <span class="decoracion decoracion--dos"></span>
          <span class="decoracion decoracion--tres"></span>
        </div>
      </div>
    </section>

    <section class="mensaje-principal" aria-labelledby="una-ayuda-constante">
      <div class="mensaje-principal__icono" aria-hidden="true">
        <SvgCorazon />
      </div>

      <div>
        <span class="etiqueta">Una colaboración que nos acompaña</span>

        <h2 id="una-ayuda-constante">
          Los aportes mensuales nos permiten seguir adelante
        </h2>

        <p>
          La Fundación se sostiene gracias al compromiso y la solidaridad de la
          comunidad. Contar con aportes regulares nos ayuda a planificar,
          mantener nuestro espacio y continuar desarrollando acciones para las
          familias.
        </p>
      </div>
    </section>

    <section
      id="como-funciona"
      class="funcionamiento"
      aria-labelledby="titulo-funcionamiento"
    >
      <header class="encabezado-seccion">
        <span class="etiqueta">Una forma sencilla de colaborar</span>

        <h2 id="titulo-funcionamiento">¿Cómo funciona la campaña?</h2>

        <p>
          Cada miembro protector elige libremente el valor de su aporte y
          acompaña mensualmente el trabajo de Fundación SENO.
        </p>
      </header>

      <div class="funcionamiento__grid">
        <article class="paso">
          <span class="paso__numero">1</span>

          <div class="paso__icono" aria-hidden="true">
            <SvgMonedas />
          </div>

          <h3>Eliges tu aporte</h3>

          <p>
            Cada persona puede seleccionar el valor mensual con el que desea
            colaborar, según sus posibilidades.
          </p>
        </article>

        <article class="paso">
          <span class="paso__numero">2</span>

          <div class="paso__icono" aria-hidden="true">
            <SvgCalendario />
          </div>

          <h3>Colaboras mensualmente</h3>

          <p>
            El aporte periódico nos brinda una base constante para sostener
            nuestros proyectos y necesidades.
          </p>
        </article>

        <article class="paso">
          <span class="paso__numero">3</span>

          <div class="paso__icono" aria-hidden="true">
            <SvgCasa />
          </div>

          <h3>Ayudas a la Fundación</h3>

          <p>
            Tu colaboración puede convertirse en mejoras para la casa, nuevas
            actividades o acciones que permitan seguir recaudando fondos.
          </p>
        </article>

        <article class="paso">
          <span class="paso__numero">4</span>

          <div class="paso__icono" aria-hidden="true">
            <SvgUsuarios />
          </div>

          <h3>Formas parte de la misión</h3>

          <p>
            Los miembros protectores son parte del crecimiento de Fundación SENO
            y del acompañamiento que brindamos a las familias.
          </p>
        </article>
      </div>
    </section>

    <section class="aporte" aria-labelledby="titulo-aporte">
      <div class="aporte__contenido">
        <span class="etiqueta">Vos eligís cómo colaborar</span>

        <h2 id="titulo-aporte">
          No existe un único valor para ser miembro protector
        </h2>

        <p>
          La campaña contempla diferentes valores de aportes mensuales. Cada
          persona puede elegir la opción que mejor se adapte a sus
          posibilidades.
        </p>

        <p>
          Lo más importante no es el tamaño de la cuota, sino el compromiso de
          acompañar el trabajo de la Fundación y ayudarnos a continuar.
        </p>

        <div class="aporte__destacado">
          <SvgCheck />

          <p>
            Cada aporte, sin importar su valor, se suma a muchos otros y se
            transforma en una ayuda concreta.
          </p>
        </div>
      </div>

      <div class="aporte__visual" aria-hidden="true">
        <span class="aporte__moneda aporte__moneda--uno">
          <SvgMonedas />
        </span>

        <span class="aporte__moneda aporte__moneda--dos">
          <SvgMental />
        </span>

        <span class="aporte__corazon">
          <SvgCorazon />
        </span>
      </div>
    </section>

    <section class="destinos" aria-labelledby="titulo-destinos">
      <header class="encabezado-seccion">
        <span class="etiqueta">Un fondo para seguir creciendo</span>

        <h2 id="titulo-destinos">¿En qué se utilizan los aportes?</h2>

        <p>
          Los fondos de la campaña no tienen un único destino fijo. Se
          administran según las necesidades y proyectos de la Fundación.
        </p>
      </header>

      <div class="destinos__grid">
        <article class="destino">
          <div class="destino__icono" aria-hidden="true">
            <SvgCasa />
          </div>

          <h3>Mejorar la vivienda</h3>

          <p>
            Realizar arreglos, mantenimiento y mejoras que permitan ofrecer un
            espacio más cómodo y digno para las familias.
          </p>
        </article>

        <article class="destino">
          <div class="destino__icono" aria-hidden="true">
            <SvgEstrella />
          </div>

          <h3>Continuar la obra</h3>

          <p>
            Avanzar en las diferentes etapas de construcción y adecuación de los
            espacios de la Fundación.
          </p>
        </article>

        <article class="destino">
          <div class="destino__icono" aria-hidden="true">
            <SvgCalendario />
          </div>

          <h3>Organizar actividades</h3>

          <p>
            Acompañar eventos, encuentros y acciones que beneficien a las
            familias y a la comunidad.
          </p>
        </article>

        <article class="destino">
          <div class="destino__icono" aria-hidden="true">
            <SvgDinero />
          </div>

          <h3>Generar nuevos fondos</h3>

          <p>
            Impulsar iniciativas que permitan recaudar más recursos y sostener
            futuros proyectos.
          </p>
        </article>
      </div>
    </section>

    <section class="impacto" aria-labelledby="titulo-impacto">
      <span class="impacto__comillas" aria-hidden="true">“</span>

      <div>
        <span class="etiqueta">El valor de acompañar</span>

        <blockquote id="titulo-impacto">
          Cada miembro protector nos ayuda a seguir construyendo una Fundación
          más fuerte y un espacio más digno para las familias.
        </blockquote>

        <p>
          La continuidad de cada aporte nos permite mirar hacia adelante,
          planificar nuevas acciones y sostener todo lo que construimos junto a
          la comunidad.
        </p>
      </div>
    </section>

    <aside class="llamada">
      <div class="llamada__contenido">
        <span class="etiqueta">Campaña Miembro Protector</span>

        <h2>Tu acompañamiento puede ayudarnos todos los meses</h2>

        <p>
          Comunícate con nosotros para conocer los valores disponibles y
          cómo sumarte a la campaña.
        </p>
      </div>

      <a class="llamada__boton btn-flecha-der" href="#contacto">
        Comunicarme con la Fundación

        <SvgFlecha />
      </a>
    </aside>
  </main>
</Layout>

<style>
  .miembro-protector {
    --member-primary: var(--color-primary, #4178aa);
    --member-primary-dark: var(--color-primary-hover, #25597f);
    --member-secondary: var(--color-secondary, #d45d8c);
    --member-text: var(--color-text, #28343e);
    --member-muted: #667580;
    --member-border: #dce6ed;
    --member-background: #f5f9fb;
    --member-success: #327a61;

    width: min(1180px, calc(100% - 2rem));
    margin: 2rem auto 5rem;
    color: var(--member-text);
    font-family: var(--text-font-primary, system-ui, sans-serif);
  }

  .etiqueta {
    display: block;
    margin-bottom: 0.65rem;
    color: var(--member-primary-dark);
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(280px, 0.7fr);
    align-items: center;
    gap: clamp(2rem, 7vw, 6rem);
    min-height: 490px;
    padding: clamp(2rem, 6vw, 5rem);
    overflow: hidden;
    border: 1px solid var(--member-border);
    border-radius: 2rem;
    background:
      radial-gradient(
        circle at 88% 18%,
        rgb(212 93 140 / 16%),
        transparent 29%
      ),
      radial-gradient(circle at 8% 92%, rgb(65 120 170 / 12%), transparent 26%),
      linear-gradient(135deg, #fbfdfe 0%, #edf5fa 100%);
  }

  .hero::before {
    position: absolute;
    right: -125px;
    bottom: -145px;
    width: 365px;
    aspect-ratio: 1;
    border: 52px solid rgb(65 120 170 / 6%);
    border-radius: 50%;
    content: '';
  }

  .hero__contenido,
  .hero__visual {
    position: relative;
    z-index: 1;
  }

  .hero h1 {
    max-width: 760px;
    margin: 0 0 1.3rem;
    color: var(--member-primary-dark);
    font-size: clamp(2.2rem, 5.2vw, 4.25rem);
    line-height: 1.04;
    text-wrap: balance;
  }

  .hero p {
    max-width: 720px;
    margin: 0.75rem 0;
    color: var(--member-muted);
    font-size: 1.03rem;
    line-height: 1.75;
  }

  .hero .hero__destacado {
    color: var(--member-text);
    font-size: clamp(1.08rem, 2vw, 1.24rem);
    font-weight: 600;
  }

  .hero__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 1.7rem;
  }

  .boton,
  .pertenencia a,
  .llamada__boton {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    min-height: 49px;
    padding: 0.85rem 1.3rem;
    border: 2px solid transparent;
    border-radius: 999px;
    font-weight: 800;
    text-align: center;
    text-decoration: none;
    transition:
      transform 180ms ease,
      background-color 180ms ease,
      color 180ms ease,
      box-shadow 180ms ease;
  }

  .boton svg,
  .pertenencia a svg,
  .llamada__boton svg {
    width: 20px;
    flex-shrink: 0;
  }

  .boton--principal {
    background: var(--member-primary-dark);
    color: #fff;
    box-shadow: 0 12px 28px rgb(37 89 127 / 22%);
  }

  .boton--principal svg {
    transform: rotate(90deg);
  }

  .boton--secundario {
    border-color: rgb(37 89 127 / 23%);
    background: rgb(255 255 255 / 65%);
    color: var(--member-primary-dark);
  }

  .hero__visual {
    display: grid;
    place-items: center;
    min-height: 330px;
  }

  .ilustracion {
    position: relative;
    display: grid;
    place-items: center;
    width: min(100%, 330px);
    aspect-ratio: 1;
    border: 1px solid rgb(65 120 170 / 14%);
    border-radius: 50%;
    background: rgb(255 255 255 / 65%);
    box-shadow: 0 28px 65px rgb(37 89 127 / 15%);
  }

  .ilustracion__casa {
    display: grid;
    place-items: center;
    width: 120px;
    aspect-ratio: 1;
    border-radius: 1.8rem;
    background: var(--member-primary);
    color: #fff;
    box-shadow: 0 18px 40px rgb(65 120 170 / 27%);
    transform: translateY(-28px);
  }

  .ilustracion__casa svg {
    width: 65px;
  }

  .ilustracion__corazon {
    position: absolute;
    top: 25px;
    right: 38px;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 70px;
    aspect-ratio: 1;
    border: 6px solid #fff;
    border-radius: 50%;
    background: var(--member-secondary);
    color: #fff;
    box-shadow: 0 12px 28px rgb(212 93 140 / 23%);
  }

  .ilustracion__corazon svg {
    width: 38px;
  }

  .ilustracion__personas {
    position: absolute;
    right: 0;
    bottom: 37px;
    left: 0;
    display: flex;
    justify-content: center;
  }

  .ilustracion__personas span {
    display: grid;
    place-items: center;
    width: 64px;
    aspect-ratio: 1;
    margin-left: -10px;
    border: 5px solid #fff;
    border-radius: 50%;
    background: var(--member-background);
    color: var(--member-primary);
    box-shadow: 0 9px 22px rgb(37 89 127 / 12%);
  }

  .ilustracion__personas span:first-child {
    margin-left: 0;
  }

  .ilustracion__personas span:nth-child(2) {
    background: var(--member-primary-dark);
    color: #fff;
    transform: translateY(-8px);
  }

  .ilustracion__personas svg {
    width: 34px;
  }

  .decoracion {
    position: absolute;
    display: block;
    border-radius: 50%;
  }

  .decoracion--uno {
    top: 55px;
    left: 32px;
    width: 25px;
    aspect-ratio: 1;
    background: rgb(212 93 140 / 35%);
  }

  .decoracion--dos {
    right: 25px;
    bottom: 80px;
    width: 15px;
    aspect-ratio: 1;
    background: rgb(65 120 170 / 37%);
  }

  .decoracion--tres {
    bottom: 50px;
    left: 25px;
    width: 38px;
    aspect-ratio: 1;
    border: 8px solid rgb(65 120 170 / 18%);
  }

  .mensaje-principal {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1.5rem;
    margin-top: 2rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border-left: 6px solid var(--member-secondary);
    border-radius: 0.35rem 1.5rem 1.5rem 0.35rem;
    background: #fdf1f5;
  }

  .mensaje-principal__icono {
    display: grid;
    place-items: center;
    width: 59px;
    height: 59px;
    border-radius: 50%;
    background: #fff;
    color: var(--member-secondary);
    box-shadow: 0 10px 25px rgb(212 93 140 / 13%);
  }

  .mensaje-principal__icono svg {
    width: 31px;
  }

  .mensaje-principal h2,
  .aporte h2,
  .pertenencia h2,
  .llamada h2 {
    margin: 0 0 0.8rem;
    color: var(--member-primary-dark);
    font-size: clamp(1.45rem, 3vw, 2rem);
    line-height: 1.2;
    text-wrap: balance;
  }

  .mensaje-principal p {
    max-width: 920px;
    margin: 0;
    color: var(--member-muted);
    line-height: 1.75;
  }

  .funcionamiento,
  .destinos {
    padding-top: clamp(4.5rem, 10vw, 7.5rem);
    scroll-margin-top: 2rem;
  }

  .encabezado-seccion {
    max-width: 730px;
    margin: 0 auto clamp(2.2rem, 5vw, 3.5rem);
    text-align: center;
  }

  .encabezado-seccion h2 {
    margin: 0;
    color: var(--member-primary-dark);
    font-size: clamp(1.9rem, 4vw, 2.8rem);
    line-height: 1.15;
    text-wrap: balance;
  }

  .encabezado-seccion p {
    margin: 1rem 0 0;
    color: var(--member-muted);
    font-size: 1.04rem;
    line-height: 1.7;
  }

  .funcionamiento__grid,
  .destinos__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.2rem;
  }

  .paso,
  .destino {
    position: relative;
    min-width: 0;
    padding: clamp(1.4rem, 3vw, 2rem);
    overflow: hidden;
    border: 1px solid var(--member-border);
    border-radius: 1.5rem;
    background: #fff;
    box-shadow: 0 14px 40px rgb(38 63 80 / 6%);
    transition:
      transform 180ms ease,
      box-shadow 180ms ease,
      border-color 180ms ease;
  }

  .paso__numero {
    position: absolute;
    top: 1rem;
    right: 1.2rem;
    color: rgb(37 89 127 / 16%);
    font-size: 2.2rem;
    font-weight: 900;
  }

  .paso__icono,
  .destino__icono {
    display: grid;
    place-items: center;
    width: 58px;
    height: 58px;
    margin-bottom: 1.25rem;
    border-radius: 1.1rem;
    background: #edf5fa;
    color: var(--member-primary);
  }

  .paso:nth-child(even) .paso__icono,
  .destino:nth-child(even) .destino__icono {
    background: #fbeaf1;
    color: var(--member-secondary);
  }

  .paso__icono svg,
  .destino__icono svg {
    width: 31px;
  }

  .paso h3,
  .destino h3 {
    margin: 0 0 0.75rem;
    color: var(--member-primary-dark);
    font-size: 1.27rem;
  }

  .paso p,
  .destino p {
    margin: 0;
    color: var(--member-muted);
    line-height: 1.65;
  }

  .aporte {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(230px, 0.7fr);
    align-items: center;
    gap: clamp(2rem, 7vw, 6rem);
    margin-top: clamp(4.5rem, 10vw, 7.5rem);
    padding: clamp(2rem, 6vw, 4rem);
    overflow: hidden;
    border: 1px solid var(--member-border);
    border-radius: 1.8rem;
    background:
      radial-gradient(
        circle at 90% 20%,
        rgb(212 93 140 / 13%),
        transparent 30%
      ),
      var(--member-background);
  }

  .aporte h2 {
    font-size: clamp(1.8rem, 4vw, 2.7rem);
  }

  .aporte__contenido > p {
    max-width: 760px;
    margin: 0.65rem 0;
    color: var(--member-muted);
    line-height: 1.75;
  }

  .aporte__destacado {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    margin-top: 1.5rem;
    padding: 1rem 1.1rem;
    border-left: 4px solid var(--member-success);
    border-radius: 0.2rem 1rem 1rem 0.2rem;
    background: #edf8f3;
  }

  .aporte__destacado svg {
    width: 24px;
    flex-shrink: 0;
    color: var(--member-success)
  }

  .aporte__destacado p {
    margin: 0;
    color: #44675a;
    font-weight: 650;
    line-height: 1.6;
  }

  .aporte__visual {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 260px;
  }

  .aporte__corazon {
    display: grid;
    place-items: center;
    width: 125px;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--member-secondary);
    color: #fff;
    box-shadow: 0 20px 45px rgb(212 93 140 / 26%);
  }

  .aporte__corazon svg {
    width: 68px;
  }

  .aporte__moneda {
    position: absolute;
    display: grid;
    place-items: center;
    width: 70px;
    aspect-ratio: 1;
    border: 6px solid #fff;
    border-radius: 50%;
    background: var(--member-primary);
    color: #fff;
    box-shadow: 0 12px 28px rgb(37 89 127 / 18%);
  }

  .aporte__moneda svg {
    width: 37px;
  }

  .aporte__moneda--uno {
    top: 8%;
    left: 5%;
    transform: rotate(-8deg);
  }

  .aporte__moneda--dos {
    right: 2%;
    bottom: 5%;
    background: var(--member-primary-dark);
    transform: rotate(8deg);
  }

  .pertenencia {
    display: grid;
    grid-template-columns: minmax(230px, 0.65fr) minmax(0, 1.35fr);
    align-items: center;
    gap: clamp(2rem, 7vw, 6rem);
    margin-top: clamp(4.5rem, 10vw, 7.5rem);
    padding: clamp(2rem, 6vw, 4rem);
    border-radius: 1.8rem;
    background: var(--member-primary-dark);
    color: #fff;
  }

  .pertenencia__visual {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .pertenencia__casa {
