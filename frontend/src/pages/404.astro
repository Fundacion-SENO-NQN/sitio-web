---
import Layout from '../layouts/Layout.astro'
---

<Layout pag="Página no encontrada" noindex>
  <main class="not-found">
    <p class="not-found__code" aria-hidden="true">404</p>

    <h1>Página no encontrada</h1>

    <p>
      La dirección ingresada no existe, fue modificada o ya no se encuentra
      disponible.
    </p>

    <nav aria-label="Opciones para continuar">
      <a class="not-found__primary" href="/"> Volver al inicio </a>

      <a class="not-found__secondary" href="/noticias"> Ver noticias </a>

      <a class="not-found__secondary" href="/eventos"> Ver eventos </a>
    </nav>
  </main>
</Layout>

<style>
  .not-found {
    width: min(calc(100% - 2rem), 45rem);
    min-height: 65vh;
    margin-inline: auto;
    padding-block: clamp(4rem, 12vw, 8rem);

    display: flex;
    flex-direction: column;
    align-items: center;

    text-align: center;
  }

  .not-found__code {
    color: var(--color-primary-light);

    font-size: clamp(5rem, 20vw, 10rem);
    font-weight: 700;
    line-height: 0.9;
  }

  .not-found h1 {
    margin-top: 1rem;

    color: var(--color-primary-hover);

    font-size: clamp(1.8rem, 5vw, 3rem);
    line-height: 1.2;
  }

  .not-found > p:not(.not-found__code) {
    max-width: 38rem;
    margin-top: 1rem;

    color: #667580;

    font-size: 1.05rem;
    line-height: 1.7;
  }

  .not-found nav {
    margin-top: 2rem;

    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }

  .not-found a {
    min-height: 3rem;
    padding: 0.75rem 1.25rem;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    border: 2px solid var(--color-primary-hover);
    border-radius: 999px;

    font-weight: 700;
    text-decoration: none;
  }

  .not-found__primary {
    color: var(--color-background);
    background-color: var(--color-primary-hover);
  }

  .not-found__secondary {
    color: var(--color-primary-hover);
    background-color: var(--color-background);
  }

  .not-found a:focus-visible {
    outline: 3px solid var(--color-primary-light);
    outline-offset: 3px;
  }

  @media (hover: hover) {
    .not-found__primary:hover {
      background-color: var(--color-primary);
      border-color: var(--color-primary);
    }

    .not-found__secondary:hover {
      color: var(--color-background);
      background-color: var(--color-primary-hover);
    }
  }

  @media (max-width: 500px) {
    .not-found {
      width: calc(100% - 1rem);
    }

    .not-found nav,
    .not-found a {
      width: 100%;
    }
  }
</style>
