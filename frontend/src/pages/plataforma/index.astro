---
import LayoutPlataforma from '../../layouts/LayoutPlataforma.astro'

import ModalCarga from '../../components/Common/ModalCarga.astro'

import SvgLogOut from '../../assets/icon-common/icon-log-out.svg'
---

<LayoutPlataforma titulo="Inicio">
  <platform-home class="platformHome">
    <header class="platformHomeHeader">
      <div class="platformHomeHeader__content">
        <p class="platformHomeEyebrow">Plataforma administrativa</p>

        <h1>
          Bienvenido/a,
          <span id="name">miembro de Fundación SENO</span>
        </h1>

        <p>Seleccioná uno de los servicios disponibles para comenzar.</p>
      </div>

      <button
        id="logout"
        class="button buttonGhost platformHomeLogout"
        type="button"
      >
        <SvgLogOut class="platformHomeLogout__icon" aria-hidden="true" />

        <span>Cerrar sesión</span>
      </button>
    </header>

    <main class="platformHomeMain" aria-labelledby="services-title">
      <section class="platformHomeServices">
        <header class="platformHomeServices__header">
          <div>
            <h2 id="services-title">Servicios disponibles</h2>

            <p>
              Tus permisos determinan las herramientas que aparecen en esta
              sección.
            </p>
          </div>
        </header>

        <div
          id="main"
          class="platformHomeGrid"
          aria-live="polite"
          aria-busy="true"
        >
        </div>

        <div
          id="servicesEmpty"
          class="emptyState platformHomeState"
          role="status"
          hidden
        >
          <span class="emptyStateIcon" aria-hidden="true"> 🔒 </span>

          <h2>No tenés servicios asignados</h2>

          <p>
            Comunicate con una persona administradora para revisar tu rol y tus
            permisos.
          </p>
        </div>

        <div
          id="servicesError"
          class="emptyState platformHomeState platformHomeState--error"
          role="alert"
          hidden
        >
          <span class="emptyStateIcon" aria-hidden="true"> ! </span>

          <h2>No pudimos cargar los servicios</h2>

          <p>Revisá la conexión con el servidor e intentá nuevamente.</p>

          <button
            id="retryServices"
            class="button buttonSecondary"
            type="button"
          >
            Reintentar
          </button>
        </div>
      </section>
    </main>

    <ModalCarga />
  </platform-home>
</LayoutPlataforma>

<script>
  import type Service from '../../data/interfaces/Service'

  const API_URL = (
    import.meta.env.PUBLIC_API_URL ?? 'https://sitio-web-fundacion-seno.fly.dev'
  ).replace(/\/+$/, '')

  class PlatformHome extends HTMLElement {
    private servicesContainer: HTMLElement | null = null
    private emptyState: HTMLElement | null = null
    private errorState: HTMLElement | null = null
    private loadingOverlay: HTMLElement | null = null
    private nameElement: HTMLElement | null = null
    private logoutButton: HTMLButtonElement | null = null
    private retryButton: HTMLButtonElement | null = null

    private abortController: AbortController | null = null
    private requestController: AbortController | null = null

    connectedCallback(): void {
      if (this.abortController) return

      const token = window.localStorage.getItem('token')

      if (!token) {
        window.location.replace('/login/')
        return
      }

      this.servicesContainer = this.querySelector<HTMLElement>('#main')

      this.emptyState = this.querySelector<HTMLElement>('#servicesEmpty')

      this.errorState = this.querySelector<HTMLElement>('#servicesError')

      this.loadingOverlay = this.querySelector<HTMLElement>('#modal-carga')

      this.nameElement = this.querySelector<HTMLElement>('#name')

      this.logoutButton = this.querySelector<HTMLButtonElement>('#logout')

      this.retryButton = this.querySelector<HTMLButtonElement>('#retryServices')

      this.abortController = new AbortController()

      const { signal } = this.abortController

      this.logoutButton?.addEventListener('click', this.handleLogout, {
        signal
      })

      this.retryButton?.addEventListener(
        'click',
        () => {
          void this.loadServices()
        },
        { signal }
      )

      const savedName = window.localStorage.getItem('name')?.trim()

      if (this.nameElement && savedName) {
        this.nameElement.textContent = ' ' + savedName
      }

      void this.loadServices()
    }

    disconnectedCallback(): void {
      this.abortController?.abort()
      this.requestController?.abort()

      this.abortController = null
      this.requestController = null
    }

    private clearAuthentication(): void {
      const authenticationKeys = [
        'token',
        'username',
        'name',
        'lastname',
        'role'
      ]

      authenticationKeys.forEach((key) => {
        window.localStorage.removeItem(key)
      })
    }

    private setLoading(loading: boolean): void {
      this.loadingOverlay?.toggleAttribute('hidden', !loading)

      this.loadingOverlay?.setAttribute('aria-hidden', String(!loading))

      this.servicesContainer?.setAttribute('aria-busy', String(loading))
    }

    private hideStates(): void {
      if (this.emptyState) {
        this.emptyState.hidden = true
      }

      if (this.errorState) {
        this.errorState.hidden = true
      }
    }

    private async loadServices(): Promise<void> {
      const token = window.localStorage.getItem('token')

      const username = window.localStorage.getItem('username')?.trim()

      if (!token || !username) {
        console.log('entre')
        this.clearAuthentication()
        window.location.replace('/login/')
        return
      }

      this.requestController?.abort()
      this.requestController = new AbortController()

      this.hideStates()
      this.setLoading(true)

      if (this.servicesContainer) {
        this.servicesContainer.replaceChildren()
      }

      try {
        const response = await fetch(
          `${API_URL}/user/permissions/username/${encodeURIComponent(username)}`,
          {
            method: 'GET',
            headers: {
              Authorization: `Bearer ${token}`
            },
            signal: this.requestController.signal
          }
        )

        if (response.status === 401 || response.status === 403) {
          console.log('entre en el error')
          this.clearAuthentication()
          window.location.replace('/login/')
          return
        }

        if (!response.ok) {
          throw new Error(`La API respondió con estado ${response.status}`)
        }

        const data: unknown = await response.json()

        if (!Array.isArray(data)) {
          throw new TypeError('La respuesta de servicios no es un arreglo')
        }

        const services = data as Service[]

        if (services.length === 0) {
          if (this.emptyState) {
            this.emptyState.hidden = false
          }

          return
        }

        const fragment = document.createDocumentFragment()

        services.forEach((service) => {
          fragment.appendChild(this.createServiceCard(service))
        })

        this.servicesContainer?.appendChild(fragment)
      } catch (error) {
        if (error instanceof DOMException && error.name === 'AbortError') {
          return
        }

        console.error('Error al obtener los permisos del usuario:', error)

        if (this.errorState) {
          this.errorState.hidden = false
        }
      } finally {
        this.setLoading(false)
        document.getElementById('modal-carga-global')?.remove()
      }
    }

    private createServiceCard(service: Service): HTMLAnchorElement {
      const servicePath = String(service.url ?? '')
        .trim()
        .replace(/^\/+|\/+$/g, '')

      const link = document.createElement('a')

      link.className = 'service-card'

      link.href = servicePath ? `/plataforma/${servicePath}/` : '/plataforma/'

      const image = document.createElement('img')

      image.src = `/img_services/${service.id}.avif`

      image.alt = ''
      image.loading = 'lazy'
      image.decoding = 'async'
      image.width = 640
      image.height = 400

      image.addEventListener(
        'error',
        () => {
          image.remove()
        },
        { once: true }
      )

      const content = document.createElement('div')

      content.className = 'service-card-content'

      const title = document.createElement('h3')

      title.textContent = service.titulo

      const description = document.createElement('p')

      description.textContent = service.name

      const arrow = document.createElement('span')

      arrow.className = 'service-card-arrow'

      arrow.textContent = '→'
      arrow.setAttribute('aria-hidden', 'true')

      content.append(title, description)

      link.append(image, content, arrow)

      return link
    }

    private handleLogout = (): void => {
      this.clearAuthentication()
      window.location.replace('/login/')
    }
  }

  if (!customElements.get('platform-home')) {
    customElements.define('platform-home', PlatformHome)
  }
</script>

<style>
  .platformHome {
    width: 100%;
    min-height: 100vh;
    min-height: 100dvh;

    display: block;

    color: var(--admin-text);
    background-color: var(--admin-background);
  }

  .platformHomeHeader {
    width: min(calc(100% - 2rem), 80rem);

    margin-inline: auto;

    padding: clamp(1.25rem, 4vw, 2rem) 0;

    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 2rem;

    border-bottom: var(--admin-border);
  }

  .platformHomeHeader__content {
    min-width: 0;
  }

  .platformHomeEyebrow {
    margin-bottom: 0.35rem;

    color: var(--color-primary);

    font-size: 0.75rem;
    font-weight: 800;
    line-height: 1.3;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .platformHomeHeader h1 {
    color: var(--admin-text);

    font-size: clamp(1.6rem, 4vw, 2.2rem);

    line-height: 1.2;
    text-wrap: balance;
  }

  .platformHomeHeader h1 span {
    color: var(--color-primary-hover);
  }

  .platformHomeHeader__content > p:last-child {
    margin-top: 0.45rem;

    color: var(--admin-text-muted);

    line-height: 1.55;
  }

  .platformHomeLogout {
    min-height: 3rem;

    flex: 0 0 auto;
  }

  .platformHomeLogout__icon {
    width: 1.35rem;
    height: 1.35rem;

    color: currentColor;
  }

  .platformHomeMain {
    width: min(calc(100% - 2rem), 80rem);

    margin-inline: auto;

    padding: clamp(2rem, 5vw, 3.5rem) 0 clamp(3rem, 8vw, 5rem);
  }

  .platformHomeServices__header {
    margin-bottom: clamp(1.5rem, 4vw, 2.25rem);
  }

  .platformHomeServices__header h2 {
    color: var(--admin-text);

    font-size: clamp(1.35rem, 3vw, 1.75rem);

    line-height: 1.3;
  }

  .platformHomeServices__header p {
    margin-top: 0.4rem;

    color: var(--admin-text-muted);

    line-height: 1.55;
  }

  .platformHomeGrid {
    display: grid;

    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));

    align-items: stretch;

    gap: clamp(1rem, 3vw, 1.5rem);
  }

  .platformHomeGrid :global(.service-card) {
    min-width: 0;
    min-height: 18rem;

    position: relative;

    display: flex;
    flex-direction: column;

    overflow: hidden;

    color: var(--admin-text);
    background-color: var(--admin-surface);

    border: var(--admin-border);

    border-radius: var(--admin-radius);

    box-shadow: var(--admin-shadow-small);

    text-decoration: none;

    transition:
      border-color var(--admin-transition),
      box-shadow var(--admin-transition),
      transform var(--admin-transition);
  }

  .platformHomeGrid :global(.service-card img) {
    width: 100%;
    height: 10rem;

    object-fit: cover;
    object-position: center;

    background-color: var(--color-primary-light);
  }

  .platformHomeGrid :global(.service-card-content) {
    min-width: 0;

    padding: 1.25rem;

    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
  }

  .platformHomeGrid :global(.service-card-content h3) {
    color: var(--color-primary-hover);

    font-size: 1.2rem;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }

  .platformHomeGrid :global(.service-card-content p) {
    margin-top: 0.55rem;

    color: var(--admin-text-muted);

    line-height: 1.55;
    overflow-wrap: anywhere;
  }

  .platformHomeGrid :global(.service-card-arrow) {
    width: 2.25rem;
    height: 2.25rem;

    position: absolute;
    right: 1rem;
    bottom: 1rem;

    display: grid;
    place-items: center;

    color: var(--color-primary-hover);

    background-color: var(--color-primary-light);

    border-radius: 50%;

    font-size: 1.15rem;
    font-weight: 800;

    transition:
      color var(--admin-transition),
      background-color var(--admin-transition),
      transform var(--admin-transition);
  }

  .platformHomeGrid :global(.service-card:focus-visible) {
    outline: none;

    box-shadow: var(--admin-focus);
  }

  .platformHomeState {
    width: min(100%, 42rem);

    margin-inline: auto;
  }

  .platformHomeState--error {
    border-color: var(--admin-danger-border);

    background-color: var(--admin-danger-light);
  }

  @media (hover: hover) {
    .platformHomeGrid :global(.service-card:hover) {
      border-color: var(--color-primary-light);

      box-shadow: var(--admin-shadow);

      transform: translateY(-4px);
    }

    .platformHomeGrid :global(.service-card:hover .service-card-arrow) {
      color: var(--admin-text-on-color);

      background-color: var(--color-primary-hover);

      transform: translateX(0.2rem);
    }
  }

  @media (max-width: 650px) {
    .platformHomeHeader {
      align-items: flex-start;
      flex-direction: column;

      gap: 1rem;
    }

    .platformHomeLogout {
      width: 100%;
    }

    .platformHomeGrid {
      grid-template-columns: minmax(0, 1fr);
    }

    .platformHomeGrid :global(.service-card) {
      min-height: 0;

      display: grid;

      grid-template-columns:
        7rem
        minmax(0, 1fr);
    }

    .platformHomeGrid :global(.service-card img) {
      width: 7rem;
      height: 100%;
      min-height: 8rem;

      grid-row: 1;
    }

    .platformHomeGrid :global(.service-card-content) {
      padding: 1rem 3.5rem 1rem 1rem;
    }
  }

  @media (max-width: 400px) {
    .platformHomeGrid :global(.service-card) {
      grid-template-columns: minmax(0, 1fr);
    }

    .platformHomeGrid :global(.service-card img) {
      width: 100%;
      height: 9rem;
      min-height: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .platformHomeGrid :global(.service-card),
    .platformHomeGrid :global(.service-card-arrow) {
      transition: none;
    }
  }
</style>
