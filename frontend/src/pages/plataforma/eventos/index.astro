---
import HeaderPlataforma from '../../../components/Plataforma/HeaderPlataforma.astro'
import LayoutPlataforma from '../../../layouts/LayoutPlataforma.astro'

import '../../../style/eventos.css'
---

<LayoutPlataforma titulo="Eventos">
  <HeaderPlataforma
    title="Eventos"
    content="Administrá los eventos que se muestran en el sitio web."
  />

  <main class="adminPage eventos-admin">
    <section
      class="toolbar herramientas"
      aria-label="Herramientas de administración de eventos"
    >
      <button
        id="btn-nuevo-evento"
        class="button buttonPrimary boton boton-principal"
        type="button"
      >
        <span aria-hidden="true">+</span>
        <span>Nuevo evento</span>
      </button>

      <label class="searchField buscador" for="buscar-eventos">
        <span class="srOnly sr-only"> Buscar eventos </span>

        <span class="searchFieldIcon icono-busqueda" aria-hidden="true">
          ⌕
        </span>

        <input
          id="buscar-eventos"
          type="search"
          placeholder="Buscar por título, lugar o descripción..."
          autocomplete="off"
          aria-describedby="cantidad-eventos"
        />
      </label>

      <div class="toolbarSummary resumen" aria-live="polite" aria-atomic="true">
        <span id="cantidad-eventos"> 0 eventos </span>
      </div>
    </section>

    <section
      class="tableContainer contenedor-tabla"
      aria-label="Listado de eventos"
    >
      <div
        id="estado-cargando"
        class="tableState estado-tabla"
        role="status"
        aria-live="polite"
      >
        <div class="spinner" aria-hidden="true"></div>

        <p>Cargando eventos...</p>
      </div>

      <div
        id="estado-error"
        class="tableState tableStateError estado-tabla oculto"
        role="alert"
      >
        <span class="tableStateIcon estado-icono" aria-hidden="true"> ! </span>

        <h2>No se pudieron cargar los eventos</h2>

        <p>Revisá la conexión con el servidor e intentá nuevamente.</p>

        <button
          id="btn-reintentar-eventos"
          class="button buttonSecondary boton boton-secundario"
          type="button"
        >
          Reintentar
        </button>
      </div>

      <div
        id="estado-vacio"
        class="tableState estado-tabla oculto"
        role="status"
      >
        <span class="tableStateIcon estado-icono" aria-hidden="true"> 📅 </span>

        <h2>No hay eventos publicados</h2>

        <p>Creá el primer evento para que aparezca en el sitio web.</p>

        <button
          id="btn-primer-evento"
          class="button buttonPrimary boton boton-principal"
          type="button"
        >
          Crear evento
        </button>
      </div>

      <div id="tabla-wrapper" class="tableWrapper tabla-wrapper oculto">
        <table class="dataTable tabla-eventos">
          <caption class="srOnly sr-only">
            Eventos publicados en el sitio web
          </caption>

          <thead>
            <tr>
              <th scope="col">Orden</th>
              <th scope="col">Imagen</th>
              <th scope="col">Evento</th>
              <th scope="col">Fecha y horario</th>
              <th scope="col">Lugar</th>
              <th scope="col">Imágenes</th>
              <th scope="col">Enlace</th>
              <th scope="col">Acciones</th>
            </tr>
          </thead>

          <tbody id="tabla-eventos-body"></tbody>
        </table>
      </div>
    </section>
  </main>

  <!-- =====================================================
       MODAL CREAR / EDITAR EVENTO
  ====================================================== -->

  <div
    id="modal-evento"
    class="modal oculto"
    role="dialog"
    aria-modal="true"
    aria-labelledby="modal-evento-titulo"
    tabindex="-1"
  >
    <div
      class="modalBackdrop modal-fondo"
      data-cerrar-modal-evento
      aria-hidden="true"
    >
    </div>

    <div class="modalContent modal-contenido modal-evento-contenido">
      <header class="modalHeader modal-cabecera">
        <div>
          <p class="modalEyebrow modal-seccion">Administración de eventos</p>

          <h2 id="modal-evento-titulo">Nuevo evento</h2>
        </div>

        <button
          id="btn-cerrar-modal-evento"
          class="iconButton boton-cerrar"
          type="button"
          aria-label="Cerrar ventana de evento"
        >
          <span aria-hidden="true">×</span>
        </button>
      </header>

      <form id="form-evento" class="adminForm form-evento" autocomplete="off">
        <div class="formContent form-contenido">
          <section
            class="formSection form-seccion"
            aria-labelledby="datos-principales-titulo"
          >
            <header class="formSectionHeader form-seccion-cabecera">
              <div>
                <h3 id="datos-principales-titulo">Información principal</h3>

                <p>Estos datos se mostrarán en la página pública del evento.</p>
              </div>
            </header>

            <div class="formGrid form-grid">
              <label class="formField campo campo-completo">
                <span class="formLabel campo-label">
                  Título

                  <span class="requiredMark" aria-hidden="true"> * </span>
                </span>

                <input
                  id="evento-titulo"
                  name="titulo"
                  type="text"
                  maxlength="180"
                  placeholder="Ej.: Torta Infantil del Niño Oncológico"
                  required
                />

                <span class="formHelp campo-ayuda">
                  Nombre con el que aparecerá publicado el evento.
                </span>
              </label>

              <label class="formField campo campo-completo">
                <span class="formLabel campo-label">
                  Descripción

                  <span class="requiredMark" aria-hidden="true"> * </span>
                </span>

                <textarea
                  id="evento-descripcion"
                  name="descripcion"
                  maxlength="6000"
                  rows="9"
                  placeholder="Escribí la información completa del evento..."
                  required></textarea>

                <span class="formHelp campo-ayuda">
                  Podés utilizar saltos de línea y emojis.
                </span>
              </label>
            </div>
          </section>

          <section
            class="formSection form-seccion"
            aria-labelledby="datos-evento-titulo"
          >
            <header class="formSectionHeader form-seccion-cabecera">
              <div>
                <h3 id="datos-evento-titulo">Fecha y ubicación</h3>

                <p>Todos estos campos son opcionales.</p>
              </div>
            </header>

            <div class="formGrid form-grid">
              <label class="formField campo">
                <span class="formLabel campo-label">
                  Fecha

                  <span class="optionalLabel opcional"> Opcional </span>
                </span>

                <input
                  id="evento-fecha"
                  name="fecha"
                  type="text"
                  maxlength="120"
                  placeholder="Ej.: 8 de agosto de 2026"
                />
              </label>

              <label class="formField campo">
                <span class="formLabel campo-label">
                  Horario

                  <span class="optionalLabel opcional"> Opcional </span>
                </span>

                <input
                  id="evento-horario"
                  name="horario"
                  type="text"
                  maxlength="120"
                  placeholder="Ej.: De 12:00 a 18:00 h"
                />
              </label>

              <label class="formField campo campo-completo">
                <span class="formLabel campo-label">
                  Lugar

                  <span class="optionalLabel opcional"> Opcional </span>
                </span>

                <input
                  id="evento-lugar"
                  name="lugar"
                  type="text"
                  maxlength="220"
                  placeholder="Ej.: Gimnasio EPET N.º 8, Neuquén Capital"
                />
              </label>
            </div>
          </section>

          <section
            class="formSection form-seccion"
            aria-labelledby="enlace-evento-titulo"
          >
            <header class="formSectionHeader form-seccion-cabecera">
              <div>
                <h3 id="enlace-evento-titulo">Enlace externo</h3>

                <p>
                  Podés agregar un formulario de inscripción, una publicación o
                  cualquier página relacionada.
                </p>
              </div>
            </header>

            <div class="formGrid form-grid">
              <label class="formField campo">
                <span class="formLabel campo-label">
                  URL

                  <span class="optionalLabel opcional"> Opcional </span>
                </span>

                <input
                  id="evento-url"
                  name="url"
                  type="url"
                  inputmode="url"
                  maxlength="1000"
                  placeholder="https://..."
                />
              </label>

              <label class="formField campo">
                <span class="formLabel campo-label">
                  Texto del botón

                  <span class="optionalLabel opcional"> Opcional </span>
                </span>

                <input
                  id="evento-url-titulo"
                  name="url_titulo"
                  type="text"
                  maxlength="160"
                  placeholder="Ej.: Formulario de inscripción"
                />
              </label>
            </div>
          </section>

          <section
            class="formSection form-seccion"
            aria-labelledby="imagenes-evento-titulo"
          >
            <header class="formSectionHeader form-seccion-cabecera">
              <div>
                <h3 id="imagenes-evento-titulo">Imágenes</h3>

                <p id="texto-ayuda-imagenes">
                  Seleccioná entre 1 y 10 imágenes para el evento.
                </p>
              </div>
            </header>

            <label
              id="zona-subida-imagenes"
              class="imagePicker zona-subida"
              for="evento-imagenes"
            >
              <input
                id="evento-imagenes"
                name="images"
                type="file"
                accept="image/jpeg,image/png,image/webp,image/avif"
                aria-describedby="texto-ayuda-imagenes"
                multiple
              />

              <span class="imagePickerIcon subida-icono" aria-hidden="true">
                +
              </span>

              <strong> Seleccionar imágenes </strong>

              <span> También podés arrastrarlas hasta esta zona </span>

              <small> JPG, PNG, WebP o AVIF · máximo 10 imágenes </small>
            </label>

            <div
              id="imagenes-seleccionadas"
              class="imagePreviewGrid galeria-preview oculto"
              aria-label="Imágenes seleccionadas"
              aria-live="polite"
            >
            </div>

            <div
              id="imagenes-actuales-contenedor"
              class="currentImages imagenes-actuales oculto"
            >
              <div class="currentImagesHeader imagenes-actuales-cabecera">
                <h4>Imágenes actuales</h4>

                <p>
                  Si seleccionás nuevas imágenes, reemplazarán completamente las
                  actuales.
                </p>
              </div>

              <div
                id="imagenes-actuales"
                class="imagePreviewGrid galeria-preview"
                aria-label="Imágenes actuales del evento"
              >
              </div>
            </div>
          </section>
        </div>

        <footer class="modalFooter modal-footer">
          <button
            id="btn-cancelar-evento"
            class="button buttonGhost boton boton-cancelar"
            type="button"
          >
            Cancelar
          </button>

          <button
            id="btn-guardar-evento"
            class="button buttonPrimary boton boton-principal"
            type="submit"
          >
            Guardar evento
          </button>
        </footer>
      </form>
    </div>
  </div>

  <!-- =====================================================
       MODAL ELIMINAR EVENTO
  ====================================================== -->

  <div
    id="modal-eliminar-evento"
    class="modal oculto"
    role="dialog"
    aria-modal="true"
    aria-labelledby="modal-eliminar-titulo"
    aria-describedby="texto-eliminar-evento"
    tabindex="-1"
  >
    <div
      class="modalBackdrop modal-fondo"
      data-cerrar-modal-eliminar
      aria-hidden="true"
    >
    </div>

    <div class="modalContent modal-contenido modal-eliminar-contenido">
      <header class="modalHeader modal-cabecera">
        <h2 id="modal-eliminar-titulo">Eliminar evento</h2>

        <button
          id="btn-cerrar-modal-eliminar"
          class="iconButton boton-cerrar"
          type="button"
          aria-label="Cerrar ventana de eliminación"
        >
          <span aria-hidden="true">×</span>
        </button>
      </header>

      <div class="deleteConfirmation eliminar-contenido deleteBody">
        <span class="deleteConfirmationIcon eliminar-icono" aria-hidden="true">
          !
        </span>

        <h3>¿Seguro que querés eliminar este evento?</h3>

        <p id="texto-eliminar-evento">
          El evento y todas sus imágenes serán eliminados permanentemente.
        </p>

        <p class="dangerMessage advertencia">
          Esta acción no se puede deshacer.
        </p>
      </div>

      <footer class="modalFooter modal-footer">
        <button
          id="btn-cancelar-eliminar"
          class="button buttonGhost boton boton-cancelar"
          type="button"
        >
          Cancelar
        </button>

        <button
          id="btn-confirmar-eliminar"
          class="button buttonDanger boton boton-peligro"
          type="button"
        >
          Eliminar evento
        </button>
      </footer>
    </div>
  </div>

  <script>
    import '../../../js/eventos/eventos.js'
  </script>
</LayoutPlataforma>
