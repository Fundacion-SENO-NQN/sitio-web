---
import ModalCarga from '../../../components/Common/ModalCarga.astro'
import PantallaCarga from '../../../components/Common/PantallaCarga.astro'
import LayoutPlataforma from '../../../layouts/LayoutPlataforma.astro'
import '../../../style/users.css'
import HeaderPlataforma from '../../../components/Plataforma/HeaderPlataforma.astro'
---

<LayoutPlataforma>
  <HeaderPlataforma
    title="Administración de Usuarios"
    content="Manejo de usuarios, roles y permisos"
  />

  <nav class="tabs">
    <button id="tabUsers" class="tab active" type="button"> Usuarios </button>

    <button id="tabRoles" class="tab" type="button"> Roles </button>
  </nav>

  <main class="users-page">
    <!-- USERS -->

    <section id="usersView">
      <div class="toolbar">
        <input
          id="searchUsers"
          type="search"
          placeholder="Buscar usuarios..."
          autocomplete="off"
        />

        <button id="btnNewUser" type="button" class="primaryButton">
          + Nuevo usuario
        </button>
      </div>

      <div class="tableContainer">
        <table>
          <thead>
            <tr>
              <th id="sortName" class="sort-up"> Nombre </th>

              <th id="sortUsername"> Nombre de usuario </th>

              <th id="sortEmail"> Correo Electrónico </th>

              <th id="sortRole"> Rol </th>

              <th id="sortStatus"> Estatus </th>

              <th> Acciones </th>
            </tr>
          </thead>

          <tbody id="usersBody"> </tbody>
        </table>
        <PantallaCarga id="users" />

        <div id="usersEmpty" class="emptyState" hidden>
          No se econtró ningún usuario.
        </div>
      </div>
    </section>

    <!-- ROLES -->

    <section id="rolesView" hidden>
      <div class="toolbar">
        <input
          id="searchRoles"
          type="search"
          placeholder="Buscar roles..."
          autocomplete="off"
        />

        <button id="btnNewRole" type="button" class="primaryButton">
          + Nuevo rol
        </button>
      </div>

      <div class="tableContainer">
        <table>
          <thead>
            <tr>
              <th id="sortRoleName">Nombre</th>

              <th id="sortRoleServices">Servicios</th>

              <th>Acciones</th>
            </tr>
          </thead>

          <tbody id="rolesBody"></tbody>
        </table>

        <PantallaCarga id="roles" />

        <div id="rolesEmpty" class="emptyState" hidden>
          Ningún rol encontrado.
        </div>
      </div>
    </section>
  </main>

  <!-- USER MODAL -->

  <div id="userModal" class="modal hidden">
    <ModalCarga id="user" />
    <div class="modalContent">
      <div class="modalHeader">
        <h2 id="modalTitle">Crear Usuario</h2>

        <button id="btnCloseModal" class="iconButton" type="button"> ✕ </button>
      </div>

      <form id="userForm">
        <div class="field">
          <label for="username"> Nombre de Usuario </label>

          <input id="username" name="username" required />
        </div>

        <div class="field">
          <label for="email"> Correo Electrónico </label>

          <input id="email" name="email" type="email" required />
        </div>

        <div class="field">
          <label for="name"> Nombre </label>

          <input id="name" name="name" required />
        </div>

        <div class="field">
          <label for="lastName"> Apellido </label>

          <input id="lastName" name="lastName" required />
        </div>

        <div id="roleContainer" class="field">
          <label for="roleSelect"> Rol </label>

          <select id="roleSelect" name="role"></select>
        </div>

        <div id="passwordContainer" class="field">
          <label for="password"> Contraseña </label>

          <input id="password" name="password" type="password" />
        </div>

        <div class="modalButtons">
          <button id="btnCancel" type="button" class="secondaryButton">
            Cancelar
          </button>

          <button type="submit" class="primaryButton"> Guardar </button>
        </div>
      </form>
    </div>
  </div>

  <!-- ROLE MODAL -->

  <div id="roleModal" class="modal hidden">
    <ModalCarga id="role" />
    <div class="modalContent">
      <div class="modalHeader">
        <h2 id="roleModalTitle">Crear Rol</h2>

        <button id="btnCloseRoleModal" class="iconButton" type="button">
          ✕
        </button>
      </div>

      <form id="roleForm">
        <div class="field">
          <label for="roleName"> Nombre </label>

          <input id="roleName" required />
        </div>

        <div class="field">
          <label> Servicios </label>

          <div id="servicesContainer">
            <!-- Generated dynamically -->
          </div>
        </div>

        <div class="modalButtons">
          <button id="btnCancelRole" type="button" class="secondaryButton">
            Cancelar
          </button>

          <button type="submit" class="primaryButton"> Guardar </button>
        </div>
      </form>
    </div>
  </div>

  <!-- DELETE CONFIRMATION -->

  <div id="confirmModal" class="modal hidden">
    <ModalCarga id="confirm" />
    <div class="confirmBox">
      <h2>Borrar</h2>

      <p id="confirmText">¿Estás segur@?</p>

      <div class="modalButtons">
        <button id="btnCancelDelete" type="button" class="secondaryButton">
          Cancelar
        </button>

        <button id="btnConfirmDelete" type="button" class="dangerButton">
          Borrar
        </button>
      </div>
    </div>
  </div>
</LayoutPlataforma>

<script>
  import '../../../js/users/users.js'
</script>
