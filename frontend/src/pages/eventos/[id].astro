---
import type { GetStaticPaths } from 'astro'

import Layout from '../../layouts/Layout.astro'
import GaleriaEvento from '../../components/Eventos/GaleriaEvento.astro'
import Breadcrumbs from '../../components/Common/Breadcrumbs.astro'
import JsonLd from '../../components/SEO/JsonLd.astro'

import type Evento from '../../data/interfaces/Evento'

import { createSeoDescription, toIsoDate } from '../../utils/seo'

/* ==========================================================
   STATIC RENDERING
========================================================== */

export const prerender = true

/* ==========================================================
   TYPES
========================================================== */

type EventoSeo = Evento & {
  start_at?: string | Date | null
  end_at?: string | Date | null

  previous_start_at?: string | Date | null

  created_at?: string | Date | null
  updated_at?: string | Date | null

  location_name?: string | null

  street_address?: string | null
  address_locality?: string | null
  address_region?: string | null
  postal_code?: string | null
  address_country?: string | null

  event_status?: 'scheduled' | 'cancelled' | 'postponed' | 'rescheduled'

  image_url?: string | null
  image_urls?: string[] | null
}

interface Props {
  evento: EventoSeo
}

/* ==========================================================
   STATIC PATHS

   This code only runs during the Astro build.

   The visitor will NOT execute any API request when opening
   /eventos/:id.
========================================================== */

export const getStaticPaths: GetStaticPaths = async () => {
  const API_URL = (
    import.meta.env.PUBLIC_API_URL ?? 'https://sitio-web-fundacion-seno.fly.dev'
  ).replace(/\/+$/, '')
  /*
   * First obtain all existing events so Astro knows which
   * URLs need to exist.
   */
  const response = await fetch(`${API_URL}/eventos`)

  if (!response.ok) {
    throw new Error(
      `No se pudieron obtener los eventos durante el build. ` +
        `La API respondió con estado ${response.status}.`
    )
  }

  const data: unknown = await response.json()

  if (!Array.isArray(data)) {
    throw new TypeError('La API de eventos no devolvió un arreglo.')
  }

  const eventIds = data
    .map((item) => {
      if (!item || typeof item !== 'object' || !('id' in item)) {
        return null
      }

      const id = Number(item.id)

      if (!Number.isInteger(id) || id <= 0) {
        return null
      }

      return id
    })
    .filter((id): id is number => id !== null)

  /*
   * Load the complete version of every event.
   *
   * We use /eventos/:id because this guarantees that each
   * generated page gets the same complete data that the
   * previous SSR implementation used.
   *
   * Promise.all allows the requests to happen concurrently
   * during the build.
   */
  const eventos = await Promise.all(
    eventIds.map(async (id) => {
      const eventResponse = await fetch(`${API_URL}/eventos/${id}`)

      if (!eventResponse.ok) {
        throw new Error(
          `No se pudo obtener el evento ${id} durante el build. ` +
            `Estado: ${eventResponse.status}.`
        )
      }

      const eventData: unknown = await eventResponse.json()

      if (!eventData || typeof eventData !== 'object') {
        throw new TypeError(`La respuesta del evento ${id} no es válida.`)
      }

      return eventData as EventoSeo
    })
  )

  return eventos.map((evento) => ({
    params: {
      id: String(evento.id)
    },

    props: {
      evento
    }
  }))
}

/* ==========================================================
   EVENT

   From this point onward no API request is necessary.
   The event was injected by getStaticPaths().
========================================================== */

const { evento } = Astro.props as Props

/* ==========================================================
   DESCRIPTION
========================================================== */

const paragraphs = evento.descripcion
  ? evento.descripcion
      .split(/\r?\n/)
      .map((paragraph) => paragraph.trim())
      .filter(Boolean)
  : []

/* ==========================================================
   URL HELPERS
========================================================== */

function normalizeExternalUrl(value?: string | null): string | null {
  if (!value) {
    return null
  }

  try {
    const url = new URL(value)

    if (url.protocol !== 'http:' && url.protocol !== 'https:') {
      return null
    }

    return url.href
  } catch {
    return null
  }
}

function normalizeImageUrl(value?: string | null): string | null {
  if (!value) {
    return null
  }

  try {
    return new URL(value, Astro.site ?? 'https://fundacionseno.org').href
  } catch {
    return null
  }
}

/* ==========================================================
   PAGE DATA
========================================================== */

const eventExternalUrl = normalizeExternalUrl(evento.url)

const pageTitle = evento.titulo

const pageDescription = createSeoDescription(
  evento.descripcion,

  `${evento.titulo}. Conocé la información de este evento de Fundación SENO.`
)

/* ==========================================================
   URLS
========================================================== */

const site = Astro.site ?? new URL('https://fundacionseno.org')

const homeUrl = new URL('/', site).href

const pageUrl = new URL(`/eventos/${evento.id}`, site).href

const organizationId = `${homeUrl}#organization`

/* ==========================================================
   DATES
========================================================== */

const startDate = toIsoDate(evento.start_at)

const endDate = toIsoDate(evento.end_at)

const previousStartDate = toIsoDate(evento.previous_start_at)

/* ==========================================================
   IMAGES
========================================================== */

const eventImages = [
  ...(Array.isArray(evento.image_urls) ? evento.image_urls : []),

  evento.image_url
]
  .map((image) => normalizeImageUrl(image))
  .filter((image): image is string => Boolean(image))

/* ==========================================================
   EVENT STATUS
========================================================== */

const eventStatusMap = {
  scheduled: 'https://schema.org/EventScheduled',

  cancelled: 'https://schema.org/EventCancelled',

  postponed: 'https://schema.org/EventPostponed',

  rescheduled: 'https://schema.org/EventRescheduled'
} as const

/* ==========================================================
   LOCATION
========================================================== */

const hasStructuredLocation = Boolean(
  evento.location_name &&
  evento.street_address &&
  evento.address_locality &&
  evento.address_region &&
  evento.address_country
)

/* ==========================================================
   STRUCTURED DATA
========================================================== */

const eventSchema =
  startDate && hasStructuredLocation
    ? {
        '@context': 'https://schema.org',

        '@type': 'Event',

        '@id': `${pageUrl}#event`,

        name: evento.titulo,

        description: pageDescription,

        url: pageUrl,

        startDate,

        ...(endDate
          ? {
              endDate
            }
          : {}),

        eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',

        eventStatus: eventStatusMap[evento.event_status ?? 'scheduled'],

        ...(previousStartDate && evento.event_status === 'rescheduled'
          ? {
              previousStartDate
            }
          : {}),

        location: {
          '@type': 'Place',

          name: evento.location_name,

          address: {
            '@type': 'PostalAddress',

            streetAddress: evento.street_address,

            addressLocality: evento.address_locality,

            addressRegion: evento.address_region,

            addressCountry: evento.address_country,

            ...(evento.postal_code
              ? {
                  postalCode: evento.postal_code
                }
              : {})
          }
        },

        ...(eventImages.length > 0
          ? {
              image: eventImages
            }
          : {}),

        organizer: {
          '@type': 'Organization',

          '@id': organizationId,

          name: 'Fundación SENO',

          url: homeUrl
        }
      }
    : null
---

<Layout
  pag={pageTitle}
  seoTitle={`${evento.titulo} | Eventos Fundación SENO`}
  description={pageDescription}
  image={eventImages[0]}
>
  {eventSchema && <JsonLd data={eventSchema} />}

  <Breadcrumbs
    items={[
      {
        name: 'Inicio',
        href: '/'
      },
      {
        name: 'Eventos',
        href: '/eventos'
      },
      {
        name: evento.titulo
      }
    ]}
  />

  <main class="event-detail-page">
    <nav
      class="event-detail-page__navigation"
      aria-label="Navegación de eventos"
    >
      <a class="event-detail-page__back" href="/eventos/">
        <span aria-hidden="true"> ← </span>

        <span> Volver a eventos </span>
      </a>
    </nav>

    <article class="event-detail" aria-labelledby="event-title">
      <div class="event-detail__gallery">
        <GaleriaEvento
          eventoId={evento.id}
          titulo={evento.titulo}
          cantidad={evento.cant_img}
        />
      </div>

      <div class="event-detail__content">
        <header class="event-detail__header">
          <p class="event-detail__category">Evento</p>

          <h1 id="event-title">
            {evento.titulo}
          </h1>
        </header>

        {
          (evento.fecha || evento.horario || evento.lugar) && (
            <dl class="event-detail__metadata">
              {evento.fecha && (
                <div class="event-detail__metadata-item">
                  <dt>
                    <span aria-hidden="true">📅</span>

                    <span>Fecha</span>
                  </dt>

                  <dd>{evento.fecha}</dd>
                </div>
              )}

              {evento.horario && (
                <div class="event-detail__metadata-item">
                  <dt>
                    <span aria-hidden="true">🕒</span>

                    <span>Horario</span>
                  </dt>

                  <dd>{evento.horario}</dd>
                </div>
              )}

              {evento.lugar && (
                <div class="event-detail__metadata-item">
                  <dt>
                    <span aria-hidden="true">📍</span>

                    <span>Lugar</span>
                  </dt>

                  <dd>{evento.lugar}</dd>
                </div>
              )}
            </dl>
          )
        }

        {
          paragraphs.length > 0 && (
            <section
              class="event-detail__description"
              aria-label="Descripción del evento"
            >
              {paragraphs.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
            </section>
          )
        }

        {
          eventExternalUrl && (
            <div class="event-detail__actions">
              <a
                class="event-detail__external-link"
                href={eventExternalUrl}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${evento.url_titulo || 'Más información'} sobre ${evento.titulo} en una pestaña nueva`}
              >
                <span>{evento.url_titulo || 'Más información'}</span>

                <span aria-hidden="true">↗</span>
              </a>
            </div>
          )
        }
      </div>
    </article>
  </main>
</Layout>

<style>
  .event-detail-page {
    width: min(100%, 76rem);
    min-width: 0;

    margin-inline: auto;

    padding: clamp(1rem, 4vw, 2.5rem) clamp(1rem, 4vw, 2rem)
      clamp(2rem, 6vw, 4rem);
  }

  .event-detail-page__navigation {
    margin-bottom: clamp(1rem, 3vw, 1.5rem);
  }

  .event-detail-page__back {
    width: fit-content;

    display: inline-flex;
    align-items: center;
    gap: 0.45rem;

    color: var(--color-secondary-hover);

    font-weight: 700;
    line-height: 1.4;
    text-decoration: none;

    transition:
      color var(--transition),
      transform var(--transition);
  }

  .event-detail-page__back:hover {
    color: var(--color-secondary);

    text-decoration: underline;
  }

  .event-detail-page__back:focus-visible {
    outline: none;

    border-radius: 0.2rem;

    box-shadow: 0 0 0 3px var(--color-secondary-light);
  }

  .event-detail {
    display: grid;

    grid-template-columns:
      minmax(0, 1.15fr)
      minmax(18rem, 0.85fr);

    align-items: start;

    gap: clamp(1.5rem, 5vw, 3rem);
  }

  .event-detail__gallery,
  .event-detail__content {
    min-width: 0;
  }

  .event-detail__header {
    margin-bottom: 1.4rem;
  }

  .event-detail__category {
    margin-bottom: 0.5rem;

    color: var(--color-secondary-hover);

    font-size: 0.82rem;
    font-weight: 800;
    line-height: 1.3;

    letter-spacing: 0.08em;

    text-transform: uppercase;
  }

  .event-detail__header h1 {
    color: var(--color-primary-hover);

    font-size: clamp(1.9rem, 5vw, 3rem);

    line-height: 1.12;

    text-wrap: balance;
    overflow-wrap: anywhere;
  }

  .event-detail__metadata {
    margin-bottom: 1.5rem;

    padding: 1rem;

    display: flex;
    flex-direction: column;

    gap: 0.85rem;

    background-color: rgba(21, 130, 203, 0.06);

    border-left: 4px solid var(--color-secondary);

    border-radius: var(--radius-small);
  }

  .event-detail__metadata-item {
    min-width: 0;

    display: grid;

    grid-template-columns:
      minmax(5.5rem, auto)
      minmax(0, 1fr);

    gap: 0.75rem;
  }

  .event-detail__metadata dt {
    display: flex;
    align-items: flex-start;

    gap: 0.45rem;

    color: var(--color-secondary-hover);

    font-weight: 800;
    line-height: 1.5;
  }

  .event-detail__metadata dd {
    min-width: 0;

    color: var(--color-text);

    line-height: 1.5;

    overflow-wrap: anywhere;
  }

  .event-detail__description {
    color: var(--color-text);

    line-height: 1.75;

    text-wrap: pretty;
  }

  .event-detail__description p + p {
    margin-top: 1rem;
  }

  .event-detail__description p {
    overflow-wrap: anywhere;
  }

  .event-detail__actions {
    margin-top: 1.5rem;
  }

  .event-detail__external-link {
    width: fit-content;

    padding: 0.8rem 1.15rem;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    gap: 0.5rem;

    color: var(--color-background);

    background-color: var(--color-secondary);

    border: 1px solid var(--color-secondary);

    border-radius: var(--radius-small);

    font-weight: 700;
    line-height: 1.3;
    text-decoration: none;

    transition:
      background-color var(--transition),
      border-color var(--transition),
      box-shadow var(--transition),
      transform var(--transition);
  }

  .event-detail__external-link:hover {
    background-color: var(--color-secondary-hover);

    border-color: var(--color-secondary-hover);
  }

  .event-detail__external-link:focus-visible {
    outline: none;

    box-shadow: 0 0 0 3px var(--color-secondary-light);
  }

  @media (hover: hover) {
    .event-detail-page__back:hover {
      transform: translateX(-0.2rem);
    }

    .event-detail__external-link:hover {
      transform: translateY(-2px);
    }
  }

  @media (max-width: 880px) {
    .event-detail {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 460px) {
    .event-detail__metadata-item {
      grid-template-columns: minmax(0, 1fr);

      gap: 0.25rem;
    }

    .event-detail__external-link {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .event-detail-page__back,
    .event-detail__external-link {
      transition: none;
    }
  }
</style>
