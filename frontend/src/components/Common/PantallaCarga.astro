---
const { id } = Astro.props
---

<div id={'pantalla-carga' + (id ? `-${id}` : '')} class="loading-screen">
  <div class="loading-container">
    <div class="spinner"></div>
    <h2>Cargando...</h2>
  </div>
</div>

<style>
  .loading-screen {
    /* display: flex;
    justify-content: center;
    align-items: center; */
    background-color: transparent;
    z-index: 9999;
  }

  .loading-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;

    padding: 40px 50px;
    border-radius: 20px;

    animation: fadeIn 0.5s ease;
  }

  .spinner {
    width: 70px;
    height: 70px;

    border: 6px solid #d9e2ec;
    border-top: 6px solid var(--color-primary);
    border-radius: 50%;

    animation: spin 0.8s linear infinite;
  }

  .loading-container h2 {
    margin: 0;

    font-size: 1.5rem;
    font-weight: 600;
    color: var(--color-primary-hover);
  }

  .loading-container p {
    margin: 0;
    max-width: 260px;

    text-align: center;
    color: #6b7280;
    line-height: 1.5;
    font-size: 0.95rem;
  }

  @keyframes spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
