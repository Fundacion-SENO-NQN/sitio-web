---
const IMG_URL = (
  import.meta.env.PUBLIC_IMG_URL ??
  'https://pub-508ef05ca2d548c1b336a8b1f0f31c83.r2.dev'
).replace(/\/+$/, '')

/*
 * The backend stores the donation carousel in ten fixed
 * positions:
 *
 * img_donaciones/0.avif
 * img_donaciones/1.avif
 * ...
 * img_donaciones/9.avif
 */
const IMAGE_COUNT = 10

/*
 * This value changes on every Astro build.
 *
 * Since the backend overwrites existing R2 objects while
 * keeping the same filename, this query parameter prevents
 * the browser or CDN from continuing to use an old image
 * after the automatic frontend rebuild.
 */
const buildVersion = Date.now().toString()

const images = Array.from(
  {
    length: IMAGE_COUNT
  },
  (_, index) => ({
    index,

    src: `${IMG_URL}/img_donaciones/${index}.avif` + `?v=${buildVersion}`
  })
)
---

<donation-carousel
  class="donation-carousel"
  role="region"
  aria-roledescription="carrusel"
  aria-label="Imágenes de donaciones recibidas por la Fundación SENO"
>
  <div class="donation-carousel__track" data-carousel-track aria-live="off">
    {
      images.map(({ index, src }) => (
        <img
          class="donation-carousel__slide"
          src={src}
          alt={`Donación recibida por la Fundación SENO, imagen ${index + 1}`}
          loading={index === 0 ? 'eager' : 'lazy'}
          fetchpriority={index === 0 ? 'high' : 'auto'}
          decoding="async"
          draggable="false"
          width="1920"
          height="1280"
          data-carousel-image
        />
      ))
    }
  </div>

  <p class="donation-carousel__empty" data-carousel-empty role="status" hidden>
    Las imágenes de donaciones no están disponibles en este momento.
  </p>

  <div class="donation-carousel__overlay" aria-hidden="true">
    <p>Tu donación ayuda un montón</p>
  </div>
</donation-carousel>

<script>
  const SLIDE_INTERVAL = 5000
  const TRANSITION_DURATION = 800
  const RESET_DELAY = TRANSITION_DURATION + 100

  class DonationCarousel extends HTMLElement {
    private track: HTMLElement | null = null
    private slides: HTMLImageElement[] = []

    private currentIndex = 0
    private realImages = 0

    private intervalId: number | undefined
    private resetTimerId: number | undefined
    private resizeFrameId: number | undefined

    private resizeObserver: ResizeObserver | null = null
    private abortController: AbortController | null = null

    connectedCallback(): void {
      if (this.dataset.initialized === 'true') {
        return
      }

      this.track = this.querySelector<HTMLElement>('[data-carousel-track]')

      if (!this.track) {
        this.showEmptyState()
        return
      }

      this.dataset.initialized = 'true'

      this.abortController = new AbortController()

      const { signal } = this.abortController

      this.registerImageErrors(signal)

      this.track.addEventListener('transitionend', this.handleTransitionEnd, {
        signal
      })

      this.resizeObserver = new ResizeObserver(this.handleResize)

      this.resizeObserver.observe(this)

      /*
       * Do not wait for every image to load.
       *
       * The slides already have fixed dimensions, so their
       * positions can be calculated immediately.
       */
      this.refreshSlides()
    }

    disconnectedCallback(): void {
      this.stopCarousel()
      this.clearResetTimer()

      if (this.resizeFrameId !== undefined) {
        window.cancelAnimationFrame(this.resizeFrameId)

        this.resizeFrameId = undefined
      }

      this.resizeObserver?.disconnect()
      this.resizeObserver = null

      this.abortController?.abort()
      this.abortController = null

      this.track = null
      this.slides = []

      this.currentIndex = 0
      this.realImages = 0

      delete this.dataset.initialized
    }

    /* ======================================================
       IMAGES
    ====================================================== */

    private registerImageErrors(signal: AbortSignal): void {
      const images = this.querySelectorAll<HTMLImageElement>(
        '[data-carousel-image]'
      )

      images.forEach((image) => {
        image.addEventListener(
          'error',
          () => {
            image.remove()

            this.refreshSlides()
          },
          {
            once: true,
            signal
          }
        )

        /*
         * The error may have happened before the custom
         * element was initialized.
         */
        if (image.complete && image.naturalWidth === 0) {
          image.remove()
        }
      })
    }

    private refreshSlides(): void {
      if (!this.track) {
        return
      }

      this.stopCarousel()
      this.clearResetTimer()

      /*
       * Remove the old clone before rebuilding the slide
       * collection.
       */
      this.track
        .querySelectorAll('[data-carousel-clone]')
        .forEach((clone) => clone.remove())

      const realSlides = Array.from(
        this.track.querySelectorAll<HTMLImageElement>('[data-carousel-image]')
      )

      this.realImages = realSlides.length
      this.currentIndex = 0

      if (this.realImages === 0) {
        this.slides = []

        this.showEmptyState()
        return
      }

      this.hideEmptyState()

      if (this.realImages === 1) {
        this.slides = realSlides

        this.repositionWithoutAnimation()
        return
      }

      /*
       * Clone the first slide so the last forward movement
       * remains continuous.
       */
      const clone = realSlides[0].cloneNode(true) as HTMLImageElement

      clone.alt = ''
      clone.loading = 'eager'
      clone.fetchPriority = 'auto'

      clone.removeAttribute('data-carousel-image')

      clone.setAttribute('data-carousel-clone', '')

      clone.setAttribute('aria-hidden', 'true')

      clone.classList.add('donation-carousel__slide--clone')

      this.track.appendChild(clone)

      this.slides = [...realSlides, clone]

      window.requestAnimationFrame(() => {
        if (!this.isConnected) {
          return
        }

        this.repositionWithoutAnimation()
        this.startCarousel()
      })
    }

    /* ======================================================
       MOVEMENT
    ====================================================== */

    private startCarousel(): void {
      if (this.realImages <= 1 || this.intervalId !== undefined) {
        return
      }

      this.intervalId = window.setInterval(this.moveToNextSlide, SLIDE_INTERVAL)
    }

    private stopCarousel(): void {
      if (this.intervalId === undefined) {
        return
      }

      window.clearInterval(this.intervalId)

      this.intervalId = undefined
    }

    private moveToNextSlide = (): void => {
      if (!this.track || this.realImages <= 1) {
        return
      }

      /*
       * Recover defensively if the previous clone reset did
       * not execute.
       */
      if (this.currentIndex >= this.realImages) {
        this.resetToFirstSlide()
      }

      this.currentIndex += 1

      this.setTransform()

      /*
       * transitionend normally resets the carousel after
       * reaching the clone. This timer is a fallback for
       * browsers or CSS configurations where transitionend
       * is not emitted.
       */
      if (this.currentIndex === this.realImages) {
        this.clearResetTimer()

        this.resetTimerId = window.setTimeout(() => {
          this.resetTimerId = undefined

          if (this.currentIndex === this.realImages) {
            this.resetToFirstSlide()
          }
        }, RESET_DELAY)
      }
    }

    private setTransform(): void {
      if (!this.track) {
        return
      }

      const currentSlide = this.slides[this.currentIndex]

      if (!currentSlide) {
        return
      }

      this.track.style.transform = `translate3d(-${currentSlide.offsetLeft}px, 0, 0)`
    }

    private resetToFirstSlide(): void {
      this.clearResetTimer()

      this.currentIndex = 0

      this.repositionWithoutAnimation()
    }

    private repositionWithoutAnimation(): void {
      if (!this.track) {
        return
      }

      this.track.style.transition = 'none'

      this.setTransform()

      /*
       * Force the browser to apply the position before
       * restoring the CSS transition.
       */
      this.track.getBoundingClientRect()

      this.track.style.removeProperty('transition')
    }

    private handleTransitionEnd = (event: TransitionEvent): void => {
      if (
        event.propertyName !== 'transform' ||
        this.currentIndex !== this.realImages
      ) {
        return
      }

      this.resetToFirstSlide()
    }

    private clearResetTimer(): void {
      if (this.resetTimerId === undefined) {
        return
      }

      window.clearTimeout(this.resetTimerId)

      this.resetTimerId = undefined
    }

    /* ======================================================
       RESIZE
    ====================================================== */

    private handleResize = (): void => {
      if (this.resizeFrameId !== undefined) {
        window.cancelAnimationFrame(this.resizeFrameId)
      }

      this.resizeFrameId = window.requestAnimationFrame(() => {
        this.resizeFrameId = undefined

        this.repositionWithoutAnimation()
      })
    }

    /* ======================================================
       EMPTY STATE
    ====================================================== */

    private showEmptyState(): void {
      this.stopCarousel()
      this.clearResetTimer()

      this.track?.setAttribute('hidden', '')

      const emptyElement = this.querySelector<HTMLElement>(
        '[data-carousel-empty]'
      )

      if (emptyElement) {
        emptyElement.hidden = false
      }

      this.classList.add('donation-carousel--empty')
    }

    private hideEmptyState(): void {
      this.track?.removeAttribute('hidden')

      const emptyElement = this.querySelector<HTMLElement>(
        '[data-carousel-empty]'
      )

      if (emptyElement) {
        emptyElement.hidden = true
      }

      this.classList.remove('donation-carousel--empty')
    }
  }

  if (!customElements.get('donation-carousel')) {
    customElements.define('donation-carousel', DonationCarousel)
  }
</script>

<style>
  .donation-carousel {
    width: 100%;
    max-width: 100%;
    height: clamp(17rem, 35vw, 25rem);

    position: relative;

    display: block;

    overflow: hidden;

    background-color: var(--color-secondary-light);
  }

  .donation-carousel__track {
    width: 100%;
    height: 100%;

    display: flex;

    transform: translate3d(0, 0, 0);

    transition: transform 800ms ease-in-out;

    will-change: transform;
  }

  .donation-carousel__slide {
    width: clamp(18rem, 38vw, 32rem);
    height: 100%;

    display: block;

    flex: 0 0 clamp(18rem, 38vw, 32rem);

    object-fit: cover;
    object-position: center;

    user-select: none;
    pointer-events: none;
  }

  .donation-carousel__empty {
    width: min(calc(100% - 2rem), 38rem);

    margin: 0;
    padding: 1.25rem;

    position: absolute;
    top: 50%;
    left: 50%;

    z-index: 1;

    color: var(--color-text);
    background-color: rgba(255, 255, 255, 0.9);

    border-radius: var(--radius-small);

    line-height: 1.6;
    text-align: center;

    transform: translate(-50%, -50%);
  }

  .donation-carousel__overlay {
    position: absolute;
    inset: 0;

    display: flex;
    align-items: flex-end;

    background: rgba(18, 18, 18, 0.25);

    pointer-events: none;
  }

  .donation-carousel--empty .donation-carousel__overlay {
    display: none;
  }

  .donation-carousel__overlay p {
    width: 100%;

    padding: clamp(0.75rem, 2vw, 1.25rem);

    color: var(--color-text);
    background: rgba(144, 184, 214, 0.86);

    font-family: var(--text-font-logo);
    font-size: clamp(1.8rem, 5vw, 3.5rem);
    line-height: 1.1;
    text-align: center;
    text-wrap: balance;
  }

  @media (max-width: 900px) {
    .donation-carousel {
      height: clamp(16rem, 48vw, 22rem);
    }

    .donation-carousel__slide {
      width: 65%;

      flex-basis: 65%;
    }
  }

  @media (max-width: 600px) {
    .donation-carousel {
      height: clamp(15rem, 75vw, 21rem);
    }

    .donation-carousel__slide {
      width: 100%;

      flex-basis: 100%;
    }

    .donation-carousel__overlay p {
      padding: 0.8rem 1rem;

      font-size: clamp(1.6rem, 8vw, 2.4rem);
    }
  }

  @media (max-width: 380px) {
    .donation-carousel {
      height: 16rem;
    }

    .donation-carousel__overlay p {
      font-size: 1.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .donation-carousel__track {
      transition: none;
    }
  }
</style>
