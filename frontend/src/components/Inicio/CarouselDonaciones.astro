---
const IMG_URL = (
  import.meta.env.PUBLIC_IMG_URL ??
  'https://pub-508ef05ca2d548c1b336a8b1f0f31c83.r2.dev'
).replace(/\/+$/, '')

/*
 * The backend stores the donation carousel in ten fixed
 * positions:
 *
 * img_donaciones/0.avif
 * img_donaciones/1.avif
 * ...
 * img_donaciones/9.avif
 */
const IMAGE_COUNT = 10

/*
 * This value changes on every Astro build.
 *
 * Since the backend overwrites existing R2 objects while
 * keeping the same filename, this query parameter prevents
 * the browser or CDN from continuing to use an old image
 * after the automatic frontend rebuild.
 */
const buildVersion = Date.now().toString()

const images = Array.from(
  {
    length: IMAGE_COUNT
  },
  (_, index) => ({
    index,

    src: `${IMG_URL}/img_donaciones/${index}.avif` + `?v=${buildVersion}`
  })
)
---

<donation-carousel
  class="donation-carousel"
  role="region"
  aria-roledescription="carrusel"
  aria-label="Imágenes de donaciones recibidas por la Fundación SENO"
>
  <div class="donation-carousel__track" data-carousel-track aria-live="off">
    {
      images.map(({ index, src }) => (
        <img
          class="donation-carousel__slide"
          src={src}
          alt={`Donación recibida por la Fundación SENO, imagen ${index + 1}`}
          loading={index === 0 ? 'eager' : 'lazy'}
          fetchpriority={index === 0 ? 'high' : 'auto'}
          decoding="async"
          draggable="false"
          width="1920"
          height="1280"
          data-carousel-image
        />
      ))
    }
  </div>

  <p class="donation-carousel__empty" data-carousel-empty role="status" hidden>
    Las imágenes de donaciones no están disponibles en este momento.
  </p>

  <div class="donation-carousel__overlay" aria-hidden="true">
    <p>Tu donación ayuda un montón</p>
  </div>
</donation-carousel>

<script>
  const SLIDE_INTERVAL = 5000

  class DonationCarousel extends HTMLElement {
    private track: HTMLElement | null = null

    private slides: HTMLImageElement[] = []

    private currentIndex = 0
    private realImages = 0

    private intervalId: number | undefined
    private resizeFrame: number | undefined

    private interactionPaused = false

    private resizeObserver: ResizeObserver | null = null

    private reducedMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    )

    private abortController: AbortController | null = null

    connectedCallback(): void {
      if (this.dataset.initialized) {
        return
      }

      this.dataset.initialized = 'pending'

      this.initialize().catch((error) => {
        console.error(
          'No se pudo inicializar el carrusel de donaciones:',
          error
        )

        this.showEmptyState()
      })
    }

    disconnectedCallback(): void {
      this.stopCarousel()

      if (this.resizeFrame !== undefined) {
        window.cancelAnimationFrame(this.resizeFrame)
        this.resizeFrame = undefined
      }

      this.resizeObserver?.disconnect()
      this.resizeObserver = null

      this.reducedMotion.removeEventListener(
        'change',
        this.handleReducedMotionChange
      )

      this.abortController?.abort()
      this.abortController = null

      this.slides = []
      this.realImages = 0
      this.currentIndex = 0

      delete this.dataset.initialized
    }

    private async initialize(): Promise<void> {
      this.track = this.querySelector<HTMLElement>('[data-carousel-track]')

      if (!this.track) {
        this.showEmptyState()
        return
      }

      this.abortController = new AbortController()

      const { signal } = this.abortController

      const initialImages = Array.from(
        this.querySelectorAll<HTMLImageElement>('[data-carousel-image]')
      )

      const imageResults = await Promise.all(
        initialImages.map((image) => waitForImage(image, signal))
      )

      if (signal.aborted || !this.isConnected) {
        return
      }

      const validImages: HTMLImageElement[] = []

      initialImages.forEach((image, index) => {
        if (imageResults[index]) {
          validImages.push(image)
        } else {
          image.remove()
        }
      })

      this.realImages = validImages.length

      if (this.realImages === 0) {
        this.showEmptyState()
        return
      }

      this.hideEmptyState()

      /*
       * The last slide is a clone of the first valid image.
       *
       * When the transition reaches this clone, the track
       * immediately returns to the original first slide
       * without animation.
       */
      if (this.realImages > 1) {
        const firstImage = validImages[0]

        const clonedImage = firstImage.cloneNode(true) as HTMLImageElement

        clonedImage.alt = ''
        clonedImage.loading = 'lazy'
        clonedImage.fetchPriority = 'auto'

        clonedImage.removeAttribute('data-carousel-image')

        clonedImage.setAttribute('aria-hidden', 'true')

        clonedImage.classList.add('donation-carousel__slide--clone')

        this.track.appendChild(clonedImage)

        this.slides = [...validImages, clonedImage]
      } else {
        this.slides = validImages
      }

      this.currentIndex = 0
      this.dataset.initialized = 'true'

      this.repositionWithoutAnimation()

      if (this.realImages <= 1) {
        return
      }

      this.registerEvents(signal)

      this.resizeObserver = new ResizeObserver(this.handleResize)

      this.resizeObserver.observe(this)

      this.updateMotionPreference()
      this.startCarousel()
    }

    private registerEvents(signal: AbortSignal): void {
      this.track?.addEventListener('transitionend', this.handleTransitionEnd, {
        signal
      })

      this.addEventListener('mouseenter', this.handleInteractionStart, {
        signal
      })

      this.addEventListener('mouseleave', this.handleInteractionEnd, {
        signal
      })

      this.addEventListener('focusin', this.handleInteractionStart, {
        signal
      })

      this.addEventListener('focusout', this.handleFocusOut, {
        signal
      })

      document.addEventListener(
        'visibilitychange',
        this.handleVisibilityChange,
        {
          signal
        }
      )

      this.reducedMotion.addEventListener(
        'change',
        this.handleReducedMotionChange
      )
    }

    private setTransform(): void {
      if (!this.track) {
        return
      }

      const currentSlide = this.slides[this.currentIndex]

      if (!currentSlide) {
        return
      }

      this.track.style.transform = `translate3d(-${currentSlide.offsetLeft}px, 0, 0)`
    }

    private repositionWithoutAnimation(): void {
      if (!this.track) {
        return
      }

      this.track.style.transition = 'none'

      this.setTransform()

      /*
       * Force the browser to apply the position before
       * restoring the CSS transition.
       */
      this.track.getBoundingClientRect()

      this.track.style.removeProperty('transition')
    }

    private moveToNextSlide = (): void => {
      if (this.realImages <= 1 || this.currentIndex >= this.realImages) {
        return
      }

      this.currentIndex += 1

      this.setTransform()
    }

    private startCarousel(): void {
      if (
        this.realImages <= 1 ||
        this.reducedMotion.matches ||
        this.interactionPaused ||
        document.hidden ||
        this.intervalId !== undefined
      ) {
        return
      }

      this.intervalId = window.setInterval(this.moveToNextSlide, SLIDE_INTERVAL)
    }

    private stopCarousel(): void {
      if (this.intervalId === undefined) {
        return
      }

      window.clearInterval(this.intervalId)

      this.intervalId = undefined
    }

    private updateMotionPreference(): void {
      if (!this.reducedMotion.matches) {
        return
      }

      this.stopCarousel()

      this.currentIndex = 0

      this.repositionWithoutAnimation()
    }

    private handleTransitionEnd = (event: TransitionEvent): void => {
      if (
        event.propertyName !== 'transform' ||
        this.currentIndex !== this.realImages
      ) {
        return
      }

      this.currentIndex = 0

      this.repositionWithoutAnimation()
    }

    private handleInteractionStart = (): void => {
      this.interactionPaused = true

      this.stopCarousel()
    }

    private handleInteractionEnd = (): void => {
      this.interactionPaused = false

      this.startCarousel()
    }

    private handleFocusOut = (event: FocusEvent): void => {
      const nextFocusedElement = event.relatedTarget

      if (
        nextFocusedElement instanceof Node &&
        this.contains(nextFocusedElement)
      ) {
        return
      }

      this.handleInteractionEnd()
    }

    private handleVisibilityChange = (): void => {
      if (document.hidden) {
        this.stopCarousel()
      } else {
        this.startCarousel()
      }
    }

    private handleReducedMotionChange = (): void => {
      this.updateMotionPreference()

      if (!this.reducedMotion.matches) {
        this.startCarousel()
      }
    }

    private handleResize = (): void => {
      if (this.resizeFrame !== undefined) {
        window.cancelAnimationFrame(this.resizeFrame)
      }

      this.resizeFrame = window.requestAnimationFrame(() => {
        this.resizeFrame = undefined

        this.repositionWithoutAnimation()
      })
    }

    private showEmptyState(): void {
      this.stopCarousel()

      this.track?.setAttribute('hidden', '')

      const emptyElement = this.querySelector<HTMLElement>(
        '[data-carousel-empty]'
      )

      if (emptyElement) {
        emptyElement.hidden = false
      }

      this.classList.add('donation-carousel--empty')
    }

    private hideEmptyState(): void {
      this.track?.removeAttribute('hidden')

      const emptyElement = this.querySelector<HTMLElement>(
        '[data-carousel-empty]'
      )

      if (emptyElement) {
        emptyElement.hidden = true
      }

      this.classList.remove('donation-carousel--empty')
    }
  }

  function waitForImage(
    image: HTMLImageElement,
    signal: AbortSignal
  ): Promise<boolean> {
    if (image.complete) {
      return Promise.resolve(image.naturalWidth > 0)
    }

    return new Promise((resolve) => {
      let completed = false

      const finish = (valid: boolean): void => {
        if (completed) {
          return
        }

        completed = true

        resolve(valid)
      }

      image.addEventListener('load', () => finish(true), {
        once: true,
        signal
      })

      image.addEventListener('error', () => finish(false), {
        once: true,
        signal
      })

      signal.addEventListener('abort', () => finish(false), {
        once: true
      })
    })
  }

  if (!customElements.get('donation-carousel')) {
    customElements.define('donation-carousel', DonationCarousel)
  }
</script>

<style>
  .donation-carousel {
    width: 100%;
    max-width: 100%;
    height: clamp(17rem, 35vw, 25rem);

    position: relative;

    display: block;

    overflow: hidden;

    background-color: var(--color-secondary-light);
  }

  .donation-carousel__track {
    width: 100%;
    height: 100%;

    display: flex;

    transform: translate3d(0, 0, 0);

    transition: transform 800ms ease-in-out;

    will-change: transform;
  }

  .donation-carousel__slide {
    width: clamp(18rem, 38vw, 32rem);
    height: 100%;

    display: block;

    flex: 0 0 clamp(18rem, 38vw, 32rem);

    object-fit: cover;
    object-position: center;

    user-select: none;
    pointer-events: none;
  }

  .donation-carousel__empty {
    width: min(calc(100% - 2rem), 38rem);

    margin: 0;
    padding: 1.25rem;

    position: absolute;
    top: 50%;
    left: 50%;

    z-index: 1;

    color: var(--color-text);
    background-color: rgba(255, 255, 255, 0.9);

    border-radius: var(--radius-small);

    line-height: 1.6;
    text-align: center;

    transform: translate(-50%, -50%);
  }

  .donation-carousel__overlay {
    position: absolute;
    inset: 0;

    display: flex;
    align-items: flex-end;

    background: rgba(18, 18, 18, 0.25);

    pointer-events: none;
  }

  .donation-carousel--empty .donation-carousel__overlay {
    display: none;
  }

  .donation-carousel__overlay p {
    width: 100%;

    padding: clamp(0.75rem, 2vw, 1.25rem);

    color: var(--color-text);
    background: rgba(144, 184, 214, 0.86);

    font-family: var(--text-font-logo);
    font-size: clamp(1.8rem, 5vw, 3.5rem);
    line-height: 1.1;
    text-align: center;
    text-wrap: balance;
  }

  @media (max-width: 900px) {
    .donation-carousel {
      height: clamp(16rem, 48vw, 22rem);
    }

    .donation-carousel__slide {
      width: 65%;

      flex-basis: 65%;
    }
  }

  @media (max-width: 600px) {
    .donation-carousel {
      height: clamp(15rem, 75vw, 21rem);
    }

    .donation-carousel__slide {
      width: 100%;

      flex-basis: 100%;
    }

    .donation-carousel__overlay p {
      padding: 0.8rem 1rem;

      font-size: clamp(1.6rem, 8vw, 2.4rem);
    }
  }

  @media (max-width: 380px) {
    .donation-carousel {
      height: 16rem;
    }

    .donation-carousel__overlay p {
      font-size: 1.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .donation-carousel__track {
      transition: none;
    }
  }
</style>
