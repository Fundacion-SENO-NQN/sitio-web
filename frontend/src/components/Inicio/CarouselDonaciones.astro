---
import { Image } from 'astro:assets'

import Img0 from '../../assets/img_donaciones/0.avif'
import Img1 from '../../assets/img_donaciones/1.avif'
import Img2 from '../../assets/img_donaciones/2.avif'
import Img3 from '../../assets/img_donaciones/3.avif'
import Img4 from '../../assets/img_donaciones/4.avif'
import Img5 from '../../assets/img_donaciones/5.avif'
import Img6 from '../../assets/img_donaciones/6.avif'
import Img7 from '../../assets/img_donaciones/7.avif'
import Img8 from '../../assets/img_donaciones/8.avif'
import Img9 from '../../assets/img_donaciones/9.avif'

const images: ImageMetadata[] = [
  Img0,
  Img1,
  Img2,
  Img3,
  Img4,
  Img5,
  Img6,
  Img7,
  Img8,
  Img9
]

/*
 * Se duplica la primera imagen al final.
 * Al llegar a la copia, el carrusel vuelve a la imagen
 * original sin animación para generar un bucle continuo.
 */
const carouselImages = [...images, images[0]]
---

<donation-carousel
  class="donation-carousel"
  data-real-images={images.length}
  role="region"
  aria-roledescription="carrusel"
  aria-label="Imágenes de donaciones recibidas por la Fundación SENO"
>
  <div class="donation-carousel__track" data-carousel-track aria-live="off">
    {
      carouselImages.map((image, index) => {
        const isClone = index === images.length

        return (
          <Image
            class="donation-carousel__slide"
            src={image}
            alt={
              isClone
                ? ''
                : `Donación recibida por la Fundación SENO, imagen ${index + 1}`
            }
            loading={index === 0 ? 'eager' : 'lazy'}
            fetchpriority={index === 0 ? 'high' : 'auto'}
            decoding="async"
            draggable="false"
            aria-hidden={isClone ? 'true' : undefined}
          />
        )
      })
    }
  </div>

  <div class="donation-carousel__overlay" aria-hidden="true">
    <p>Tu donación ayuda un montón</p>
  </div>
</donation-carousel>

<script>
  const SLIDE_INTERVAL = 5000

  class DonationCarousel extends HTMLElement {
    private track: HTMLElement | null = null
    private slides: HTMLElement[] = []

    private currentIndex = 0
    private realImages = 0
    private intervalId: number | undefined
    private resizeFrame: number | undefined

    private interactionPaused = false

    private resizeObserver: ResizeObserver | null = null
    private reducedMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    )

    private abortController: AbortController | null = null

    connectedCallback(): void {
      if (this.dataset.initialized === 'true') {
        return
      }

      this.track = this.querySelector<HTMLElement>('[data-carousel-track]')

      this.slides = Array.from(
        this.querySelectorAll<HTMLElement>('.donation-carousel__slide')
      )

      this.realImages = Number.parseInt(this.dataset.realImages ?? '0', 10)

      if (!this.track || this.slides.length <= 1 || this.realImages <= 1) {
        return
      }

      this.dataset.initialized = 'true'
      this.abortController = new AbortController()

      const { signal } = this.abortController

      this.track.addEventListener('transitionend', this.handleTransitionEnd, {
        signal
      })

      this.addEventListener('mouseenter', this.handleInteractionStart, {
        signal
      })

      this.addEventListener('mouseleave', this.handleInteractionEnd, { signal })

      this.addEventListener('focusin', this.handleInteractionStart, { signal })

      this.addEventListener('focusout', this.handleFocusOut, { signal })

      document.addEventListener(
        'visibilitychange',
        this.handleVisibilityChange,
        { signal }
      )

      this.reducedMotion.addEventListener(
        'change',
        this.handleReducedMotionChange
      )

      this.resizeObserver = new ResizeObserver(this.handleResize)

      this.resizeObserver.observe(this)

      this.updateMotionPreference()
      this.repositionWithoutAnimation()
      this.startCarousel()
    }

    disconnectedCallback(): void {
      this.stopCarousel()

      if (this.resizeFrame !== undefined) {
        window.cancelAnimationFrame(this.resizeFrame)
      }

      this.resizeObserver?.disconnect()
      this.resizeObserver = null

      this.reducedMotion.removeEventListener(
        'change',
        this.handleReducedMotionChange
      )

      this.abortController?.abort()
      this.abortController = null

      delete this.dataset.initialized
    }

    private setTransform(): void {
      if (!this.track) return

      const currentSlide = this.slides[this.currentIndex]

      if (!currentSlide) return

      this.track.style.transform = `translate3d(-${currentSlide.offsetLeft}px, 0, 0)`
    }

    private repositionWithoutAnimation(): void {
      if (!this.track) return

      this.track.style.transition = 'none'

      this.setTransform()

      /*
       * Fuerza al navegador a aplicar la posición antes de
       * volver a habilitar la transición definida en CSS.
       */
      this.track.getBoundingClientRect()

      this.track.style.removeProperty('transition')
    }

    private moveToNextSlide = (): void => {
      this.currentIndex += 1
      this.setTransform()
    }

    private startCarousel(): void {
      if (
        this.reducedMotion.matches ||
        this.interactionPaused ||
        document.hidden ||
        this.intervalId !== undefined
      ) {
        return
      }

      this.intervalId = window.setInterval(this.moveToNextSlide, SLIDE_INTERVAL)
    }

    private stopCarousel(): void {
      if (this.intervalId === undefined) {
        return
      }

      window.clearInterval(this.intervalId)
      this.intervalId = undefined
    }

    private updateMotionPreference(): void {
      if (!this.reducedMotion.matches) {
        return
      }

      this.stopCarousel()

      this.currentIndex = 0
      this.repositionWithoutAnimation()
    }

    private handleTransitionEnd = (event: TransitionEvent): void => {
      if (
        event.propertyName !== 'transform' ||
        this.currentIndex !== this.realImages
      ) {
        return
      }

      this.currentIndex = 0
      this.repositionWithoutAnimation()
    }

    private handleInteractionStart = (): void => {
      this.interactionPaused = true
      this.stopCarousel()
    }

    private handleInteractionEnd = (): void => {
      this.interactionPaused = false
      this.startCarousel()
    }

    private handleFocusOut = (event: FocusEvent): void => {
      const nextFocusedElement = event.relatedTarget

      if (
        nextFocusedElement instanceof Node &&
        this.contains(nextFocusedElement)
      ) {
        return
      }

      this.handleInteractionEnd()
    }

    private handleVisibilityChange = (): void => {
      if (document.hidden) {
        this.stopCarousel()
      } else {
        this.startCarousel()
      }
    }

    private handleReducedMotionChange = (): void => {
      this.updateMotionPreference()

      if (!this.reducedMotion.matches) {
        this.startCarousel()
      }
    }

    private handleResize = (): void => {
      if (this.resizeFrame !== undefined) {
        window.cancelAnimationFrame(this.resizeFrame)
      }

      this.resizeFrame = window.requestAnimationFrame(() => {
        this.repositionWithoutAnimation()
      })
    }
  }

  if (!customElements.get('donation-carousel')) {
    customElements.define('donation-carousel', DonationCarousel)
  }
</script>

<style>
  .donation-carousel {
    width: 100%;
    max-width: 100%;
    height: clamp(17rem, 35vw, 25rem);

    position: relative;

    display: block;

    overflow: hidden;

    background-color: var(--color-secondary-light);
  }

  .donation-carousel__track {
    width: 100%;
    height: 100%;

    display: flex;

    transform: translate3d(0, 0, 0);

    transition: transform 800ms ease-in-out;

    will-change: transform;
  }

  .donation-carousel__slide {
    width: clamp(18rem, 38vw, 32rem);

    height: 100%;

    flex: 0 0 clamp(18rem, 38vw, 32rem);

    object-fit: cover;
    object-position: center;

    user-select: none;
    pointer-events: none;
  }

  .donation-carousel__overlay {
    position: absolute;
    inset: 0;

    display: flex;
    align-items: flex-end;

    background: rgba(18, 18, 18, 0.25);

    pointer-events: none;
  }

  .donation-carousel__overlay p {
    width: 100%;

    padding: clamp(0.75rem, 2vw, 1.25rem);

    color: var(--color-text);

    background: rgba(144, 184, 214, 0.86);

    font-family: var(--text-font-logo);

    font-size: clamp(1.8rem, 5vw, 3.5rem);

    line-height: 1.1;
    text-align: center;
    text-wrap: balance;
  }

  .donation-carousel__toggle {
    min-height: 2.5rem;

    padding: 0.55rem 0.8rem;

    position: absolute;
    top: 1rem;
    right: 1rem;

    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;

    color: #ffffff;

    background-color: rgba(0, 0, 0, 0.66);

    border: 1px solid rgba(255, 255, 255, 0.3);

    border-radius: 999px;

    font-size: 0.82rem;
    font-weight: 700;
    line-height: 1;

    backdrop-filter: blur(5px);

    cursor: pointer;

    transition:
      background-color var(--transition),
      border-color var(--transition),
      box-shadow var(--transition),
      transform var(--transition);
  }

  .donation-carousel__toggle:hover {
    background-color: rgba(0, 0, 0, 0.86);

    border-color: rgba(255, 255, 255, 0.65);
  }

  .donation-carousel__toggle:focus-visible {
    outline: none;

    box-shadow: 0 0 0 3px var(--color-primary);
  }

  .donation-carousel__toggle-icon {
    min-width: 0.9rem;

    display: inline-flex;
    justify-content: center;

    font-size: 0.8rem;
    line-height: 1;
  }

  @media (hover: hover) {
    .donation-carousel__toggle:hover {
      transform: translateY(-1px);
    }
  }

  @media (max-width: 900px) {
    .donation-carousel {
      height: clamp(16rem, 48vw, 22rem);
    }

    .donation-carousel__slide {
      width: 65%;

      flex-basis: 65%;
    }
  }

  @media (max-width: 600px) {
    .donation-carousel {
      height: clamp(15rem, 75vw, 21rem);
    }

    .donation-carousel__slide {
      width: 100%;

      flex-basis: 100%;
    }

    .donation-carousel__overlay p {
      padding: 0.8rem 1rem;

      font-size: clamp(1.6rem, 8vw, 2.4rem);
    }

    .donation-carousel__toggle {
      top: 0.65rem;
      right: 0.65rem;

      padding: 0.5rem 0.65rem;
    }
  }

  @media (max-width: 380px) {
    .donation-carousel {
      height: 16rem;
    }

    .donation-carousel__overlay p {
      font-size: 1.5rem;
    }

    .donation-carousel__toggle span:last-child {
      display: none;
    }

    .donation-carousel__toggle {
      width: 2.5rem;
      padding: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .donation-carousel__track,
    .donation-carousel__toggle {
      transition: none;
    }
  }
</style>
