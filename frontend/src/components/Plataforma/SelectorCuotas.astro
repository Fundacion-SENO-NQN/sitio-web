---
export interface OpcionEstadoCuota {
  value: number
  label: string
}

export interface Props {
  servicio?: string
  cantidad?: number
  titulo?: string
  descripcion?: string
  opciones?: OpcionEstadoCuota[]
}

const {
  servicio = 'bingo',
  cantidad = 8,
  titulo = 'Cuotas',
  descripcion = 'Indicá el estado de cada cuota. Podés hacer clic en el recuadro o seleccionar el medio de pago.',
  opciones = [
    { value: 0, label: 'Sin pagar' },
    { value: 1, label: 'Efectivo (E)' },
    { value: 2, label: 'Transferencia (T)' }
  ]
} = Astro.props

const indices = Array.from({ length: cantidad }, (_, index) => index)
---

<section
  class="formSection cuotasEditor"
  data-cuotas-editor={servicio}
  aria-labelledby={`cuotas-titulo-${servicio}`}
>
  <header class="formSectionHeader cuotasEditor__header">
    <div class="cuotasEditor__heading">
      <div>
        <h3 id={`cuotas-titulo-${servicio}`}>{titulo}</h3>
        {descripcion && <p>{descripcion}</p>}
      </div>

      <ul class="cuotasLegend" aria-label="Referencias de colores de cuotas">
        <li class="cuotasLegend__item">
          <span class="cuotaSquare cuotaSquare--paid" aria-hidden="true">
            E
          </span>
          <span>Pagada (E/T)</span>
        </li>
        <li class="cuotasLegend__item">
          <span
            class="cuotaSquare cuotaSquare--pending"
            aria-hidden="true"
          ></span>
          <span>Sin pagar</span>
        </li>
        <li class="cuotasLegend__item">
          <span
            class="cuotaSquare cuotaSquare--late"
            aria-hidden="true"
          ></span>
          <span>Fuera de término</span>
        </li>
      </ul>
    </div>
  </header>

  <div class="cuotasEditor__grid">
    {
      indices.map((index) => {
        const selectId = `${servicio}-cuota-${index}`

        return (
          <div class="cuotaCard" data-cuota-card={index}>
            <div class="cuotaCard__top">
              <button
                type="button"
                class="cuotaSquare cuotaSquare--interactive cuotaSquare--pending"
                data-cuota-square={index}
                aria-label={`Alternar estado de la cuota ${index + 1}`}
                title={`Cambiar estado de la cuota ${index + 1}`}
              />

              <div class="cuotaCard__meta">
                <label class="cuotaCard__title" for={selectId}>
                  Cuota {index + 1}
                </label>
                <small class="cuotaCard__month" data-cuota-month={index}>
                  Mes {index + 1}
                </small>
              </div>
            </div>

            <select
              id={selectId}
              class="formControl cuotaCard__select"
              data-cuota-select={index}
            >
              {opciones.map((opcion) => (
                <option value={String(opcion.value)}>{opcion.label}</option>
              ))}
            </select>
          </div>
        )
      })
    }
  </div>
</section>

<style>
  .cuotasEditor__heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--admin-space-medium);
    flex-wrap: wrap;
  }

  .cuotasLegend {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex-wrap: wrap;
  }

  .cuotasLegend__item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--admin-text-muted);
    font-size: 0.78rem;
    font-weight: 650;
    white-space: nowrap;
  }

  .cuotaSquare {
    width: 1.65rem;
    height: 1.65rem;
    padding: 0;
    display: inline-grid;
    place-items: center;
    flex: 0 0 auto;
    border-radius: 0.34rem;
    border: 1px solid transparent;
    font-family: inherit;
    font-size: 0.72rem;
    font-weight: 800;
    line-height: 1;
    letter-spacing: 0.01em;
    font-variant-numeric: tabular-nums;
    user-select: none;
    transition:
      transform var(--admin-transition),
      box-shadow var(--admin-transition),
      background-color var(--admin-transition),
      border-color var(--admin-transition);
  }

  .cuotasLegend__item .cuotaSquare {
    width: 1.25rem;
    height: 1.25rem;
    font-size: 0.65rem;
    border-radius: 0.28rem;
  }

  .cuotaSquare--paid {
    color: #ffffff;
    background-color: var(--color-primary);
    border-color: var(--color-primary-hover);
    box-shadow: 0 1px 2px rgba(73, 107, 36, 0.22);
  }

  .cuotaSquare--pending {
    color: #555e68;
    background-color: #d8dde3;
    border-color: #b8c0ca;
  }

  .cuotaSquare--late {
    color: #4a4300;
    background-color: var(--color-yellow);
    border-color: #b5a800;
    box-shadow: 0 1px 2px rgba(140, 128, 0, 0.2);
  }

  .cuotaSquare--interactive {
    cursor: pointer;
  }

  .cuotaSquare--interactive:hover:not(:disabled) {
    transform: scale(1.08);
  }

  .cuotaSquare--interactive:active:not(:disabled) {
    transform: scale(0.98);
  }

  .cuotaSquare--interactive:focus-visible {
    outline: none;
    box-shadow: var(--admin-focus);
  }

  .cuotaSquare--interactive:disabled {
    opacity: 0.55;
    cursor: not-allowed;
    transform: none;
  }

  .cuotasEditor__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.85rem;
  }

  .cuotaCard {
    padding: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    background-color: var(--admin-surface);
    border: var(--admin-border);
    border-radius: var(--admin-radius-small);
    transition:
      border-color var(--admin-transition),
      box-shadow var(--admin-transition),
      background-color var(--admin-transition);
  }

  .cuotaCard[data-status='paid'] {
    border-color: var(--color-primary-light);
    background-color: rgba(131, 192, 67, 0.05);
  }

  .cuotaCard[data-status='late'] {
    border-color: rgba(181, 168, 0, 0.45);
    background-color: rgba(221, 221, 34, 0.07);
  }

  .cuotaCard__top {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .cuotaCard__meta {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .cuotaCard__title {
    color: var(--admin-text);
    font-size: 0.84rem;
    font-weight: 750;
    line-height: 1.2;
    cursor: pointer;
  }

  .cuotaCard__month {
    color: var(--admin-text-muted);
    font-size: 0.75rem;
    line-height: 1.2;
  }

  .cuotaCard__select {
    min-height: 2.35rem;
    padding: 0.45rem 2.1rem 0.45rem 0.65rem;
    font-size: 0.84rem;
  }

  @media (max-width: 820px) {
    .cuotasEditor__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 420px) {
    .cuotasEditor__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cuotaSquare,
    .cuotaCard {
      transition: none;
    }
  }
</style>
