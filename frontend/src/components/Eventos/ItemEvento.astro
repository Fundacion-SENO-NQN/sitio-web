---
import type Evento from '../../data/interfaces/Evento'

interface Props {
  evento: Evento
  priority?: boolean
}

const { evento, priority = false } = Astro.props

const IMG_URL = (
  import.meta.env.PUBLIC_IMG_URL ??
  'https://pub-508ef05ca2d548c1b336a8b1f0f31c83.r2.dev'
).replace(/\/+$/, '')

const eventUrl = `/eventos/${evento.id}`
const imageUrl = `${IMG_URL}/img_eventos/${evento.id}/0.avif`

const hasMetadata = Boolean(evento.fecha || evento.horario || evento.lugar)
---

<article class="event-card">
  <a
    class="event-card__image-link"
    href={eventUrl}
    aria-label={`Ver evento: ${evento.titulo}`}
  >
    <img
      class="event-card__image"
      src={imageUrl}
      alt=""
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      decoding="async"
      width="1200"
      height="750"
    />
  </a>

  <div class="event-card__content">
    {
      hasMetadata && (
        <ul class="event-card__metadata" aria-label="Información del evento">
          {evento.fecha && (
            <li class="event-card__metadata-item">
              <span class="event-card__metadata-icon" aria-hidden="true">
                📅
              </span>

              <span>{evento.fecha}</span>
            </li>
          )}

          {evento.horario && (
            <li class="event-card__metadata-item">
              <span class="event-card__metadata-icon" aria-hidden="true">
                🕒
              </span>

              <span>{evento.horario}</span>
            </li>
          )}

          {evento.lugar && (
            <li class="event-card__metadata-item">
              <span class="event-card__metadata-icon" aria-hidden="true">
                📍
              </span>

              <span>{evento.lugar}</span>
            </li>
          )}
        </ul>
      )
    }

    <h2 class="event-card__title">
      <a href={eventUrl}>
        {evento.titulo}
      </a>
    </h2>

    {
      evento.descripcion && (
        <p class="event-card__description">{evento.descripcion}</p>
      )
    }

    <a
      class="event-card__link"
      href={eventUrl}
      aria-label={`Ver más información sobre ${evento.titulo}`}
    >
      <span>Ver evento</span>

      <span class="event-card__link-icon" aria-hidden="true"> → </span>
    </a>
  </div>
</article>

<style>
  .event-card {
    width: 100%;
    min-width: 0;
    height: 100%;

    display: flex;
    flex-direction: column;

    overflow: hidden;

    color: var(--color-text);
    background-color: var(--color-background);

    border: 1px solid var(--color-light-grey);

    border-radius: var(--radius);

    box-shadow: var(--shadow);

    transition:
      border-color var(--transition),
      box-shadow var(--transition),
      transform var(--transition);
  }

  .event-card__image-link {
    display: block;

    overflow: hidden;

    background-color: var(--color-primary-light);
  }

  .event-card__image-link:focus-visible {
    outline: none;

    box-shadow: inset 0 0 0 4px var(--color-secondary);

    position: relative;
    z-index: 1;
  }

  .event-card__image {
    width: 100%;
    height: auto;

    aspect-ratio: 16 / 10;

    object-fit: cover;
    object-position: center;

    transition: transform 350ms ease;
  }

  .event-card__content {
    min-width: 0;

    padding: clamp(1rem, 3vw, 1.35rem);

    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
  }

  .event-card__metadata {
    margin-bottom: 0.8rem;

    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .event-card__metadata-item {
    min-width: 0;

    display: flex;
    align-items: flex-start;
    gap: 0.5rem;

    color: #666666;

    font-size: 0.86rem;
    line-height: 1.45;
  }

  .event-card__metadata-item > span:last-child {
    min-width: 0;

    overflow-wrap: anywhere;
  }

  .event-card__metadata-icon {
    width: 1.15rem;

    display: inline-flex;
    justify-content: center;

    flex: 0 0 auto;

    line-height: 1.4;
  }

  .event-card__title {
    margin: 0;

    font-size: clamp(1.2rem, 3vw, 1.5rem);

    line-height: 1.3;
    text-wrap: balance;
  }

  .event-card__title a {
    color: var(--color-primary-hover);

    text-decoration: none;
    overflow-wrap: anywhere;

    transition: color var(--transition);
  }

  .event-card__title a:hover {
    color: var(--color-secondary-hover);

    text-decoration: underline;
  }

  .event-card__title a:focus-visible {
    outline: 3px solid var(--color-primary-light);

    outline-offset: 3px;

    border-radius: 0.2rem;
  }

  .event-card__description {
    margin: 0.75rem 0 1rem;

    display: -webkit-box;

    overflow: hidden;

    color: var(--color-text);

    line-height: 1.6;
    overflow-wrap: anywhere;

    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
    line-clamp: 4;
  }

  .event-card__link {
    width: fit-content;
    margin-top: auto;

    display: inline-flex;
    align-items: center;
    gap: 0.4rem;

    color: var(--color-secondary-hover);

    font-weight: 750;
    line-height: 1.4;
    text-decoration: none;

    transition: color var(--transition);
  }

  .event-card__link:hover {
    color: var(--color-secondary);

    text-decoration: underline;
  }

  .event-card__link:focus-visible {
    outline: 3px solid var(--color-secondary-light);

    outline-offset: 3px;

    border-radius: 0.2rem;
  }

  .event-card__link-icon {
    display: inline-block;

    transition: transform var(--transition);
  }

  @media (hover: hover) {
    .event-card:hover {
      border-color: var(--color-primary-light);

      box-shadow: 0 18px 45px rgba(0, 0, 0, 0.13);

      transform: translateY(-0.35rem);
    }

    .event-card:hover .event-card__image {
      transform: scale(1.04);
    }

    .event-card__link:hover .event-card__link-icon {
      transform: translateX(0.25rem);
    }
  }

  @media (max-width: 480px) {
    .event-card__image {
      aspect-ratio: 4 / 3;
    }

    .event-card__content {
      padding: 1rem;
    }

    .event-card__description {
      font-size: 0.95rem;
      line-height: 1.55;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .event-card,
    .event-card__image,
    .event-card__link-icon {
      transition: none;
    }
  }
</style>
