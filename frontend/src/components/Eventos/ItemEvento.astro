---
import type Evento from '../../data/interfaces/Evento'

interface Props {
  evento: Evento
  priority?: boolean
}

const { evento, priority = false } = Astro.props

const IMG_URL = (
  import.meta.env.PUBLIC_IMG_URL ??
  'https://pub-508ef05ca2d548c1b336a8b1f0f31c83.r2.dev'
).replace(/\/+$/, '')

const imageUrl = `${IMG_URL}/img_eventos/${evento.id}/0.avif`
---

<article class="evento">
  <a
    class="imagen-link"
    href={`/eventos/${evento.id}`}
    aria-label={`Ver evento ${evento.titulo}`}
  >
    <img
      src={imageUrl}
      alt={`Imagen de ${evento.titulo}`}
      class="imagen-evento"
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      decoding="async"
      width="1200"
      height="750"
    />
  </a>

  <div class="contenido">
    {
      (evento.fecha || evento.horario || evento.lugar) && (
        <div class="datos">
          {evento.fecha && (
            <div class="dato">
              <span class="icono" aria-hidden="true">
                📅
              </span>

              <span>{evento.fecha}</span>
            </div>
          )}

          {evento.horario && (
            <div class="dato">
              <span class="icono" aria-hidden="true">
                🕒
              </span>

              <span>{evento.horario}</span>
            </div>
          )}

          {evento.lugar && (
            <div class="dato">
              <span class="icono" aria-hidden="true">
                📍
              </span>

              <span>{evento.lugar}</span>
            </div>
          )}
        </div>
      )
    }

    <h2>
      <a href={`/eventos/${evento.id}`}>
        {evento.titulo}
      </a>
    </h2>

    <p class="descripcion">
      {evento.descripcion}
    </p>

    <a class="ver-evento" href={`/eventos/${evento.id}`}>
      Ver evento

      <span aria-hidden="true"> → </span>
    </a>
  </div>
</article>

<style>
  .evento {
    box-sizing: border-box;

    width: 100%;
    min-width: 0;
    height: 100%;

    display: flex;
    flex-direction: column;

    overflow: hidden;

    border: 1px solid var(--color-light-grey);
    border-radius: 1rem;

    background-color: var(--color-background);
    box-shadow: var(--shadow);

    font-family: var(--text-font-primary);

    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }

  .imagen-link {
    display: block;

    overflow: hidden;

    background-color: var(--color-primary-light);
  }

  .imagen-evento {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;

    display: block;

    object-fit: cover;
    object-position: center;

    transition: transform 0.35s ease;
  }

  .contenido {
    min-width: 0;
    padding: clamp(1rem, 3vw, 1.35rem);

    display: flex;
    flex: 1;
    flex-direction: column;
  }

  .datos {
    margin-bottom: 0.8rem;

    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .dato {
    min-width: 0;

    display: flex;
    align-items: flex-start;
    gap: 0.45rem;

    color: var(--color-grey);

    font-size: 0.88rem;
    line-height: 1.4;
  }

  .dato span:last-child {
    min-width: 0;

    overflow-wrap: anywhere;
  }

  .icono {
    flex-shrink: 0;
  }

  h2 {
    margin: 0;
  }

  h2 a {
    color: var(--color-primary-hover);

    font-size: clamp(1.2rem, 3vw, 1.5rem);
    line-height: 1.3;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  h2 a:hover {
    text-decoration: underline;
  }

  .descripcion {
    margin: 0.75rem 0 1rem;

    display: -webkit-box;

    overflow: hidden;

    color: var(--color-text);

    line-height: 1.6;
    overflow-wrap: anywhere;

    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
  }

  .ver-evento {
    width: fit-content;
    margin-top: auto;

    display: inline-flex;
    align-items: center;
    gap: 0.4rem;

    color: var(--color-secondary-hover);

    font-weight: 700;
    text-decoration: none;
  }

  .ver-evento:hover {
    text-decoration: underline;
  }

  @media (hover: hover) {
    .evento:hover {
      box-shadow: 0 18px 45px rgba(0, 0, 0, 0.13);
      transform: translateY(-0.35rem);
    }

    .evento:hover .imagen-evento {
      transform: scale(1.04);
    }
  }

  @media (max-width: 480px) {
    .imagen-evento {
      aspect-ratio: 4 / 3;
    }

    .contenido {
      padding: 1rem;
    }

    .descripcion {
      font-size: 0.95rem;
      line-height: 1.55;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .evento,
    .imagen-evento {
      transition: none;
    }
  }
</style>
