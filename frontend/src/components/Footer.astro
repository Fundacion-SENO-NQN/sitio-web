---
import Contacto from './Footer/Contacto.astro'
import FooterFin from './Footer/FooterFin.astro'
import FooterInfo from './Footer/FooterInfo.astro'
---

<footer class="site-footer" aria-label="Pie de página de Fundación SENO">
  <Contacto />

  <FooterInfo />

  <FooterFin />
</footer>

<style>
  .site-footer {
    width: 100%;
    max-width: 100%;

    margin-top: clamp(3rem, 8vw, 6rem);

    display: flex;
    flex-direction: column;
    align-items: center;

    position: relative;

    isolation: isolate;
  }
</style>
