---
import { navigationMain } from '../../data/navigation/navigationMain'
import { navigationDonaciones } from '../../data/navigation/navigationDonaciones'
import { navigationSobreNosotros } from '../../data/navigation/navigationSobreNosotros'
import { navigationInformacionUtil } from '../../data/navigation/navigationInformacionUtil'

import Banner from './FooterInfo/Banner.astro'
import TxtFooterInfo from './FooterInfo/TxtFooterInfo.astro'
import RedesSociales from './FooterInfo/RedesSociales.astro'
import FooterNav from './FooterInfo/FooterNav.astro'
---

<section class="footer-information" aria-label="Información de Fundación SENO">
  <div class="footer-information__inner">
    <div class="footer-information__identity">
      <Banner />

      <TxtFooterInfo />

      <RedesSociales />
    </div>

    <div class="footer-information__navigation">
      <section class="footer-information__group">
        <h2>Navegación</h2>

        <FooterNav items={navigationMain} label="Navegación principal" />
      </section>

      <section class="footer-information__group">
        <h2>Donaciones</h2>

        <FooterNav items={navigationDonaciones} label="Opciones de donación" />
      </section>

      <section class="footer-information__group">
        <h2>Sobre nosotros</h2>

        <FooterNav
          items={navigationSobreNosotros}
          label="Información sobre la Fundación"
        />
      </section>

      <section class="footer-information__group">
        <h2>Información útil</h2>

        <FooterNav items={navigationInformacionUtil} label="Información útil" />
      </section>
    </div>
  </div>
</section>

<style>
  .footer-information {
    display: flex;
    width: 100%;

    margin-top: clamp(2rem, 5vw, 3.5rem);

    padding: clamp(2rem, 5vw, 4rem) clamp(1rem, 4vw, 3rem);

    background-color: #eef5f9;

    background-color: color-mix(
      in srgb,
      var(--color-secondary-light) 25%,
      var(--color-background)
    );
  }

  .footer-information__inner {
    width: min(100%, 87.5rem);

    margin-inline: auto;

    display: grid;

    grid-template-columns:
      minmax(17rem, 1.1fr)
      minmax(0, 2.4fr);

    gap: clamp(2rem, 5vw, 5rem);
  }

  .footer-information__identity {
    min-width: 0;

    padding-right: clamp(1rem, 3vw, 3rem);

    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;

    border-right: 1px solid var(--color-secondary);
  }

  .footer-information__navigation {
    min-width: 0;

    display: grid;

    grid-template-columns: repeat(4, minmax(0, 1fr));

    align-items: start;

    gap: clamp(1.5rem, 3vw, 3rem);
  }

  .footer-information__group {
    min-width: 0;
  }

  .footer-information__group h2 {
    margin-bottom: 0.8rem;

    color: var(--color-secondary-hover);

    font-size: 0.95rem;
    font-weight: 800;
    line-height: 1.3;
    letter-spacing: 0.035em;
    text-transform: uppercase;
  }

  @media (max-width: 1100px) {
    .footer-information__inner {
      grid-template-columns: minmax(0, 1fr);
    }

    .footer-information__identity {
      padding-right: 0;
      padding-bottom: 2rem;

      align-items: center;

      border-right: 0;

      border-bottom: 1px solid var(--color-secondary);
    }

    .footer-information__navigation {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .footer-information {
      padding-inline: 1.25rem;
    }

    .footer-information__navigation {
      grid-template-columns: minmax(0, 1fr);

      gap: 0;
    }

    .footer-information__group {
      padding-block: 1.25rem;

      border-bottom: 1px solid var(--color-secondary-light);
    }

    .footer-information__group:first-child {
      padding-top: 0;
    }

    .footer-information__group:last-child {
      padding-bottom: 0;

      border-bottom: 0;
    }

    .footer-information__group h2 {
      margin-bottom: 0.65rem;
    }
  }
</style>
