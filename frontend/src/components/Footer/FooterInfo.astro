---
import { navigationMain } from '../../data/navigation/navigationMain'
import { navigationDonaciones } from '../../data/navigation/navigationDonaciones'
import { navigationSobreNosotros } from '../../data/navigation/navigationSobreNosotros'
import { navigationInformacionUtil } from '../../data/navigation/navigationInformacionUtil'

import Banner from './FooterInfo/Banner.astro'
import TxtFooterInfo from './FooterInfo/TxtFooterInfo.astro'
import RedesSociales from './FooterInfo/RedesSociales.astro'
import FooterNav from './FooterInfo/FooterNav.astro'
---

<section class="footer-info">
  <div class="footer-info-inner">
    <div class="footer-info-izq">
      <Banner />
      <TxtFooterInfo />
      <RedesSociales />
    </div>

    <div class="footer-navigation">
      <div class="footer-nav-group">
        <h2 class="footer-nav-titulo">NAVEGACIÓN</h2>

        <FooterNav items={navigationMain} label="Navegación principal" />
      </div>

      <div class="footer-nav-group">
        <h2 class="footer-nav-titulo">DONACIONES</h2>

        <FooterNav items={navigationDonaciones} label="Opciones de donación" />
      </div>

      <div class="footer-nav-group">
        <h2 class="footer-nav-titulo">SOBRE NOSOTROS</h2>

        <FooterNav
          items={navigationSobreNosotros}
          label="Información sobre la Fundación"
        />
      </div>

      <div class="footer-nav-group">
        <h2 class="footer-nav-titulo">INFORMACIÓN ÚTIL</h2>

        <FooterNav items={navigationInformacionUtil} label="Información útil" />
      </div>
    </div>
  </div>
</section>

<style>
  .footer-info {
    box-sizing: border-box;

    width: 100%;
    margin-top: clamp(2rem, 5vw, 3.5rem);
    padding: clamp(2rem, 5vw, 4rem) clamp(1rem, 4vw, 3rem);

    background-color: color-mix(
      in srgb,
      var(--color-secondary-light) 25%,
      var(--color-background)
    );
  }

  .footer-info-inner {
    width: min(100%, 1400px);
    margin-inline: auto;

    display: grid;
    grid-template-columns: minmax(17rem, 1.1fr) minmax(0, 2.4fr);
    gap: clamp(2rem, 5vw, 5rem);
  }

  .footer-info-izq {
    min-width: 0;
    padding-right: clamp(1rem, 3vw, 3rem);

    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;

    border-right: 1px solid var(--color-secondary);
  }

  .footer-navigation {
    min-width: 0;

    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    align-items: start;
    gap: clamp(1.5rem, 3vw, 3rem);
  }

  .footer-nav-group {
    min-width: 0;
  }

  .footer-nav-titulo {
    margin: 0 0 0.75rem;

    color: var(--color-secondary-hover);
    font-family: var(--text-font-primary);
    font-size: 1rem;
    line-height: 1.3;
  }

  @media (max-width: 1100px) {
    .footer-info-inner {
      grid-template-columns: 1fr;
    }

    .footer-info-izq {
      padding-right: 0;
      padding-bottom: 2rem;

      align-items: center;

      border-right: none;
      border-bottom: 1px solid var(--color-secondary);
    }

    .footer-navigation {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .footer-info {
      padding-inline: 1.25rem;
    }

    .footer-navigation {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .footer-nav-group {
      padding-block: 1.25rem;

      border-bottom: 1px solid var(--color-secondary-light);
    }

    .footer-nav-group:first-child {
      padding-top: 0;
    }

    .footer-nav-group:last-child {
      padding-bottom: 0;
      border-bottom: none;
    }

    .footer-nav-titulo {
      margin-bottom: 0.6rem;
    }
  }
</style>
