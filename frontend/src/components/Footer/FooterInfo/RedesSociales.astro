---
import SvgFacebook from '../../../assets/icon-contacto/icon-facebook.svg'
import SvgInstagram from '../../../assets/icon-contacto/icon-instagram.svg'
import SvgWhatsApp from '../../../assets/icon-contacto/icon-whatsapp.svg'
---

<nav class="nav-redes-sociales" aria-label="Redes sociales de Fundación SENO">
  <ul class="lista-redes-sociales">
    <li>
      <a
        href="https://www.facebook.com/fundacionseno2017"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Visitar Facebook de Fundación SENO"
      >
        <SvgFacebook />
      </a>
    </li>

    <li>
      <a
        href="https://www.instagram.com/fundacionseno"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Visitar Instagram de Fundación SENO"
      >
        <SvgInstagram />
      </a>
    </li>

    <li>
      <a
        href="https://api.whatsapp.com/send?phone=542994564725&text=Hola%20Fundaci%C3%B3n%20SENO"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Contactar a Fundación SENO por WhatsApp"
      >
        <SvgWhatsApp />
      </a>
    </li>
  </ul>
</nav>

<style>
  .nav-redes-sociales {
    width: 100%;
    max-width: 16rem;
  }

  .lista-redes-sociales {
    margin: 0;
    padding: 0;

    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;

    list-style: none;
  }

  .lista-redes-sociales a {
    width: 2.75rem;
    height: 2.75rem;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 50%;
    background-color: var(--color-secondary-light);

    transition:
      background-color 0.3s ease,
      transform 0.2s ease;
  }

  .lista-redes-sociales svg {
    width: 1.75rem;
    height: 1.75rem;

    fill: var(--color-secondary);

    transition: fill 0.3s ease;
  }

  .lista-redes-sociales a:hover {
    background-color: var(--color-secondary);
    transform: translateY(-2px);
  }

  .lista-redes-sociales a:hover svg {
    fill: var(--color-background);
  }

  .lista-redes-sociales a:focus-visible {
    outline: 2px solid var(--color-secondary);
    outline-offset: 3px;
  }

  @media (max-width: 1100px) {
    .nav-redes-sociales {
      margin-inline: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lista-redes-sociales a,
    .lista-redes-sociales svg {
      transition: none;
    }

    .lista-redes-sociales a:hover {
      transform: none;
    }
  }
</style>
