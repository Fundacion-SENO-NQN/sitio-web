---
import SvgFacebook from '../../../assets/icon-contacto/icon-facebook.svg'
import SvgInstagram from '../../../assets/icon-contacto/icon-instagram.svg'
import SvgWhatsApp from '../../../assets/icon-contacto/icon-whatsapp.svg'
---

<nav class="social-nav" aria-label="Redes sociales de Fundación SENO">
  <ul class="social-nav__list">
    <li>
      <a
        class="social-nav__link"
        href="https://www.facebook.com/fundacionseno2017"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Visitar Facebook de Fundación SENO en una pestaña nueva"
      >
        <SvgFacebook class="social-nav__icon" aria-hidden="true" />
      </a>
    </li>

    <li>
      <a
        class="social-nav__link"
        href="https://www.instagram.com/fundacionseno"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Visitar Instagram de Fundación SENO en una pestaña nueva"
      >
        <SvgInstagram class="social-nav__icon" aria-hidden="true" />
      </a>
    </li>

    <li>
      <a
        class="social-nav__link"
        href="https://api.whatsapp.com/send?phone=542994564725&text=Hola%20Fundaci%C3%B3n%20SENO"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Contactar a Fundación SENO por WhatsApp en una pestaña nueva"
      >
        <SvgWhatsApp class="social-nav__icon" aria-hidden="true" />
      </a>
    </li>
  </ul>
</nav>

<style>
  .social-nav {
    width: 100%;
    max-width: 14rem;
  }

  .social-nav__list {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 1rem;
  }

  .social-nav__link {
    width: 2.75rem;
    height: 2.75rem;

    display: inline-grid;
    place-items: center;

    color: var(--color-secondary);
    background-color: var(--color-secondary-light);

    border: 1px solid transparent;

    border-radius: 50%;

    transition:
      color var(--transition),
      background-color var(--transition),
      border-color var(--transition),
      box-shadow var(--transition),
      transform var(--transition);
  }

  .social-nav__icon {
    width: 1.65rem;
    height: 1.65rem;

    fill: currentColor;
  }

  .social-nav__link:hover {
    color: var(--color-background);
    background-color: var(--color-secondary);

    border-color: var(--color-secondary);
  }

  .social-nav__link:focus-visible {
    outline: none;

    box-shadow: 0 0 0 3px var(--color-secondary-light);
  }

  @media (hover: hover) {
    .social-nav__link:hover {
      transform: translateY(-2px);
    }
  }

  @media (max-width: 1100px) {
    .social-nav {
      margin-inline: auto;
    }

    .social-nav__list {
      justify-content: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .social-nav__link {
      transition: none;
    }
  }
</style>
