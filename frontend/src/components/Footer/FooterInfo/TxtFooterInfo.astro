---
interface Props {
  texto?: string
}

const {
  texto = `Acompañamos a niños y adolescentes con cáncer, junto a sus familias, durante todo el tratamiento, brindando apoyo emocional, económico, material y mucho más.`
} = Astro.props
---

<p class="footer-description">
  {texto}
</p>

<style>
  .footer-description {
    width: 100%;
    max-width: 32rem;

    color: var(--color-text);

    line-height: 1.65;
    text-align: left;
    text-wrap: pretty;
  }

  @media (max-width: 1100px) {
    .footer-description {
      text-align: center;
    }
  }
</style>
