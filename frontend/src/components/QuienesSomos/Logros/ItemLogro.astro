---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import type Logro from '../../../data/interfaces/Logro'
import SvgFlechaSimple from '../../../assets/icon-common/icon-flecha-simple.svg'

interface Props {
  logro: Logro
}

const { logro } = Astro.props

const images: Record<string, ImageMetadata> = import.meta.glob(
  '../../../assets/img_logros/*.avif',
  {
    eager: true,
    import: 'default',
  },
)

const image: ImageMetadata =
  images[`../../../assets/img_logros/${logro.id}.avif`]
---

<label class="logro">
  <input type="checkbox" />

  <div class="cabecera">
    <Image src={image} alt={logro.titulo} class="imagen-logro" loading="lazy" />

    <div class="texto">
      <h3>{logro.titulo}</h3>
    </div>

    <span class="flecha" aria-hidden="true">
      <SvgFlechaSimple />
    </span>
  </div>

  <div class="contenido">
    <p>{logro.contenido}</p>
  </div>
</label>

<style>
  .logro {
    width: 100%;
    min-width: 0;

    display: block;

    font-family: var(--text-font-primary);
  }

  .logro input {
    width: 1px;
    height: 1px;

    position: absolute;

    overflow: hidden;
    opacity: 0;
    clip-path: inset(50%);
  }

  .cabecera {
    box-sizing: border-box;

    width: 100%;
    min-width: 0;
    padding: clamp(0.75rem, 2vw, 1rem);

    display: flex;
    align-items: center;
    gap: clamp(0.7rem, 2vw, 1.2rem);

    border: 1px solid var(--color-primary-hover);
    border-radius: 1rem;
    background-color: var(--color-primary-light);

    cursor: pointer;

    transition:
      background-color 0.25s ease,
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }

  .imagen-logro {
    width: clamp(3.75rem, 9vw, 5.5rem);
    height: clamp(3.75rem, 9vw, 5.5rem);

    display: block;
    flex-shrink: 0;

    border-radius: 0.75rem;

    object-fit: cover;

    transition: transform 0.3s ease;
  }

  .texto {
    min-width: 0;

    flex: 1;
  }

  .texto h3 {
    margin: 0;

    color: var(--color-primary-hover);

    font-size: clamp(1.05rem, 3vw, 1.4rem);
    line-height: 1.3;
    overflow-wrap: anywhere;

    transition: color 0.25s ease;
  }

  .flecha {
    width: 2rem;
    height: 2rem;

    display: grid;
    flex: 0 0 2rem;
    place-items: center;

    color: var(--color-primary-hover);

    transition:
      transform 0.3s ease,
      color 0.25s ease;
  }

  .flecha svg {
    width: 1.5rem;
    height: 1.5rem;
  }

  .contenido {
    box-sizing: border-box;

    max-height: 0;

    overflow: hidden;

    border: 0 solid var(--color-primary-hover);
    border-radius: 0 0 1rem 1rem;

    transition:
      max-height 0.45s ease,
      padding 0.45s ease,
      border-width 0.2s ease;
  }

  .contenido p {
    margin: 0;

    color: var(--color-text);

    line-height: 1.7;
    overflow-wrap: anywhere;
  }

  .logro input:focus-visible + .cabecera {
    outline: 3px solid var(--color-primary);
    outline-offset: 3px;
  }

  .logro input:checked + .cabecera {
    border-radius: 1rem 1rem 0 0;
  }

  .logro input:checked + .cabecera .flecha {
    transform: rotate(180deg);
  }

  .logro input:checked ~ .contenido {
    max-height: 1500px;
    padding: clamp(1rem, 3vw, 1.5rem);

    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
  }

  @media (hover: hover) {
    .cabecera:hover {
      background-color: var(--color-primary);
      box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08);
      transform: translateY(-2px);
    }

    .cabecera:hover .imagen-logro {
      transform: scale(1.05);
    }

    .cabecera:hover h3,
    .cabecera:hover .flecha {
      color: var(--color-background);
    }
  }

  @media (max-width: 480px) {
    .cabecera {
      gap: 0.65rem;
      padding: 0.7rem;
    }

    .imagen-logro {
      width: 3.5rem;
      height: 3.5rem;
    }

    .flecha {
      width: 1.5rem;
      height: 1.5rem;
      flex-basis: 1.5rem;
    }

    .flecha svg {
      width: 1.25rem;
      height: 1.25rem;
    }

    .logro input:checked ~ .contenido {
      padding: 1rem;
    }

    .contenido p {
      font-size: 0.95rem;
      line-height: 1.6;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cabecera,
    .imagen-logro,
    .flecha,
    .contenido {
      transition: none;
    }
  }
</style>
