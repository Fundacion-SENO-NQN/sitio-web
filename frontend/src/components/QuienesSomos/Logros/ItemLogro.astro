---
import type Logro from '../../../data/interfaces/Logro'

import SvgFlechaSimple from '../../../assets/icon-common/icon-flecha-simple.svg'

interface Props {
  logro: Logro
}

const { logro } = Astro.props

const IMG_URL = (
  import.meta.env.PUBLIC_IMG_URL ??
  'https://pub-508ef05ca2d548c1b336a8b1f0f31c83.r2.dev'
).replace(/\/+$/, '')

const imageUrl = `${IMG_URL}/img_logros/${logro.id}.avif`
---

<details class="achievement">
  <summary class="achievement__summary">
    <img
      class="achievement__image"
      src={imageUrl}
      alt=""
      loading="lazy"
      decoding="async"
      width="600"
      height="600"
    />

    <h3 class="achievement__title">
      {logro.titulo}
    </h3>

    <span class="achievement__arrow" aria-hidden="true">
      <SvgFlechaSimple />
    </span>
  </summary>

  <div class="achievement__content">
    <p>{logro.contenido}</p>
  </div>
</details>

<style>
  .achievement {
    width: 100%;
    min-width: 0;
  }

  .achievement__summary {
    width: 100%;
    min-width: 0;

    padding: clamp(0.75rem, 2vw, 1rem);

    display: flex;
    align-items: center;

    gap: clamp(0.7rem, 2vw, 1.2rem);

    color: var(--color-primary-hover);

    background-color: var(--color-primary-light);

    border: 1px solid var(--color-primary-hover);

    border-radius: var(--radius);

    cursor: pointer;

    list-style: none;

    transition:
      color var(--transition),
      background-color var(--transition),
      border-radius var(--transition),
      box-shadow var(--transition),
      transform var(--transition);
  }

  .achievement__summary::-webkit-details-marker {
    display: none;
  }

  .achievement__summary::marker {
    content: '';
  }

  .achievement__image {
    width: clamp(3.75rem, 9vw, 5.5rem);

    height: clamp(3.75rem, 9vw, 5.5rem);

    flex: 0 0 auto;

    object-fit: cover;
    object-position: center;

    background-color: var(--color-background);

    border-radius: var(--radius-small);

    transition: transform 300ms ease;
  }

  .achievement__title {
    min-width: 0;

    flex: 1 1 auto;

    color: inherit;

    font-size: clamp(1.05rem, 3vw, 1.4rem);

    line-height: 1.3;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }

  .achievement__arrow {
    width: 2rem;
    height: 2rem;

    display: grid;
    place-items: center;

    flex: 0 0 2rem;

    color: inherit;

    transition: transform 300ms ease;
  }

  .achievement__arrow svg {
    width: 1.5rem;
    height: 1.5rem;
  }

  .achievement__content {
    padding: clamp(1rem, 3vw, 1.5rem);

    color: var(--color-text);
    background-color: var(--color-background);

    border-right: 1px solid var(--color-primary-hover);

    border-bottom: 1px solid var(--color-primary-hover);

    border-left: 1px solid var(--color-primary-hover);

    border-radius: 0 0 var(--radius) var(--radius);

    animation: achievementContentAppear 250ms ease;
  }

  .achievement__content p {
    color: var(--color-text);

    line-height: 1.7;
    text-wrap: pretty;
    overflow-wrap: anywhere;
  }

  .achievement[open] .achievement__summary {
    border-radius: var(--radius) var(--radius) 0 0;
  }

  .achievement[open] .achievement__arrow {
    transform: rotate(180deg);
  }

  .achievement__summary:focus-visible {
    outline: none;

    box-shadow: 0 0 0 3px var(--color-primary);
  }

  @media (hover: hover) {
    .achievement__summary:hover {
      color: var(--color-background);
      background-color: var(--color-primary);

      box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08);

      transform: translateY(-2px);
    }

    .achievement__summary:hover .achievement__image {
      transform: scale(1.05);
    }

    .achievement[open] .achievement__summary:hover {
      transform: none;
    }
  }

  @media (max-width: 480px) {
    .achievement__summary {
      gap: 0.65rem;

      padding: 0.7rem;
    }

    .achievement__image {
      width: 3.5rem;
      height: 3.5rem;
    }

    .achievement__arrow {
      width: 1.5rem;
      height: 1.5rem;

      flex-basis: 1.5rem;
    }

    .achievement__arrow svg {
      width: 1.25rem;
      height: 1.25rem;
    }

    .achievement__content {
      padding: 1rem;
    }

    .achievement__content p {
      font-size: 0.95rem;
      line-height: 1.6;
    }
  }

  @keyframes achievementContentAppear {
    from {
      opacity: 0;

      transform: translateY(-0.35rem);
    }

    to {
      opacity: 1;

      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .achievement__summary,
    .achievement__image,
    .achievement__arrow {
      transition: none;
    }

    .achievement__content {
      animation: none;
    }
  }
</style>
