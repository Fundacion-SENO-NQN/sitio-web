---
import type { TarjetaHistoria } from '../../../data/interfaces/Historia'

interface Props {
  historia: {
    date: string
    contenido: TarjetaHistoria[]
  }
}

const { historia } = Astro.props
---

<article class="history-item">
  <p class="history-item__date">
    {historia.date}
  </p>

  <span class="history-item__marker" aria-hidden="true"></span>

  <div class="history-item__cards">
    {
      historia.contenido.map((item: TarjetaHistoria) => (
        <section class="history-item__card">
          {item.titulo && <h3>{item.titulo}</h3>}

          <div class="history-item__rich-text" set:html={item.contenido} />
        </section>
      ))
    }
  </div>
</article>

<style>
  .history-item {
    width: 100%;
    min-width: 0;

    margin-bottom: clamp(3rem, 7vw, 5rem);

    display: grid;

    grid-template-columns:
      minmax(0, 1fr)
      3.5rem
      minmax(0, 1fr);

    grid-template-areas: 'date marker cards';

    align-items: center;

    column-gap: clamp(1rem, 4vw, 2rem);
  }

  .history-item:nth-child(even) {
    grid-template-areas: 'cards marker date';
  }

  .history-item__date {
    grid-area: date;

    color: var(--color-grey);

    font-size: clamp(2rem, 6vw, 3rem);

    font-weight: 800;
    line-height: 1.1;
    text-align: right;
    overflow-wrap: anywhere;
  }

  .history-item:nth-child(even) .history-item__date {
    text-align: left;
  }

  .history-item__marker {
    grid-area: marker;

    width: 100%;
    height: 100%;
    min-height: 5rem;

    position: relative;

    display: grid;
    place-items: center;
  }

  .history-item__marker::before {
    content: '';

    width: 2px;

    position: absolute;
    top: -3rem;
    bottom: -3rem;

    background-color: var(--color-primary-light);
  }

  .history-item:first-child .history-item__marker::before {
    top: 50%;
  }

  .history-item:last-child .history-item__marker::before {
    bottom: 50%;
  }

  .history-item__marker::after {
    content: '';

    width: 1.5rem;
    height: 1.5rem;

    position: relative;
    z-index: 1;

    background-color: var(--color-background);

    border: 5px solid var(--color-primary);

    border-radius: 50%;

    box-shadow: 0 0 0 5px var(--color-background);
  }

  .history-item__cards {
    grid-area: cards;

    min-width: 0;

    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .history-item:nth-child(even) .history-item__cards {
    text-align: right;
  }

  .history-item__card {
    min-width: 0;

    padding: clamp(1.25rem, 4vw, 2rem);

    color: var(--color-text);
    background-color: #ffffff;

    border: 1px solid var(--color-light-grey);

    border-radius: clamp(0.85rem, 2vw, 1.2rem);

    box-shadow: 0 10px 35px rgba(0, 0, 0, 0.08);

    transition:
      border-color var(--transition),
      box-shadow var(--transition),
      transform var(--transition);
  }

  .history-item__card h3 {
    margin-bottom: 0.85rem;

    color: var(--color-primary-hover);

    font-size: clamp(1.15rem, 3vw, 1.4rem);

    line-height: 1.3;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }

  .history-item__rich-text {
    color: var(--color-text);

    line-height: 1.8;
    text-wrap: pretty;
    overflow-wrap: anywhere;
  }

  .history-item__rich-text :global(p + p) {
    margin-top: 0.85rem;
  }

  .history-item__rich-text :global(strong) {
    color: var(--color-primary-hover);
  }

  .history-item__rich-text :global(a) {
    color: var(--color-secondary-hover);

    font-weight: 650;
  }

  .history-item__rich-text :global(ul),
  .history-item__rich-text :global(ol) {
    margin-top: 0.75rem;
    padding-left: 1.4rem;

    text-align: left;
  }

  .history-item__rich-text :global(ul) {
    list-style: disc;
  }

  .history-item__rich-text :global(ol) {
    list-style: decimal;
  }

  .history-item__rich-text :global(li + li) {
    margin-top: 0.4rem;
  }

  @media (hover: hover) {
    .history-item__card:hover {
      border-color: var(--color-primary-light);

      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.12);

      transform: translateY(-0.4rem);
    }
  }

  @media (max-width: 800px) {
    .history-item,
    .history-item:nth-child(even) {
      grid-template-columns:
        1.5rem
        minmax(0, 1fr);

      grid-template-areas:
        'marker date'
        'marker cards';

      align-items: start;

      column-gap: 1rem;
      row-gap: 0.75rem;
    }

    .history-item__date,
    .history-item:nth-child(even) .history-item__date {
      text-align: left;
    }

    .history-item__marker {
      grid-row: 1 / -1;

      min-height: 100%;
    }

    .history-item__cards,
    .history-item:nth-child(even) .history-item__cards {
      text-align: left;
    }
  }

  @media (max-width: 480px) {
    .history-item {
      margin-bottom: 3rem;

      grid-template-columns:
        1.25rem
        minmax(0, 1fr);

      column-gap: 0.75rem;
    }

    .history-item__marker::after {
      width: 1.15rem;
      height: 1.15rem;

      border-width: 4px;
    }

    .history-item__card {
      padding: 1.1rem;
    }

    .history-item__rich-text {
      font-size: 0.95rem;
      line-height: 1.65;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .history-item__card {
      transition: none;
    }
  }
</style>
