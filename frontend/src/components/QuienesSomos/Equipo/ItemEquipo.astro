---
interface Props {
  integrante: {
    id: number
    order: number
    nombre: string
    apellido: string
    puesto: string
    descripcion: string
    created_at: Date
  }
  priority?: boolean
}

const { integrante, priority = false } = Astro.props

const R2_PUBLIC_URL = import.meta.env.PUBLIC_IMG_URL

const imageUrl = `${R2_PUBLIC_URL}/img_equipo/${integrante.id}.avif`
---

<li class="integrante">
  <div class="imagen-container">
    <img
      src={imageUrl}
      alt={`Foto de ${integrante.nombre} ${integrante.apellido}`}
      class="imagen-integrante"
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      decoding="async"
    />
  </div>

  <div class="contenido">
    <header class="cabecera">
      <h2>
        {integrante.nombre}
        {integrante.apellido}
      </h2>

      <p class="puesto">
        {integrante.puesto}
      </p>
    </header>

    <div class="descripcion">
      <p>{integrante.descripcion}</p>
    </div>
  </div>
</li>

<style>
  .integrante {
    box-sizing: border-box;

    width: 100%;
    min-width: 0;

    display: grid;
    grid-template-columns: clamp(9rem, 18vw, 12rem) minmax(0, 1fr);

    overflow: hidden;

    border: 1px solid var(--color-primary-hover);
    border-radius: 1rem;
    background-color: var(--color-background);
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.07);

    font-family: var(--text-font-primary);

    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }

  .imagen-container {
    min-height: 12rem;

    background-color: var(--color-primary-light);
    border-right: 1px solid var(--color-primary-hover);
  }

  .imagen-integrante {
    width: 100%;
    height: 100%;

    display: block;

    object-fit: cover;
    object-position: center;
  }

  .contenido {
    min-width: 0;

    display: flex;
    flex-direction: column;
  }

  .cabecera {
    min-width: 0;
  }

  .cabecera h2 {
    box-sizing: border-box;

    min-height: 3.2rem;
    margin: 0;
    padding: 0.75rem clamp(1rem, 3vw, 1.5rem);

    display: flex;
    align-items: center;

    background-color: var(--color-primary-hover);
    color: var(--color-background);

    font-size: clamp(1.2rem, 3vw, 1.55rem);
    line-height: 1.25;
    overflow-wrap: anywhere;
  }

  .puesto {
    box-sizing: border-box;

    min-height: 2.25rem;
    margin: 0;
    padding: 0.45rem clamp(1rem, 3vw, 1.5rem);

    display: flex;
    align-items: center;

    background-color: var(--color-light-grey);
    color: var(--color-text);

    font-size: clamp(0.9rem, 2vw, 1rem);
    font-weight: 600;
    line-height: 1.35;
    overflow-wrap: anywhere;
  }

  .descripcion {
    min-width: 0;
    padding: clamp(1rem, 3vw, 1.5rem);

    display: flex;
    flex: 1;
    align-items: center;
  }

  .descripcion p {
    margin: 0;

    color: var(--color-text);

    line-height: 1.7;
    overflow-wrap: anywhere;
  }

  @media (hover: hover) {
    .integrante:hover {
      transform: translateY(-3px);
      box-shadow: 0 14px 38px rgba(0, 0, 0, 0.11);
    }
  }

  @media (max-width: 750px) {
    .integrante {
      grid-template-columns: 8rem minmax(0, 1fr);
    }

    .imagen-container {
      min-height: 11rem;
    }

    .descripcion {
      align-items: flex-start;
    }
  }

  @media (max-width: 560px) {
    .integrante {
      grid-template-columns: minmax(0, 1fr);
    }

    .imagen-container {
      width: 100%;
      min-height: 0;
      aspect-ratio: 4 / 3;

      border-right: none;
      border-bottom: 1px solid var(--color-primary-hover);
    }

    .imagen-integrante {
      object-position: center 25%;
    }

    .cabecera h2 {
      min-height: auto;
      padding: 0.8rem 1rem;

      justify-content: center;

      font-size: 1.25rem;
      text-align: center;
    }

    .puesto {
      min-height: auto;
      padding: 0.55rem 1rem;

      justify-content: center;

      text-align: center;
    }

    .descripcion {
      padding: 1rem;
    }

    .descripcion p {
      font-size: 0.96rem;
      line-height: 1.6;
    }
  }

  @media (max-width: 360px) {
    .imagen-container {
      aspect-ratio: 1 / 1;
    }

    .cabecera h2 {
      font-size: 1.15rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .integrante {
      transition: none;
    }

    .integrante:hover {
      transform: none;
    }
  }
</style>
