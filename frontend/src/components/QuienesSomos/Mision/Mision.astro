---
import ItemMision from './ItemMision.astro'

import { misiones } from '../../../data/mision/mision'
import type Mision from '../../../data/interfaces/Mision'
---

<section class="mission-section" aria-labelledby="mission-section-title">
  <h2 id="mission-section-title">¿Cuál es nuestra misión?</h2>

  <ul class="mission-section__list">
    {misiones.map((item: Mision) => <ItemMision mision={item} />)}
  </ul>
</section>

<style>
  .mission-section {
    width: 100%;
    min-width: 0;
  }

  .mission-section > h2 {
    margin-bottom: clamp(1.5rem, 4vw, 2.5rem);

    color: var(--color-primary-hover);

    font-size: clamp(1.5rem, 4vw, 2rem);

    line-height: 1.2;
    text-align: center;
    text-wrap: balance;
  }

  .mission-section__list {
    width: 100%;

    display: grid;

    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));

    align-items: stretch;

    column-gap: clamp(1.25rem, 3vw, 2rem);
  }
</style>
