---
import { Image } from 'astro:assets'
import ImgLogo from '../../assets/logo_seno.avif'
import '../../style/login.css'
interface Props { mode: 'request' | 'reset' }
const { mode } = Astro.props
const resetting = mode === 'reset'
---
<div class="login-page">
  <main class="login-page__main">
    <section class="login-card" aria-labelledby="recovery-title">
      <a class="login-card__logo-link" href="/" aria-label="Volver al sitio web de Fundación SENO">
        <Image class="login-card__logo" src={ImgLogo} alt="" loading="eager" decoding="async" />
      </a>
      <header class="login-card__header">
        <p class="login-card__label">Plataforma administrativa</p>
        <h1 id="recovery-title">{resetting ? 'Elegí tu nueva contraseña' : 'Recuperá tu contraseña'}</h1>
        <p>{resetting
          ? 'Ingresá una nueva contraseña para volver a acceder a la plataforma.'
          : 'Ingresá tu usuario o el correo asociado a tu cuenta. Te enviaremos un enlace para cambiar tu contraseña.'}</p>
      </header>
      <p class="login-form__error" id="recovery-error" role="alert" tabindex="-1" hidden></p>
      <p class="login-form__success" id="recovery-success" role="status" tabindex="-1" hidden></p>
      <form class="login-form" id="password-recovery-form" method="post" data-mode={mode}>
        {resetting ? <>
          <div class="login-form__field">
            <label for="new-password">Nueva contraseña</label>
            <div class="login-form__password">
              <input id="new-password" name="password" type="password" minlength="8" maxlength="256"
                required autocomplete="new-password" aria-describedby="password-help" />
              <button type="button" class="login-form__password-toggle" data-toggle="new-password"
                aria-label="Mostrar nueva contraseña" aria-pressed="false">Mostrar</button>
            </div>
            <p class="login-form__help" id="password-help">Usá entre 8 y 128 caracteres.</p>
          </div>
          <div class="login-form__field">
            <label for="password-confirmation">Repetí la nueva contraseña</label>
            <div class="login-form__password">
              <input id="password-confirmation" name="password_confirmation" type="password"
                minlength="8" maxlength="256" required autocomplete="new-password" />
              <button type="button" class="login-form__password-toggle" data-toggle="password-confirmation"
                aria-label="Mostrar confirmación de contraseña" aria-pressed="false">Mostrar</button>
            </div>
          </div>
        </> : <div class="login-form__field">
          <label for="recovery-identifier">Usuario o correo electrónico</label>
          <input id="recovery-identifier" name="identifier" type="text" maxlength="254"
            required autocomplete="username" autocapitalize="none" spellcheck="false" />
        </div>}
        <button class="login-form__submit" type="submit" id="recovery-submit" disabled>
          {resetting ? 'Guardar nueva contraseña' : 'Enviar enlace de recuperación'}
        </button>
      </form>
      {resetting && <a class="login-card__recovery" id="request-new-link" href="/login/recuperar/">Solicitar otro enlace</a>}
      <noscript><p class="login-card__noscript">Necesitás habilitar JavaScript para recuperar tu contraseña.</p></noscript>
      <a class="login-card__back" href="/login/"><span aria-hidden="true">←</span> Volver al inicio de sesión</a>
    </section>
  </main>
</div>
<script>
  import { passwordRecoveryRequest } from '../../api/passwordRecovery'
  const form = document.querySelector<HTMLFormElement>('#password-recovery-form')!
  const submit = document.querySelector<HTMLButtonElement>('#recovery-submit')!
  const error = document.querySelector<HTMLElement>('#recovery-error')!
  const success = document.querySelector<HTMLElement>('#recovery-success')!
  const resetting = form.dataset.mode === 'reset'
  let busy = false
  let token = ''
  function showError(message: string) {
    error.textContent = message
    error.hidden = false
    error.focus()
  }
  function readResetLink() {
    token = new URLSearchParams(location.hash.slice(1)).get('token') ?? ''
    // Secreto solo en memoria, no en localStorage ni en el DOM.
    history.replaceState({}, '', location.pathname)
    form.reset()
    error.hidden = true
    success.hidden = true
    document.querySelector<HTMLElement>('#request-new-link')!.hidden = false
    if (!/^[a-f0-9]{64}$/.test(token)) {
      form.hidden = true
      showError('El enlace está incompleto o no es válido. Solicitá uno nuevo o abrí el enlace completo del correo.')
    } else {
      form.hidden = false
      submit.disabled = busy
    }
  }
  if (resetting) {
    readResetLink()
    window.addEventListener('hashchange', readResetLink)
  } else submit.disabled = false

  for (const button of form.querySelectorAll<HTMLButtonElement>('[data-toggle]')) {
    button.addEventListener('click', () => {
      const input = document.getElementById(button.dataset.toggle!) as HTMLInputElement
      const visible = input.type === 'password'
      input.type = visible ? 'text' : 'password'
      button.textContent = visible ? 'Ocultar' : 'Mostrar'
      button.setAttribute('aria-label', `${visible ? 'Ocultar' : 'Mostrar'} ${input.name === 'password' ? 'nueva contraseña' : 'confirmación de contraseña'}`)
      button.setAttribute('aria-pressed', String(visible))
    })
  }
  form.addEventListener('input', () => {
    error.hidden = true
    for (const input of form.querySelectorAll('input')) input.setCustomValidity('')
  })
  form.addEventListener('submit', async event => {
    event.preventDefault()
    if (busy || !form.reportValidity()) return
    const data = new FormData(form)
    let body: Record<string, string>
    if (resetting) {
      const password = String(data.get('password') ?? '')
      const confirmation = String(data.get('password_confirmation') ?? '')
      if ([...password].length < 8 || [...password].length > 128) {
        showError('Usá entre 8 y 128 caracteres.'); return
      }
      if (password !== confirmation) {
        const input = form.elements.namedItem('password_confirmation') as HTMLInputElement
        input.setCustomValidity('Las contraseñas no coinciden.')
        input.reportValidity(); return
      }
      body = { token, password, password_confirmation: confirmation }
    } else body = { identifier: String(data.get('identifier') ?? '').trim() }
    busy = true
    error.hidden = true
    success.hidden = true
    const label = submit.textContent
    submit.textContent = resetting ? 'Guardando...' : 'Solicitando enlace...'
    form.setAttribute('aria-busy', 'true')
    for (const input of form.querySelectorAll('input, button')) (input as HTMLInputElement).disabled = true
    try {
      const result = await passwordRecoveryRequest(resetting ? '/auth/reset-password' : '/auth/forgot-password', body)
      success.textContent = result.message
      success.hidden = false
      success.focus()
      if (resetting) {
        token = ''
        form.reset()
        form.hidden = true
        document.querySelector<HTMLElement>('#request-new-link')!.hidden = true
        for (const key of ['token', 'username', 'name', 'lastname', 'role']) localStorage.removeItem(key)
      }
    } catch (failure) {
      showError(failure instanceof Error ? failure.message : 'No se pudo completar la solicitud.')
    } finally {
      busy = false
      submit.textContent = label
      form.setAttribute('aria-busy', 'false')
      for (const input of form.querySelectorAll('input, button')) (input as HTMLInputElement).disabled = false
    }
  })
</script>
