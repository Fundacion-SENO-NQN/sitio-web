---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import type Noticia from '../../data/interfaces/Noticia'

import IconCalendario from '../../assets/icon-noticias/icon-calendario.svg'

interface Props {
  noticia: Noticia
  priority?: boolean
}

const { noticia, priority = false } = Astro.props

const images: Record<string, ImageMetadata> = import.meta.glob(
  '../../assets/img_noticias/*.avif',
  {
    eager: true,
    import: 'default',
  },
)

const image: ImageMetadata =
  images[`../../assets/img_noticias/${noticia.id}.avif`]
---

<article class="noticia-card">
  <Image
    src={image}
    alt={`Imagen de ${noticia.titulo}`}
    class="noticia-imagen"
    loading={priority ? 'eager' : 'lazy'}
    priority={priority}
  />

  <div class="content">
    <div class="fecha">
      <IconCalendario class="icono-calendario" aria-hidden="true" />

      <span>{noticia.fecha}</span>
    </div>

    <h3>{noticia.titulo}</h3>

    <p>{noticia.content}</p>
  </div>
</article>

<style>
  .noticia-card {
    box-sizing: border-box;

    width: 100%;
    max-width: 34rem;
    height: 100%;

    display: flex;
    flex-direction: column;

    overflow: hidden;

    border-radius: 1rem;
    background-color: var(--color-background);
    box-shadow: 0 10px 35px rgba(0, 0, 0, 0.08);

    font-family: var(--text-font-primary);

    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }

  .noticia-imagen {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;

    display: block;

    object-fit: cover;
    object-position: center;
  }

  .content {
    min-width: 0;
    padding: clamp(0.9rem, 3vw, 1.25rem);

    display: flex;
    flex: 1;
    flex-direction: column;
  }

  .fecha {
    min-width: 0;
    margin-bottom: 0.5rem;

    display: flex;
    align-items: center;
    gap: 0.45rem;

    color: var(--color-grey);

    font-size: 0.9rem;
    line-height: 1.3;
  }

  .icono-calendario {
    width: 1.2rem;
    height: 1.2rem;

    flex-shrink: 0;

    color: var(--color-primary-hover);
  }

  .fecha span {
    min-width: 0;

    overflow-wrap: anywhere;
  }

  .content h3 {
    margin: 0;

    color: var(--color-primary-hover);

    font-size: clamp(1.15rem, 3vw, 1.4rem);
    line-height: 1.3;
    overflow-wrap: anywhere;
  }

  .content p {
    margin: 0.65rem 0 0;

    color: var(--color-text);

    line-height: 1.6;
    overflow-wrap: anywhere;
  }

  @media (hover: hover) {
    .noticia-card:hover {
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.12);
      transform: translateY(-0.4rem);
    }
  }

  @media (max-width: 600px) {
    .noticia-card {
      max-width: 30rem;
    }

    .noticia-imagen {
      aspect-ratio: 4 / 3;
    }
  }

  @media (max-width: 380px) {
    .content {
      padding: 0.85rem;
    }

    .content p {
      font-size: 0.95rem;
      line-height: 1.5;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .noticia-card {
      transition: none;
    }
  }
</style>
