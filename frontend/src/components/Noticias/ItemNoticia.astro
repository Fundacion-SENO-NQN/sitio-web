---
import type Noticia from '../../data/interfaces/Noticia'

import IconCalendario from '../../assets/icon-noticias/icon-calendario.svg'

interface Props {
  noticia: Noticia
  priority?: boolean
}

const { noticia, priority = false } = Astro.props

const IMG_URL = (
  import.meta.env.PUBLIC_IMG_URL ??
  'https://pub-508ef05ca2d548c1b336a8b1f0f31c83.r2.dev'
).replace(/\/+$/, '')

const newsUrl = `/noticias/${noticia.id}`
const imageUrl = `${IMG_URL}/img_noticias/${noticia.id}.avif`
---

<article class="news-card">
  <a
    class="news-card__image-link"
    href={newsUrl}
    aria-label={`Leer noticia: ${noticia.titulo}`}
  >
    <img
      class="news-card__image"
      src={imageUrl}
      alt=""
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      decoding="async"
      width="1600"
      height="1000"
    />
  </a>

  <div class="news-card__content">
    {
      noticia.fecha && (
        <p class="news-card__date">
          <IconCalendario class="news-card__date-icon" aria-hidden="true" />

          <span>{noticia.fecha}</span>
        </p>
      )
    }

    <h3 class="news-card__title">
      <a href={newsUrl}>
        {noticia.titulo}
      </a>
    </h3>

    {noticia.content && <p class="news-card__description">{noticia.content}</p>}

    <a
      class="news-card__link"
      href={newsUrl}
      aria-label={`Leer la noticia ${noticia.titulo}`}
    >
      <span>Leer noticia</span>

      <span class="news-card__link-icon" aria-hidden="true"> → </span>
    </a>
  </div>
</article>

<style>
  .news-card {
    width: 100%;
    max-width: 34rem;
    height: 100%;

    margin-inline: auto;

    display: flex;
    flex-direction: column;

    overflow: hidden;

    color: var(--color-text);
    background-color: var(--color-background);

    border: 1px solid var(--color-light-grey);

    border-radius: var(--radius);

    box-shadow: 0 10px 35px rgba(0, 0, 0, 0.08);

    transition:
      border-color var(--transition),
      box-shadow var(--transition),
      transform var(--transition);
  }

  .news-card__image-link {
    display: block;

    overflow: hidden;

    background-color: var(--color-secondary-light);
  }

  .news-card__image-link:focus-visible {
    outline: none;

    position: relative;
    z-index: 1;

    box-shadow: inset 0 0 0 4px var(--color-secondary);
  }

  .news-card__image {
    width: 100%;
    height: auto;

    aspect-ratio: 16 / 10;

    object-fit: cover;
    object-position: center;

    transition: transform 350ms ease;
  }

  .news-card__content {
    min-width: 0;

    padding: clamp(0.9rem, 3vw, 1.25rem);

    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
  }

  .news-card__date {
    min-width: 0;

    margin-bottom: 0.55rem;

    display: flex;
    align-items: center;
    gap: 0.45rem;

    color: #666666;

    font-size: 0.88rem;
    line-height: 1.4;
  }

  .news-card__date-icon {
    width: 1.2rem;
    height: 1.2rem;

    flex: 0 0 auto;

    color: var(--color-primary-hover);
  }

  .news-card__date span {
    min-width: 0;

    overflow-wrap: anywhere;
  }

  .news-card__title {
    font-size: clamp(1.15rem, 3vw, 1.4rem);

    line-height: 1.3;
    text-wrap: balance;
  }

  .news-card__title a {
    color: var(--color-primary-hover);

    text-decoration: none;
    overflow-wrap: anywhere;

    transition: color var(--transition);
  }

  .news-card__title a:hover {
    color: var(--color-secondary-hover);

    text-decoration: underline;
  }

  .news-card__title a:focus-visible {
    outline: none;

    border-radius: 0.2rem;

    box-shadow: 0 0 0 3px var(--color-primary-light);
  }

  .news-card__description {
    margin: 0.7rem 0 1rem;

    display: -webkit-box;

    overflow: hidden;

    color: var(--color-text);

    line-height: 1.6;
    overflow-wrap: anywhere;

    -webkit-box-orient: vertical;
    -webkit-line-clamp: 5;
    line-clamp: 5;
  }

  .news-card__link {
    width: fit-content;

    margin-top: auto;

    display: inline-flex;
    align-items: center;
    gap: 0.4rem;

    color: var(--color-secondary-hover);

    font-weight: 750;
    line-height: 1.4;
    text-decoration: none;

    transition: color var(--transition);
  }

  .news-card__link:hover {
    color: var(--color-secondary);

    text-decoration: underline;
  }

  .news-card__link:focus-visible {
    outline: none;

    border-radius: 0.2rem;

    box-shadow: 0 0 0 3px var(--color-secondary-light);
  }

  .news-card__link-icon {
    display: inline-block;

    transition: transform var(--transition);
  }

  @media (hover: hover) {
    .news-card:hover {
      border-color: var(--color-primary-light);

      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.12);

      transform: translateY(-0.4rem);
    }

    .news-card:hover .news-card__image {
      transform: scale(1.04);
    }

    .news-card__link:hover .news-card__link-icon {
      transform: translateX(0.25rem);
    }
  }

  @media (max-width: 600px) {
    .news-card {
      max-width: 30rem;
    }

    .news-card__image {
      aspect-ratio: 4 / 3;
    }
  }

  @media (max-width: 380px) {
    .news-card__content {
      padding: 0.85rem;
    }

    .news-card__description {
      font-size: 0.95rem;
      line-height: 1.5;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .news-card,
    .news-card__image,
    .news-card__link-icon {
      transition: none;
    }
  }
</style>
