---
import type CuentaPago from '../../data/interfaces/CuentaPago'
import TarjetaDonacion from './Donar/TarjetaDonacion.astro'

import { getCuentasPago } from '../../api/metodo_donar'

const donaciones: CuentaPago[] = await getCuentasPago()
---

<section class="donaciones" aria-labelledby="titulo-metodos-donacion">
  <div class="introduccion">
    <h2 id="titulo-metodos-donacion">Elegí cómo realizar tu aporte</h2>

    <p class="descripcion">
      Cada aporte nos ayuda a seguir acompañando a niños y adolescentes con
      cáncer, junto a sus familias. Elegí el método que prefieras para realizar
      tu donación.
    </p>
  </div>

  {
    donaciones.length > 0 ? (
      <div class="contenedor">
        {donaciones.map((item: CuentaPago) => (
          <TarjetaDonacion donacion={item} />
        ))}
      </div>
    ) : (
      <p class="sin-metodos">
        En este momento no hay métodos de donación disponibles.
      </p>
    )
  }
</section>

<style>
  .donaciones {
    width: 100%;

    font-family: var(--text-font-primary);
  }

  .introduccion {
    width: min(100%, 760px);
    margin: 0 auto clamp(2rem, 5vw, 3rem);

    text-align: center;
  }

  .introduccion h2 {
    margin: 0 0 1rem;

    color: var(--color-primary-hover);

    font-size: clamp(1.4rem, 4vw, 2rem);
    line-height: 1.2;
  }

  .descripcion {
    margin: 0;

    color: var(--color-text);

    font-size: clamp(1rem, 2.5vw, 1.2rem);
    line-height: 1.75;
  }

  .contenedor {
    width: 100%;

    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    align-items: stretch;
    gap: clamp(1.25rem, 3vw, 2rem);
  }

  .sin-metodos {
    width: min(100%, 42rem);
    margin: 0 auto;
    padding: clamp(1rem, 3vw, 1.5rem);

    border: 1px solid var(--color-primary-light);
    border-radius: 1rem;
    background-color: color-mix(
      in srgb,
      var(--color-primary-light) 30%,
      transparent
    );

    color: var(--color-text);

    line-height: 1.6;
    text-align: center;
  }

  @media (max-width: 600px) {
    .introduccion {
      margin-bottom: 2rem;
    }

    .contenedor {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.25rem;
    }
  }
</style>
