---
import type { SvgComponent } from 'astro/types'
import type CuentaPago from '../../../data/interfaces/CuentaPago'
import type MetodoPago from '../../../data/interfaces/MetodoPago'

interface Props {
  donacion: CuentaPago
}

const { donacion } = Astro.props

const images: Record<string, SvgComponent> = import.meta.glob(
  '../../../assets/icon-donar/*.svg',
  {
    eager: true,
    import: 'default',
  },
)

const SvgLogo: SvgComponent =
  images[`../../../assets/icon-donar/${donacion.id}.svg`]
---

<article class="tarjeta">
  <header class="cabecera">
    <SvgLogo class="logo" />

    <h2>{donacion.nombre}</h2>
  </header>

  <p class="descripcion">
    {donacion.descripcion}
  </p>

  <div class="datos">
    {
      donacion.informacion.map((dato: MetodoPago) => (
        <div class="dato">
          <h3 class="titulo">{dato.titulo}</h3>

          <div class="valor">
            <code>{dato.valor}</code>

            <button
              class="copiar"
              type="button"
              data-copy-value={dato.valor}
              aria-label={`Copiar ${dato.titulo}: ${dato.valor}`}
            >
              Copiar
            </button>
          </div>
        </div>
      ))
    }
  </div>

  <p class="estado-copia" aria-live="polite"></p>
</article>

<script>
  const copyButtons =
    document.querySelectorAll<HTMLButtonElement>('[data-copy-value]')

  copyButtons.forEach((button) => {
    /*
     * Prevents duplicate listeners if Astro view transitions execute
     * this script again.
     */
    if (button.dataset.copyReady === 'true') return

    button.dataset.copyReady = 'true'

    button.addEventListener('click', async () => {
      const value = button.dataset.copyValue
      const card = button.closest<HTMLElement>('.tarjeta')
      const status = card?.querySelector<HTMLElement>('.estado-copia')

      if (!value) return

      const originalText = button.textContent ?? 'Copiar'

      try {
        await navigator.clipboard.writeText(value)

        button.textContent = '¡Copiado!'
        button.classList.add('copiado')

        if (status) {
          status.textContent = 'El dato fue copiado al portapapeles.'
        }
      } catch {
        button.textContent = 'No se pudo copiar'

        if (status) {
          status.textContent =
            'No se pudo copiar automáticamente. Seleccioná el dato manualmente.'
        }
      }

      window.setTimeout(() => {
        button.textContent = originalText
        button.classList.remove('copiado')

        if (status) {
          status.textContent = ''
        }
      }, 1800)
    })
  })
</script>

<style>
  .tarjeta {
    box-sizing: border-box;

    width: 100%;
    min-width: 0;
    height: 100%;
    padding: clamp(1.25rem, 4vw, 2rem);

    display: flex;
    flex-direction: column;

    border: 1px solid var(--color-primary-light);
    border-radius: 1.5rem;
    background-color: var(--color-background);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.05);

    font-family: var(--text-font-primary);

    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }

  .cabecera {
    min-width: 0;

    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .logo {
    width: auto;
    max-width: min(9rem, 45%);
    height: clamp(2.75rem, 8vw, 3.75rem);

    flex-shrink: 0;

    object-fit: contain;
  }

  .cabecera h2 {
    min-width: 0;
    margin: 0;

    color: var(--color-primary-hover);

    font-size: clamp(1.25rem, 3vw, 1.5rem);
    line-height: 1.25;
    overflow-wrap: anywhere;
  }

  .descripcion {
    margin: 1rem 0 clamp(1.5rem, 4vw, 2rem);

    color: var(--color-text);

    line-height: 1.65;
  }

  .datos {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 1.5rem;
  }

  .dato {
    min-width: 0;
  }

  .titulo {
    margin: 0 0 0.5rem;

    color: var(--color-text);

    font-size: 1rem;
    font-weight: 600;
    line-height: 1.4;
  }

  .valor {
    box-sizing: border-box;

    width: 100%;
    min-width: 0;
    padding: 0.75rem 0.8rem 0.75rem 1rem;

    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem;

    border-radius: 0.8rem;
    background-color: color-mix(
      in srgb,
      var(--color-primary-light) 20%,
      var(--color-background)
    );
  }

  code {
    min-width: 0;

    color: var(--color-text);

    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
    font-size: clamp(0.85rem, 2vw, 1rem);
    line-height: 1.5;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .copiar {
    min-height: 2.5rem;
    padding: 0.6rem 0.9rem;

    flex-shrink: 0;

    border: none;
    border-radius: 0.6rem;
    background-color: var(--color-primary);
    color: var(--color-background);

    font-family: var(--text-font-primary);
    font-weight: 600;

    cursor: pointer;

    transition:
      background-color 0.2s ease,
      transform 0.2s ease;
  }

  .copiar:hover,
  .copiar.copiado {
    background-color: var(--color-primary-hover);
  }

  .copiar:focus-visible {
    outline: 2px solid var(--color-primary-hover);
    outline-offset: 3px;
  }

  .estado-copia {
    width: 1px;
    height: 1px;
    margin: 0;

    position: absolute;

    overflow: hidden;
    clip-path: inset(50%);
  }

  @media (hover: hover) {
    .tarjeta:hover {
      box-shadow: 0 18px 40px rgba(0, 0, 0, 0.08);
      transform: translateY(-5px);
    }

    .copiar:hover {
      transform: translateY(-1px);
    }
  }

  @media (max-width: 600px) {
    .tarjeta {
      border-radius: 1.25rem;
    }

    .valor {
      grid-template-columns: minmax(0, 1fr);
      padding: 0.85rem;
    }

    .copiar {
      width: 100%;
    }
  }

  @media (max-width: 400px) {
    .tarjeta {
      padding: 1rem;
    }

    .cabecera {
      flex-direction: column;
      align-items: flex-start;
    }

    .logo {
      max-width: 10rem;
    }

    .cabecera h2 {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tarjeta,
    .copiar {
      transition: none;
    }

    .tarjeta:hover,
    .copiar:hover {
      transform: none;
    }
  }
</style>
