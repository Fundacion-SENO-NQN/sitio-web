---
import type QuieroAyudar from '../../data/interfaces/QuieroAyudar'

interface Props {
  item: QuieroAyudar
}

const { item } = Astro.props

const icons = import.meta.glob<string>(
  '../../assets/icon-quiero-ayudar/*.svg',
  {
    query: '?raw',
    import: 'default',
    eager: true,
  },
)

const iconPath = `../../assets/icon-quiero-ayudar/${item.img}.svg`
const icono = icons[iconPath]
---

<a class="item" href={item.href}>
  <span class="item__titulo">
    {item.name}
  </span>

  <span class="item__icono" aria-hidden="true">
    {
      icono ? (
        <Fragment set:html={icono} />
      ) : (
        <span class="item__sin-icono">?</span>
      )
    }
  </span>
</a>

<style>
  .item {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: stretch;

    width: 100%;
    min-width: 0;
    min-height: 8rem;

    overflow: hidden;
    border: 1px solid var(--color-primary-hover);
    border-radius: 0.8rem;
    background-color: var(--color-background);
    color: var(--color-primary);

    text-decoration: none;

    box-shadow: 0 0.3rem 1rem rgb(0 0 0 / 6%);

    transition:
      background-color 200ms ease,
      border-color 200ms ease,
      color 200ms ease,
      transform 200ms ease,
      box-shadow 200ms ease;
  }

  .item__titulo {
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;

    min-height: 3rem;
    padding: 0.55rem 0.75rem;

    background-color: var(--color-primary-hover);
    color: var(--color-background);

    font-size: clamp(0.9rem, 1.5vw, 1.05rem);
    font-weight: 700;
    line-height: 1.25;
    text-align: center;
    text-wrap: balance;
  }

  .item__icono {
    display: grid;
    flex: 1;
    place-items: center;

    min-height: 5rem;
    padding: 1rem;

    color: var(--color-primary);
  }

  .item__icono :global(svg) {
    display: block;
    width: clamp(2.8rem, 6vw, 4rem);
    height: clamp(2.8rem, 6vw, 4rem);

    color: currentColor;

    transition:
      color 200ms ease,
      transform 200ms ease;
  }

  /*
   * Permite que los SVG que usan currentColor
   * hereden correctamente el color de la tarjeta.
   */
  .item__icono :global(svg *) {
    vector-effect: non-scaling-stroke;
  }

  .item__sin-icono {
    display: grid;
    place-items: center;

    width: 3rem;
    height: 3rem;

    border: 2px solid currentColor;
    border-radius: 50%;

    font-size: 1.4rem;
    font-weight: 800;
  }

  .item:hover {
    border-color: var(--color-primary-hover);
    background-color: var(--color-primary-hover);
    color: var(--color-background);

    transform: translateY(-0.25rem);
    box-shadow: 0 0.8rem 1.5rem rgb(0 0 0 / 13%);
  }

  .item:hover .item__icono :global(svg) {
    transform: scale(1.08);
  }

  .item:focus-visible {
    outline: 3px solid var(--color-primary);
    outline-offset: 3px;
  }

  /*
   * En celulares pequeños, cada tarjeta se muestra
   * horizontalmente para ocupar menos altura.
   */
  @media (max-width: 27rem) {
    .item {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 4.5rem;
      min-height: 4.5rem;
      border-radius: 0.7rem;
    }

    .item__titulo {
      justify-content: flex-start;
      min-height: 4.5rem;
      padding: 0.75rem 1rem;

      font-size: 0.95rem;
      text-align: left;
    }

    .item__icono {
      min-height: 4.5rem;
      padding: 0.65rem;

      background-color: var(--color-background);
      color: var(--color-primary);
    }

    .item__icono :global(svg) {
      width: 2.5rem;
      height: 2.5rem;
    }

    .item:hover .item__icono {
      background-color: var(--color-primary-hover);
      color: var(--color-background);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .item,
    .item__icono :global(svg) {
      transition: none;
    }

    .item:hover,
    .item:hover .item__icono :global(svg) {
      transform: none;
    }
  }
</style>
