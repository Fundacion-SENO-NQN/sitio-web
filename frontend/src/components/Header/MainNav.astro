---
import type Navigation from '../../data/interfaces/Navigation'
import { navigationMain } from '../../data/navigation/navigationMain'
---

<nav aria-label="Navegación principal">
  <ul class="lista-nav">
    {
      navigationMain.map((item: Navigation) => (
        <li>
          <a href={item.href}>{item.name}</a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  nav {
    min-width: 0;
  }

  .lista-nav {
    margin: 0;
    padding: 0;

    display: flex;
    align-items: center;
    justify-content: space-around;

    list-style: none;
  }

  .lista-nav li {
    min-width: 0;
  }

  .lista-nav a {
    padding: 0.75rem clamp(0.45rem, 1vw, 1rem);

    display: block;
    position: relative;

    color: var(--color-text);
    font-family: var(--text-font-primary);
    font-size: clamp(0.9rem, 1.1vw, 1.1rem);
    text-align: center;
    text-decoration: none;
    white-space: nowrap;

    transition: color 0.3s ease;
  }

  .lista-nav a::after {
    content: '';

    width: calc(100% - 2rem);
    height: 1px;

    position: absolute;
    bottom: 0.4rem;
    left: 1rem;

    background-color: var(--color-primary);
    transform: scaleX(0);
    transform-origin: center;

    transition: transform 0.3s ease;
  }

  .lista-nav a:hover {
    color: var(--color-primary-hover);
  }

  .lista-nav a:hover::after {
    transform: scaleX(1);
  }

  .lista-nav a:focus-visible {
    border-radius: 0.5rem;
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  @media (max-width: 1100px) {
    nav {
      width: 100%;
    }

    .lista-nav {
      width: 100%;

      flex-direction: column;
      align-items: stretch;
      gap: 0.15rem;
    }

    .lista-nav a {
      width: 100%;
      padding: 0.85rem 1rem;

      border-radius: 0.75rem;

      font-size: 1.05rem;
      text-align: left;
      white-space: normal;
    }

    .lista-nav a::after {
      display: none;
    }

    .lista-nav a:hover {
      background-color: color-mix(
        in srgb,
        var(--color-primary) 10%,
        transparent
      );
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lista-nav a,
    .lista-nav a::after {
      transition: none;
    }
  }
</style>
