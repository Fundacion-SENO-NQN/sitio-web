---
import SvgCorazon from '../../assets/icon-common/icon-corazon.svg'
---

<a href="/quiero-ayudar" class="btn-quiero-ayudar">
  <SvgCorazon />

  <span>Quiero ayudar</span>
</a>

<style>
  .btn-quiero-ayudar {
    box-sizing: border-box;
    padding: 0.9rem 1.15rem;

    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;

    border-radius: 2rem;
    background-color: var(--color-primary);

    color: var(--color-background);
    font-family: var(--text-font-primary);
    font-size: clamp(1rem, 1.2vw, 1.3rem);
    text-decoration: none;
    white-space: nowrap;

    transition:
      background-color 0.3s ease,
      transform 0.2s ease;
  }

  .btn-quiero-ayudar:hover {
    background-color: var(--color-primary-hover);
    transform: translateY(-2px);
  }

  .btn-quiero-ayudar:focus-visible {
    outline: 2px solid var(--color-primary-hover);
    outline-offset: 3px;
  }

  .btn-quiero-ayudar svg {
    width: 1.75rem;
    height: 1.75rem;

    flex-shrink: 0;
  }

  @media (max-width: 1100px) {
    .btn-quiero-ayudar {
      width: 100%;
      padding: 0.9rem 1rem;
      font-size: 1.1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .btn-quiero-ayudar {
      transition: none;
    }

    .btn-quiero-ayudar:hover {
      transform: none;
    }
  }
</style>
