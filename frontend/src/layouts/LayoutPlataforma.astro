---
import '../style/general.css'
import '../style/common/index.css'
import ModalCarga from '../components/Common/ModalCarga.astro'

interface Props {
  titulo?: string
}

const { titulo } = Astro.props

const pageTitle = titulo ? `${titulo} | Plataforma SENO` : 'Plataforma SENO'
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <meta name="robots" content="noindex, nofollow, noarchive" />

    <meta name="theme-color" content="#fafafa" />

    <link rel="icon" href="/favicon.ico" sizes="any" />

    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
  </head>

  <body class="platform-body">
    <div class="platform-layout">
      <slot />
    </div>

    <ModalCarga id="global" />
  </body>
</html>

<style is:global>
  .platform-body {
    min-height: 100vh;
    min-height: 100dvh;

    display: flex;
    flex-direction: column;

    color: var(--admin-text);
    background-color: var(--admin-background);
  }

  .platform-layout {
    width: 100%;
    min-width: 0;
    min-height: 100vh;
    min-height: 100dvh;
    align-items: center;
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
  }
</style>
